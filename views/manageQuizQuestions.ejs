<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Questions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: url("/uploads/background.png") no-repeat center center fixed;
            background-size: cover;
            font-family: 'Poppins', sans-serif;
        }
    
        .content-card {
            height: 320px;
            padding: 15px;
            border-radius: 12px;
            background: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            display:flex;
            flex-direction:column;
            justify-content:space-between;
        }

        .delete-btn {
            background-color: #e63946;
            color: white;
            font-weight: 600;
            border-radius: 6px;
            border: none;
            padding: 5px 12px;
        }

        .delete-btn:hover {
            background-color: #cc2f3c;
        }
    </style>
</head>

<body>

<%- include('partials/navbar') %>

<div class="container mt-4">

    <h2 class="text-center fw-bold mb-3">
        Manage Questions — Set <%= setNumber %>
    </h2>

    

    <div class="row">

        <% if (questions.length > 0) { %>

            <% questions.forEach(q => { %>
                <div class="col-md-4 mb-4">
                    <div class="content-card">

                        <h5 class="fw-bold text-center"><%= q.question %></h5>

                        <p class="text-center text-muted">
                            Category: <strong><%= q.categoryName %></strong><br>
                            Set: <%= q.setNumber %>
                        </p>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/editQuiz/<%= q.quizID %>" class="btn btn-primary btn-sm">Edit</a>

                            <form id="deleteForm-<%= q.quizID %>" action="/deleteQuiz/<%= q.quizID %>" method="POST">
                                <button type="button" class="delete-btn btn-sm"
                                        onclick="confirmDelete('<%= q.quizID %>')">Delete</button>
                            </form>
                        </div>

                    </div>
                </div>
            <% }) %>

        <% } else { %>

            <p class="text-center">No questions found in this set.</p>

        <% } %>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
function confirmDelete(id) {
    Swal.fire({
        title: "Delete this question?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#d33",
        cancelButtonColor: "#777"
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById(`deleteForm-${id}`).submit();
        }
    });
}
</script>

</body>
</html>

