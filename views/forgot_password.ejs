<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <script src="/translations.js"></script>

    <style>
        body {
            font-family: 'Georgia', serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
        }

        
        .left-panel {
            width: 50%;
            background: #0b3d1b;
            background-size: cover;
            position: relative;
            padding-left: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        
        .left-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            backdrop-filter: blur(1px);
        }

        .left-panel * {
            position: relative;
            color: white;
        }

        .left-panel h1 {
            font-size: 55px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .left-panel p {
            font-size: 22px;
            width: 70%;
            line-height: 1.5;
        }

       
        .right-panel {
            width: 50%;
            background: #e8dfcf;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        
        .forgot-box {
            width: 90%;           
            max-width: 520px;       
            animation: fadeIn 0.6s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            text-align: center;
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 20px;
            color: #333;
        }

        .alert {
            margin-bottom: 15px;
            border-radius: 10px;
            padding: 12px;
            font-size: 16px;
        }

        .form-control {
            padding: 14px;
            border-radius: 25px;
            border: 1px solid #ccc;
            margin-bottom: 15px;
            font-size: 16px;
            width: 100%;            
        }

        .form-control:focus {
            border-color: #1b5e20;
            outline: none;
        }

        .btn-forgot {
            width: 100%;
            padding: 14px;
            background: #1b5e20;
            color: white;
            border: none;
            border-radius: 25px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-forgot:hover {
            background: #134818;
        }

        small {
            font-size: 14px;
        }

        .back-link {
            text-align: center;
            margin-top: 20px;
        }

        .back-link a {
            text-decoration: underline;
            color: #004d00;
            font-size: 15px;
        }
    </style>
</head>

<body>

   
    <div class="left-panel">
        <h1 id="forgotTitle">Forgot Password?</h1>
        <p id="forgotSubtitle">Don't worry! We'll help you reset it and continue your EcoJourney 🌱</p>
    </div>

    
    <div class="right-panel">
        <div class="forgot-box">

            <h2 id="resetTitle">Password Reset</h2>

            <% if(errors && errors.length > 0){ %>
                <div class="alert alert-danger">
                    <% errors.forEach(function(err){ %>
                        <p class="mb-0"><%= err %></p>
                    <% }) %>
                </div>
            <% } %>

            <% if(success && success.length > 0){ %>
                <div class="alert alert-success">
                    <% success.forEach(function(msg){ %>
                        <p class="mb-0"><%= msg %></p>
                    <% }) %>
                </div>
            <% } %>

            
            <% if(!step || step === 1){ %>
                <form action="/forgot-password" method="POST">
                    <input type="email" name="email" id="emailInput" class="form-control" placeholder="Enter your email" required />
                    <button type="submit" class="btn-forgot" id="sendOtpBtn">Send OTP</button>
                </form>
            <% } %>

          
            <% if(step === 2){ %>
                <form action="/reset-password" method="POST">
                    <input type="hidden" name="email" value="<%= email %>" />

                    <input type="password" name="tempPassword" id="otpInput" class="form-control" placeholder="Enter OTP" required />
                    <input type="password" name="newPassword" id="newPasswordInput" class="form-control" placeholder="New password" required />
                    <input type="password" name="confirmPassword" id="confirmPasswordInput" class="form-control" placeholder="Confirm new password" required />

                    <small class="text-muted d-block mb-3" id="passwordRequirements">
                        Password must be at least 8 characters long and include one uppercase letter, one number, and one special character.
                    </small>

                    <button type="submit" class="btn-forgot" id="resetBtn">Reset Password</button>
                </form>
            <% } %>

            <div class="back-link">
                <a href="/" id="backToLogin">⬅ Back to Login</a>
            </div>

        </div>
    </div>

    <script>
      
        document.addEventListener('DOMContentLoaded', () => {
            const forgotTitle = document.getElementById('forgotTitle');
            const forgotSubtitle = document.getElementById('forgotSubtitle');
            const resetTitle = document.getElementById('resetTitle');
            const sendOtpBtn = document.getElementById('sendOtpBtn');
            const resetBtn = document.getElementById('resetBtn');
            const backToLogin = document.getElementById('backToLogin');

            if (forgotTitle) forgotTitle.textContent = t('forgotPasswordTitle');
            if (forgotSubtitle) forgotSubtitle.textContent = t('forgotPasswordSubtitle');
            if (resetTitle) resetTitle.textContent = t('passwordResetTitle');
            if (sendOtpBtn) sendOtpBtn.textContent = t('sendOtpBtn');
            if (resetBtn) resetBtn.textContent = t('resetPasswordBtn');
            if (backToLogin) backToLogin.textContent = t('backToLoginLink');
        });
    </script>

</body>
</html>


