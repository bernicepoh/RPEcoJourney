<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-image: url("/uploads/background.png");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      margin: 0;
      padding: 0;
    }

    /* ------------------------ MAIN CONTENT ------------------------ */
    .main-content {
      padding: 40px 30px;
    }

    /* HERO SECTION */
    .hero {
      margin-top: 10px;
      margin-bottom: 30px;
    }

    .hero h1 {
      font-size: 3rem;
      color: #0b2535;
      font-weight: 800;
      margin-bottom: 10px;
      text-shadow: 1px 1px 4px rgba(255, 255, 255, 0.6);
      line-height: 1.2;
    }

    .card {
      background: rgba(255, 255, 255, 0.9);
      color: #333;
      border: none;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      transition: 0.3s ease;
      height: 100%;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(0,0,0,0.35);
    }

    .card-title {
      color: #733E24;
      font-size: 1.3rem;
      font-weight: 700;
    }

    .workspace-card {
      background: linear-gradient(135deg, #733E24 0%, #8B4E36 100%);
      color: white;
      cursor: pointer;
      text-decoration: none;
      display: block;
      min-height: 150px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .workspace-card:hover {
      background: linear-gradient(135deg, #8B4E36 0%, #733E24 100%);
      color: white;
    }

    .workspace-card .card-icon {
      font-size: 3rem;
      margin-bottom: 10px;
    }

    .workspace-card .card-title {
      color: white;
      font-size: 1.2rem;
      margin: 0;
    }

    .section-title {
      font-size: 1.8rem;
      color: #0b2535;
      font-weight: 700;
      margin-bottom: 20px;
      text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.5);
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">

    <div class="container-fluid mt-4" style="max-width:1200px;">

      <section class="hero">
        <% if (userName) { %>
          <h1>Welcome, <%= userName %><br><%= userType %> Workspace</h1>
        <% } %>
      </section>

      <!-- WORKSPACE CARDS SECTION -->
      <h2 class="section-title">📂 Workspace</h2>
      <div class="row g-4 mb-5">
        
        <% if (userType === 'Writer' || userType === 'Manager' || userType === 'Admin') { %>
          <div class="col-md-4">
            <a href="/manageContent" class="card workspace-card text-decoration-none">
              <div class="card-icon">📝</div>
              <h5 class="card-title">Manage Content</h5>
            </a>
          </div>
        <% } %>

        <% if (userType === 'Admin') { %>
          <div class="col-md-4">
            <a href="/adminUsers" class="card workspace-card text-decoration-none">
              <div class="card-icon">👥</div>
              <h5 class="card-title">Manage Users</h5>
            </a>
          </div>
        <% } %>

      </div>

      <!-- STATISTICS SECTION -->
      <h2 class="section-title">📊 Statistics</h2>

      <div class="row g-4">

        <div class="col-md-6">
          <div class="card p-4">
            <h5 class="card-title">👋 Total Visitors Today</h5>
            <p style="font-size: 2rem; margin:0;">0</p>
            <p style="opacity: 0.7;">(Google Analytics Placeholder)</p>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card p-4">
            <h5 class="card-title">🍂 Weekly Active Users</h5>
            <p style="font-size: 2rem; margin:0;">0</p>
            <p style="opacity: 0.7;">(Placeholder)</p>
          </div>
        </div>

      </div>

      <div class="card p-4 mt-4">
        <h5 class="card-title">👜 Requests Overview</h5>

        <ul style="list-style:none; padding-left:0; margin-top:15px;">
          <li class="mb-2">📄 Pending Content Approvals — <b>0</b></li>
          <li class="mb-2">✏️ Pending Quiz Submissions — <b>0</b></li>
          <li class="mb-2">👥 Role Change Requests — <b>0</b></li>
          <li class="mb-2">📨 Feedback Tickets — <b>0</b></li>
        </ul>

        <a href="/requestPage" class="btn btn-success" style="background:#4CAF50; border-radius:8px;">
          Go to Requests Page
        </a>
      </div>

    </div>
  </div>

  <!-- SweetAlert -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (loginSuccess && loginSuccess.length > 0) { %>
  <script>
    Swal.fire({
      icon: 'success',
      title: 'Welcome!',
      text: '<%= loginSuccess %>',
      timer: 1800,
      showConfirmButton: false
    });
  </script>
  <% } %>

  <!-- Access Denied Alert -->
  <% const errors = flash('error'); %>
  <% if (errors && errors.length > 0) { %>
  <script>
    Swal.fire({
      icon: 'error',
      title: 'Access Denied',
      text: '<%= errors[0] %>',
      confirmButtonColor: '#733E24',
      confirmButtonText: 'OK'
    });
  </script>
  <% } %>

</body>
</html>






