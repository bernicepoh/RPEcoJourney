<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #e8dfcf;
      min-height: 100vh;
      margin: 0;
      padding: 0;
    }

    .main-content {
      padding: 40px 30px;
    }

    .hero h1 {
      font-size: 3rem;
      color: #0b2535;
      font-weight: 800;
    }

    .card {
      background: rgba(255, 255, 255, 0.95);
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      height: 100%;
    }

    .card-title {
      color: #733E24;
      font-weight: 700;
    }

    .workspace-card {
      background: linear-gradient(135deg, #733E24, #8B4E36);
      color: white;
      text-decoration: none;
      min-height: 150px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .workspace-card .card-icon {
      font-size: 3rem;
    }

    .section-title {
      font-size: 1.8rem;
      font-weight: 700;
      color: #0b2535;
      margin-bottom: 20px;
    }
  </style>
</head>

<body>

<!-- NAVBAR -->
<%- include('partials/navbar') %>

<div class="main-content">
<div class="container-fluid" style="max-width:1200px;">

<!-- HERO -->
<section class="hero mb-4">
  <% if (userName) { %>
    <h1>Welcome, <%= userName %><br><%= userType %> Workspace</h1>
  <% } %>
</section>

<!-- WORKSPACE (UNCHANGED) -->
<h2 class="section-title">📂 Workspace</h2>
<div class="row g-4 mb-5">

  <% if (userType === 'Writer' || userType === 'Manager' || userType === 'Admin') { %>
  <div class="col-md-4">
    <a href="/manageContent" class="card workspace-card">
      <div class="card-icon">📝</div>
      <h5 class="card-title text-white">Manage Content</h5>
    </a>
  </div>
  <% } %>

  <% if (userType === 'Admin') { %>
  <div class="col-md-4">
    <a href="/adminUsers" class="card workspace-card">
      <div class="card-icon">👥</div>
      <h5 class="card-title text-white">Manage Users</h5>
    </a>
  </div>
  <% } %>

  <% if (userType === 'Admin') { %>
  <div class="col-md-4">
    <a href="/admin/editor" class="card workspace-card">
      <div class="card-icon">📺</div>
      <h5 class="card-title text-white">Manage Digital Signage</h5>
    </a>
  </div>
  <% } %>

</div>

<!-- STATISTICS -->
<h2 class="section-title">📊 Statistics</h2>

<!-- ORIGINAL STAT CARDS -->
<div class="row g-4 mb-4">
  <div class="col-md-6">
    <div class="card p-4">
      <h5 class="card-title">👋 Total Visitors Today</h5>
      <p id="gaVisitorsToday" style="font-size:2rem;">0</p>
      <small>(Google Analytics)</small>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card p-4">
      <h5 class="card-title">🍂 Weekly Active Users</h5>
      <p id="gaWeeklyUsers" style="font-size:2rem;">0</p>
      <small>(Google Analytics)</small>
    </div>
  </div>
</div>

<!-- EXTRA GA METRICS -->
<div class="row g-4 mb-5">
  <div class="col-md-3">
    <div class="card p-4 text-center">
      <h6>Active Users</h6>
      <p id="gaActiveUsers" style="font-size:2rem;">0</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-4 text-center">
      <h6>Event Count</h6>
      <p id="gaEventCount" style="font-size:2rem;">0</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-4 text-center">
      <h6>New Users</h6>
      <p id="gaNewUsers" style="font-size:2rem;">0</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-4 text-center">
      <h6>Active (30 mins)</h6>
      <p id="gaRealtimeUsers" style="font-size:2rem;">0</p>
    </div>
  </div>
</div>

<!-- REQUESTS OVERVIEW -->
<% if (userType === 'Admin' || userType === 'Manager' || userType === 'Writer') { %>
<div class="card p-4 mb-5">
  <h5 class="card-title">👜 Requests Overview</h5>

  <ul style="list-style:none; padding-left:0;">
    <li>📄 Pending Content Approvals — <b>0</b></li>
    <li>✏️ Pending Quiz Submissions — <b>0</b></li>
    <li>👥 Role Change Requests — <b>0</b></li>
    <li>📨 Feedback Tickets — <b>0</b></li>
  </ul>

  <% if (userType === 'Admin' || userType === 'Manager') { %>
    <a href="/content-requests" class="btn btn-success mt-2">
      📋 Go to Requests Page
    </a>
  <% } %>
  
  <% if (userType === 'Writer') { %>
    <a href="/manageContent" class="btn btn-success mt-2">
      📋 View My Content Status
    </a>
  <% } %>
</div>
<% } %>

</div>
</div>

<!-- GA FETCH -->
<script>
console.log('📋 Admin Dashboard loaded');
console.log('User Type:', '<%= userType %>');

// Test if button exists
document.addEventListener('DOMContentLoaded', function() {
  const requestBtn = document.querySelector('a[href="/content-requests"]');
  console.log('Button found:', requestBtn);
  if (requestBtn) {
    requestBtn.addEventListener('click', function(e) {
      console.log('Button CLICKED! Going to /content-requests');
    });
  }
});

fetch('/admin/dashboard/stats')
  .then(res => {
    console.log('📡 Response Status:', res.status);
    return res.json();
  })
  .then(data => {
    console.log('📊 GA Data received:', data);
    document.getElementById('gaVisitorsToday').innerText = data.visitorsToday ?? 0;
    document.getElementById('gaWeeklyUsers').innerText = data.weeklyUsers ?? 0;
    document.getElementById('gaActiveUsers').innerText = data.activeUsers ?? 0;
    document.getElementById('gaEventCount').innerText = data.eventCount ?? 0;
    document.getElementById('gaNewUsers').innerText = data.newUsers ?? 0;
    document.getElementById('gaRealtimeUsers').innerText = data.realtimeUsers ?? 0;
  })
  .catch(err => console.error('❌ Error fetching GA stats:', err));
</script>

</body>
</html>








