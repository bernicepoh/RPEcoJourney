<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Homepage</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .card-container {
    margin-left: 25%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 5%;
    max-width: 90%;
    width: 1000px;
}

.card {
    background: white;
    color: #333;
    border: none;
    border-radius: 12px;
    box-shadow: 2px 4px 12px rgba(0, 0, 0, 0.1);
    text-align: center;
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 4px 6px 15px rgba(0, 0, 0, 0.2);
}

.card-header {
    background-color: #733E24;
    color: white;
    font-size: 1.2rem;
    font-weight: bold;
    padding: 12px;
    border-radius: 12px 12px 0 0;
}

.card-body {
    padding: 20px;
}

.card-text {
    margin-bottom: 15px;
    font-size: 1rem;
    color: #555;
}

.card-link {
    display: inline-block;
    background-color: green;
    color: white;
    text-decoration: none;
    padding: 10px 15px;
    border-radius: 8px;
    font-weight: 500;
    transition: background 0.3s ease-in-out;
}

.card-link:hover {
    background-color: darkgreen;
}

    </style>
</head>
<body>
    <%- include ('partials/navbar.ejs') %>

    <% if (userName) { %>
  <h3>Welcome, <%= userName %></h3>
  <% } %>

     <div class="card-container">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Publish Content</h5>
                <p class="card-text"><b>Authorization</b>: Writers</p>
                <p class="card-text"><b>Description</b> Role for writers to create content</p>
                <a href="/addContent" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Edit Content</h5>
                <p class="card-text"><b>Authorization</b>: Writers</p>
                <p class="card-text"><b>Description</b> Role for writers to edit content</p>
                <a href="/editContent" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Publish Quiz</h5>
                <p class="card-text">Click to Add products</p>
                <a href="/addproduct" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">View Users</h5>
                <p class="card-text"><b>Authorization</b>: Admin</p>
                <p class="card-text"><b>Description</b> Role for admin to view all users</p>
                <a href="/adminUsers" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">View Sales Report</h5>
                <p class="card-text">Click to Sales Report</p>
                <a href="/sales" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">View Reviews</h5>
                <p class="card-text">Click to see admin reviews</p>
                <a href="/adminreviews" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Edit Categories</h5>
                <p class="card-text">Click to Edit Categories</p>
                <a href="/admincategory" class="card-link">Enter</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Add Categories</h5>
                <p class="card-text">Click to Add Categories</p>
                <a href="/addcategory" class="card-link">Enter</a>
            </div>
        </div>
    </div>
    


 

</body>
</html>