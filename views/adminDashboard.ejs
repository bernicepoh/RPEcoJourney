<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-image: url("/uploads/background.png");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      margin: 0;
      padding: 0;
    }

    /* ------------------------ HAMBURGER BUTTON ------------------------ */
    #menu-btn {
      position: fixed;
      top: 85px; 
      left: 25px;
      font-size: 28px;
      cursor: pointer;
      z-index: 2000;
      background: rgba(255,255,255,0.85);
      padding: 8px 12px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

    /* ------------------------ SIDEBAR ------------------------ */
    .sidebar {
      width: 260px;
      background-color: #733E24; 
      color: white;
      min-height: 100vh;
      padding: 30px 20px;
      position: fixed;
      top: 0;
      left: -260px; 
      transition: 0.3s ease;
      z-index: 1500;
    }

    .sidebar.active {
      left: 0;
    }

    .sidebar h2 {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 30px;
      text-align: center;
    }

    .sidebar a {
      display: block;
      padding: 12px 15px;
      margin: 8px 0;
      color: white;
      text-decoration: none;
      font-weight: 500;
      background: rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      transition: 0.2s;
    }

    .sidebar a:hover {
      background: rgba(255, 255, 255, 0.25);
      transform: translateX(5px);
    }

    /* ------------------------ MAIN CONTENT ------------------------ */
    .main-content {
      padding: 40px 30px;
      transition: 0.3s ease;
    }

    /* HERO INSIDE SAME CONTAINER AS CARDS */
    .hero {
      margin-top: 10px;   /* just vertical spacing */
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: 3rem;
      color: #0b2535;
      font-weight: 800;
      margin-bottom: 10px;
      text-shadow: 1px 1px 4px rgba(255, 255, 255, 0.6);
      line-height: 1.2;
    }

    .card {
      background: rgba(255, 255, 255, 0.9);
      color: #333;
      border: none;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      transition: 0.3s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(0,0,0,0.35);
    }

    .card-title {
      color: #733E24;
      font-size: 1.3rem;
      font-weight: 700;
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- HAMBURGER BUTTON -->
  <div id="menu-btn">☰</div>

  <!-- SIDEBAR -->
  <div class="sidebar" id="sidebar">
    <h2>Workspace</h2>

    <% if (userType === 'Writer' || userType === 'Admin') { %>
      <a href="/manageContent">Manage Content</a>
    <% } %>

    <% if (userType === 'Manager' || userType === 'Admin') { %>
      <a href="/manageQuizCategories">Manage Quiz</a>
      <a href="/manageCategories">Manage Categories</a>
    <% } %>

    <% if (userType === 'Admin') { %>
      <a href="/adminUsers">View Users</a>
    <% } %>
  </div>

  <!-- MAIN CONTENT -->
  <div class="main-content">

    <!-- NOW HERO + CARDS SHARE SAME CONTAINER -->
    <div class="container-fluid mt-4" style="max-width:1100px;">

      <section class="hero">
        <% if (userName) { %>
          <h1>Welcome, <%= userName %><br><%= userType %> Workspace</h1>
        <% } %>
      </section>

      <div class="row g-4">

        <div class="col-md-6">
          <div class="card p-4">
            <h5 class="card-title">👋 Total Visitors Today</h5>
            <p style="font-size: 2rem; margin:0;">0</p>
            <p style="opacity: 0.7;">(Google Analytics Placeholder)</p>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card p-4">
            <h5 class="card-title">🍂 Weekly Active Users</h5>
            <p style="font-size: 2rem; margin:0;">0</p>
            <p style="opacity: 0.7;">(Placeholder)</p>
          </div>
        </div>

      </div>

      <div class="card p-4 mt-4">
        <h5 class="card-title">👜 Requests Overview</h5>

        <ul style="list-style:none; padding-left:0; margin-top:15px;">
          <li class="mb-2">📄 Pending Content Approvals — <b>0</b></li>
          <li class="mb-2">✏️ Pending Quiz Submissions — <b>0</b></li>
          <li class="mb-2">👥 Role Change Requests — <b>0</b></li>
          <li class="mb-2">📨 Feedback Tickets — <b>0</b></li>
        </ul>

        <a href="/requestPage" class="btn btn-success" style="background:#4CAF50; border-radius:8px;">
          Go to Requests Page
        </a>
      </div>

    </div>
  </div>

  <!-- SIDEBAR TOGGLE SCRIPT -->
  <script>
    const menuBtn = document.getElementById('menu-btn');
    const sidebar = document.getElementById('sidebar');

    menuBtn.addEventListener('click', () => {
      sidebar.classList.toggle('active');
    });
  </script>

  <!-- SweetAlert -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (loginSuccess && loginSuccess.length > 0) { %>
  <script>
    Swal.fire({
      icon: 'success',
      title: 'Welcome!',
      text: '<%= loginSuccess %>',
      timer: 1800,
      showConfirmButton: false
    });
  </script>
  <% } %>

</body>
</html>






