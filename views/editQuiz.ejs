<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Quiz Question</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #e8fddf;
            min-height: 100vh;
            padding-bottom: 50px;
        }

        .form-card {
            background: white;
            border-radius: 15px;
            padding: 35px;
            margin-top: 40px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
            max-width: 800px;
        }

        .save-btn {
            background: #4caf50;
            color: white;
            font-weight: 600;
        }
        .save-btn:hover {
            background: #3f9c44;
        }
    </style>
</head>
<body>

<%- include('partials/navbar') %>

<div class="container d-flex justify-content-center">
    <div class="form-card">

        <h2 class="text-center fw-bold mb-4">Edit Quiz Question</h2>

        <form action="/editQuiz/<%= question.quizID %>" method="POST">

            <!-- Edit Quiz Title -->
            <div class="mb-3">
                <label class="form-label fw-bold">Quiz Title (applies to whole set)</label>
                <input class="form-control" name="quizTitle" value="<%= question.quizTitle %>" required>
            </div>

            <!-- Edit Set Color -->
            <div class="mb-4">
                <label class="form-label fw-bold">Quiz Card Color</label>
                <input type="color" class="form-control form-control-color"
                       name="cardColor"
                       value="<%= question.cardColor %>"
                       title="Choose a color">
            </div>

            <!-- Question -->
            <div class="mb-3">
                <label class="form-label">Question</label>
                <textarea class="form-control" name="question" rows="3" required><%= question.question %></textarea>
            </div>

            <!-- Options -->
            <label class="form-label fw-bold">Options</label>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <input class="form-control" name="option1" value="<%= question.option1 %>" placeholder="Option 1" required>
                </div>
                <div class="col-md-6 mb-3">
                    <input class="form-control" name="option2" value="<%= question.option2 %>" placeholder="Option 2" required>
                </div>
                <div class="col-md-6 mb-3">
                    <input class="form-control" name="option3" value="<%= question.option3 %>" placeholder="Option 3" required>
                </div>
                <div class="col-md-6 mb-3">
                    <input class="form-control" name="option4" value="<%= question.option4 %>" placeholder="Option 4" required>
                </div>
            </div>

            <!-- Correct Option -->
            <div class="mb-3">
                <label class="form-label fw-bold">Correct Option (1 - 4)</label>
                <input class="form-control" type="number" min="1" max="4" name="correctOption" value="<%= question.correctOption %>" required>
            </div>

            <!-- Time Limit -->
            <div class="mb-3">
                <label class="form-label fw-bold">Time Limit (Seconds)</label>
                <input class="form-control" type="number" min="5" max="120" name="timeLimit" value="<%= question.timeLimit %>" required>
            </div>

            <!-- Explanation -->
            <div class="mb-3">
                <label class="form-label">Explanation (Optional)</label>
                <textarea class="form-control" name="explanation" rows="3"><%= question.explanation %></textarea>
            </div>

            <button class="btn save-btn w-100 mt-3">Save Changes</button>
        </form>

    </div>
</div>

</body>
</html>

