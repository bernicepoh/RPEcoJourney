<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney | Categories</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/translations.js"></script>
  <style>
    body {
      background-image: url("/uploads/background.png");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;
      background-size: 100% auto;
      background-attachment: fixed;
      margin: 0;
      padding: 0;
      font-family: 'Georgia', serif;
      color: #123524;
    }

    header h1 {
      font-size: 2.2em;
      font-weight: bold;
    }

    main {
      padding: 60px 100px;
      text-align: center;
    }

    h2 {
      font-style: italic;
      color: #1a4d2e;
      font-size: 2em;
    }

    p {
      font-size: 1.2em;
      line-height: 1.7;
      max-width: 850px;
      margin: 0 auto;
    }

    .intro {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      text-align: left;
      margin-bottom: 40px;
    }

    .intro-text {
      flex: 1;
      min-width: 320px;
      text-align: left;
      margin-left: 60px;
    }

    .intro-text h2 {
      margin-left: 430px;
      text-align: left;
    }

    .intro img {
      width: 250px;
      border-radius: 10px;
      margin-left: 40px;
    }

    hr {
      border: 0;
      border-top: 3px solid #1a4d2e;
      margin: 50px 0;
    }

    /* Container of all categories */
    .category-list {
      display: flex;
      flex-direction: column;
      gap: 35px;
      margin-top: 50px;
      margin-bottom: 50px;
    }

    /* Card layout */
    .category-card {
      width: 100%;
      max-width: 1100px;
      background: white;
      border-radius: 20px;
      padding: 25px 40px;
      margin: 40px auto;

      display: flex;
      justify-content: space-between;
      align-items: center;

      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.10);
      transition: 0.25s ease;
    }

    .category-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
    }

    /* LEFT text column */
    .category-left {
      max-width: 60%;
    }

    .category-title {
      font-size: 2rem;
      font-weight: 700;
      color: #123524;
      text-decoration: none;
    }

    .category-title:hover {
      text-decoration: underline;
    }

    .category-desc {
      margin-top: 10px;
      font-size: 1.25rem;
      color: #2d6a4f;
    }

    /* RIGHT image side */
    .category-img {
      width: 260px;
      height: 180px;
      object-fit: cover;
      border-radius: 16px;
      flex-shrink: 0;
    }

    footer {
      text-align: center;
      padding: 25px;
      font-size: 1.1em;
      color: #555;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- Main Content -->
  <main>

    <section class="intro">
      <div class="intro-text">
        <h2 id="rpSustainabilityTitle">RP Sustainability</h2>
        <p id="rpSustainabilityDesc">
          At RP, we are committed to embracing sustainability, and our RP Green Plan lays out the roadmap for our sustainability journey.
          The RP Green Plan is strategically designed to embed sustainability into everything we do
          whether it's our daily operations, practices, initiatives, or even what we teach in our classes.
        </p>
      </div>
      <img src="/uploads/rp-green.png" alt="RP Green Plan">
    </section>

    <hr>

    <% if (categories && categories.length) { %>

      <% categories.forEach(c => { %>

        <div class="category-card">

          <div class="category-left">
            <a class="category-title" href="/contentType/<%= c.contentTypeID %>/content">
              <%= c.contentTypeName %>
            </a>

            <p class="category-desc">
              <% if (c.contentTypeDescription) { %>
                <%= c.contentTypeDescription.split('.')[0] %>
              <% } %>
            </p>
          </div>

          <%
            let imgSrc;
            if (!c.contentTypeImage) {
              imgSrc = "/uploads/default.png";
            } else if (["Environmental.png", "Social.png", "Governance.png"].includes(c.contentTypeImage)) {
              imgSrc = "/uploads/" + c.contentTypeImage;
            } else {
              imgSrc = "/uploads/" + c.contentTypeImage;
            }
          %>

          <img
            src="<%= imgSrc %>"
            alt="<%= c.contentTypeName %>"
            class="category-img"
            loading="lazy"
            onerror="this.src='/uploads/default.png'"
          >

        </div>

      <% }) %>

    <% } else { %>
      <p id="noCategoriesMsg">No categories yet. Please add some data.</p>
    <% } %>

  </main>

  <footer id="categoriesFooter">
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const rpSustainabilityTitle = document.getElementById('rpSustainabilityTitle');
      const rpSustainabilityDesc = document.getElementById('rpSustainabilityDesc');
      const noCategoriesMsg = document.getElementById('noCategoriesMsg');
      const categoriesFooter = document.getElementById('categoriesFooter');
      
      if (rpSustainabilityTitle) rpSustainabilityTitle.textContent = t('rpSustainabilityTitle');
      if (rpSustainabilityDesc) rpSustainabilityDesc.textContent = t('rpSustainabilityDesc');
      if (noCategoriesMsg) noCategoriesMsg.textContent = t('noCategoriesMsg');
      if (categoriesFooter) categoriesFooter.innerHTML = t('footer');
    });
  </script>

</body>
</html>