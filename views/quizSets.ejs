<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= categoryName %> – Quiz Sets</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    /* RESET */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* MATCH QUIZ CATEGORY PAGE MEASUREMENT */
    body {
      font-family: 'Georgia', serif;
      background-image: url("/images/background.png");
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
      min-height: 100vh;
      margin: 0;
      padding: 0;
    }


    /* SPACE BELOW NAVBAR */
    .nav-spacer {
      height: 40px; /* same spacing type as categories page */
    }

    /* TITLE */
    h1 {
      text-align: center;
      color: #0b2535;
      font-size: 2.4rem;  /* match style of categories page title */
      margin-bottom: 10px;
    }

    p.subtitle {
      text-align: center;
      color: #4f665a;
      font-size: 1.1rem;
      margin-bottom: 45px; /* increased because category page has bigger spacing */
    }

    /* CARD GRID – centered + consistent spacing */
    .sets-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 35px;   /* match spacing style */
      padding-bottom: 40px;
    }

    /* CARD */
    .set-card {
      width: 100%;
      max-width: 420px; /* match your category card proportions */
      border-radius: 25px;
      padding: 30px 25px;
      text-align: center;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.20);
      transition: transform 0.3s ease;
    }

    .set-card:hover {
      transform: translateY(-8px);
    }

    /* ICON */
    .quiz-icon {
      width: 90px;
      height: 90px;
      margin-bottom: 18px;
    }

    /* TITLE INSIDE CARD */
    .set-title {
      font-size: 1.5rem;
      font-weight: bold;
      margin-bottom: 15px;
      color: #0b2535;
    }

    /* BUTTON */
    .start-btn {
      background: #2d7a31;
      padding: 12px 26px;
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      cursor: pointer;
      transition: 0.2s;
    }

    .start-btn:hover {
      background: #256628;
    }

    /* Back Link */
    .back-link {
      display: block;
      text-align: center;
      margin: 40px 0;
      color: #0b2535;
      font-size: 1rem;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

  </style>
</head>

<body>

  <!-- NAVBAR -->
  <%- include ('partials/navbar.ejs') %>

  <!-- SPACING BELOW NAVBAR -->
  <div class="nav-spacer"></div>

  <!-- PAGE HEADER -->
  <h1><%= categoryName %> Quiz Sets</h1>
  <p class="subtitle">Choose a set to begin your sustainability quiz 🌿</p>

  <!-- QUIZ SETS -->
  <div class="sets-wrapper">
    <% sets.forEach(set => { %>

      <% 
        const colors = ["#b7e4c7", "#a8dadc", "#ffd6a5", "#ffadad", "#c1d3fe"];
        const cardColor = colors[set.setNumber % colors.length];
      %>

      <div class="set-card" style="background:<%= cardColor %>;">
        <img class="quiz-icon" src="/images/default-eco-icon.png" alt="icon">
        <div class="set-title">Quiz Set <%= set.setNumber %></div>

        <a href="/startGame/<%= categoryID %>/<%= set.setNumber %>">
          <button class="start-btn">Start Quiz</button>
        </a>
      </div>

    <% }) %>
  </div>

  <a class="back-link" href="/quiz">← Back to Categories</a>

</body>
</html>


