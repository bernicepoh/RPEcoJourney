<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= categoryName %> – Quiz Sets</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      background: #e0edf5;
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    h1 {
      text-align: center;
      color: #0b2535;
      margin-bottom: 10px;
    }

    p.subtitle {
      text-align: center;
      margin-bottom: 30px;
      color: #3a4a55;
    }

    .sets-wrapper {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .set-card {
      background: #ffffff;
      padding: 20px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.1);
      transition: transform 0.15s ease;
    }

    .set-card:hover {
      transform: translateY(-4px);
    }

    .set-title {
      font-size: 1.3rem;
      font-weight: 600;
      color: #0b2535;
      margin-bottom: 12px;
    }

    .btn-start {
      display: inline-block;
      padding: 10px 18px;
      background: #0d6efd;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 500;
      transition: background 0.2s ease;
    }

    .btn-start:hover {
      background: #0b5ed7;
    }

    .back-link {
      display: inline-block;
      margin-top: 25px;
      text-align: center;
      width: 100%;
      color: #0b2535;
      text-decoration: none;
      font-size: 0.95rem;
    }

    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
<div class="container">

  <h1><%= categoryName %> Quiz Sets</h1>
  <p class="subtitle">Choose a set to begin your sustainability quiz 🌿</p>

  <div class="sets-wrapper">
    <% sets.forEach(set => { %>
      <div class="set-card">
        <div class="set-title">Quiz Set <%= set.setNumber %></div>

        <!-- Start Kahoot-style game -->
        <a href="/quiz/game/start/<%= categoryID %>/<%= set.setNumber %>" class="btn-start">
          Start Quiz
        </a>
      </div>
    <% }) %>
  </div>

  <a href="/quiz" class="back-link">← Back to Categories</a>

</div>
</body>
</html>
