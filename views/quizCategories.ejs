<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Quiz Topic | RPECOJOURNEY</title>
  <style>
    /* Reset */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Poppins", sans-serif;
      background: url('/images/backgroundimage.jpg') no-repeat center center fixed;
      background-size: cover;
      color: #0b2535;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(255, 255, 255, 0.85);
      z-index: -1;
    }

    .container {
      text-align: center;
      margin: 100px auto;
      max-width: 1600px;
      padding: 0 40px;
    }

    h2 {
      font-size: 2.8rem;
      color: #0b2535;
      margin-bottom: 60px;
    }

    /* 🌱 Card Layout */
    .topics {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 60px;
      flex-wrap: nowrap;
    }

    .topic-card {
      width: 370px;   /* wider cards */
      height: 500px;  /* same tall height */
      border-radius: 40px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
      background-color: #2b6b33;
    }

    .topic-card:hover {
      transform: translateY(-10px) scale(1.04);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.35);
    }

    /* Background image */
    .topic-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
      filter: brightness(0.75);
      z-index: 0;
      transition: transform 0.6s ease, filter 0.4s ease;
    }

    .topic-card:hover .topic-image {
      transform: scale(1.05);
      filter: brightness(0.9);
    }

    /* 🌈 Gradient overlay */
    .topic-card::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 45%;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
      z-index: 0;
    }

    /* Label button */
    .topic-label {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      background-color: #91c77d;
      color: #f5fff0;
      font-weight: 600;
      font-size: 1.2rem;
      font-style: italic;
      border-radius: 50px;
      padding: 15px 45px;
      text-transform: uppercase;
      letter-spacing: 1px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
      z-index: 2;
      transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

    /* ✨ Soft glow hover effect */
    .topic-card:hover .topic-label {
      background-color: #7bb565;
      box-shadow: 0 0 25px rgba(145, 199, 125, 0.9); /* glowing green light */
    }

    /* ✅ Background images */
    .environment .topic-image {
      background-image: url('/images/Environment.png');
    }

    .social .topic-image {
      background-image: url('/images/Social.png');
    }

    .governance .topic-image {
      background-image: url('/images/Governance.png');
    }

    /* Responsive */
    @media (max-width: 1200px) {
      .topics {
        flex-wrap: wrap;
      }

      .topic-card {
        width: 85%;
        height: 460px;
      }
    }

  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <h2>Select a Quiz Topic 🌿</h2>

    <div class="topics">
      <div class="topic-card environment">
        <div class="topic-image"></div>
        <a href="/quiz/category/1" class="topic-label">Environment</a>
      </div>

      <div class="topic-card social">
        <div class="topic-image"></div>
        <a href="/quiz/category/2" class="topic-label">Social</a>
      </div>

      <div class="topic-card governance">
        <div class="topic-image"></div>
        <a href="/quiz/category/3" class="topic-label">Governance</a>
      </div>
    </div>
  </div>
</body>
</html>