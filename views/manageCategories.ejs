<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Manage Categories</title>

    <style>
        body {
            min-height: 100vh;
            background-image: url("/uploads/background.png");
            background-repeat: no-repeat;
            background-size: cover; 
            background-position: center;
        }
        .add-category-btn {
            display: inline-block;
            padding: 12px 24px;
            background-color: #6bbf59;  
            color: white;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            transition: 0.25s ease;
            font-size: 1rem;
        }

        .add-category-btn:hover {
            background-color: green;
            transform: translateY(-2px);
        }
        .category-card {
            height: 450px;                     /* SAME height for all cards */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-radius: 12px;
            overflow: hidden;
        }
        /* Standardised image box */
        .category-card img {
            width: 100%;
            height: 180px;                     /* SAME height for all images */
            object-fit: cover;                 /* Crop edges nicely */
        }
        /* Description area */
        .category-body {
            flex: 1;                           /* Fill remaining vertical space */
            padding: 15px;
        }
        /* Bottom buttons aligned consistently */
        .category-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 15px;
            padding-top: 0;
        }
        /* -------- Edit Button -------- */
        /* Force smaller size for Edit button */
        .edit-btn {
            font-size: 0.8rem !important;
            font-weight: 500 !important;
            padding: 4px 10px !important;
            background-color: #f4a261;
            color: #1a4d2e !important; 
            border-radius: 6px;
            display: inline-block;
            width: auto !important;
        }
        /* -------- Delete Button -------- */
        .delete-btn,
        .delete-form button {
            background-color: #e63946;
            color: white;
            font-size: 0.85em;
            padding: 5px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: 0.25s ease;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .delete-btn:hover,
        .delete-form button:hover {
            background-color: #cc2f3c;
        }
    </style>
</head>

<body>
    <div><%- include ('partials/navbar.ejs') %></div>

    <div class="container mt-4">

        <h2 class="mb-4 text-center fw-bold">Manage Categories</h2>

        <br>

        <div class="text-center mb-3">
            <a href="/addCategory" class="add-category-btn">+ Add New Category</a>
        </div>

        <br>

        <div class="row">
            <% if (categories && categories.length > 0) { %>

                <% categories.forEach(function(c) { %>

                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm category-card">

                            <!-- Standardised Image -->
                            <% 
                                let imgSrc;

                                if (!c.categoryImage) {
                                    imgSrc = "/uploads/default.png";        // if no image, NULL
                                } 
                                else if (["Environmental.png", "Social.png", "Governance.png"].includes(c.categoryImage)) {
                                    imgSrc = "/uploads/" + c.categoryImage; // preset icons
                                } 
                                else {
                                    imgSrc = "/uploads/" + c.categoryImage; // ALL uploaded images
                                }
                            %>

                            <img src="<%= imgSrc %>" alt="<%= c.categoryName %>">


                            <!-- Body -->
                            <div class="category-body">
                                <h5 class="fw-bold"><%= c.categoryName %></h5>
                                <p><%= c.categoryDescription %></p>
                            </div>

                            <!-- Edit/Delete Buttons -->
                            <div class="category-actions">
                                <a href="/editCategory/<%= c.categoryID %>" class="btn btn-primary btn-sm">✏ Edit</a>

                                <form id="deleteForm-<%= c.categoryID %>" 
                                    action="/deleteCategory/<%= c.categoryID %>" 
                                    method="POST" 
                                    class="delete-form">
                                <button type="button" 
                                        class="delete-btn" 
                                        onclick="confirmDelete('<%= c.categoryID %>')">
                                    🗑 Delete
                                </button>
                                </form>
                            </div>

                        </div>
                    </div>

                <% }) %>

            <% } else { %>
                <p>No categories found.</p>
            <% } %>
        </div>

    </div>

    <!-- SweetAlert2 CDN -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    // SWEETALERT ADD & UPDATE CONFIRM
      const successMsg = "<%= flashSuccess ? flashSuccess : '' %>";
      const errorMsg   = "<%= flashError ? flashError : '' %>";

      if (successMsg && !successMsg.toLowerCase().includes("login")) {
        Swal.fire({
          icon: 'success',
          title: successMsg.toLowerCase().includes('updated')
                 ? 'Updated Successfully!'
                 : successMsg.toLowerCase().includes('added')
                 ? 'Category Added!'
                 : 'Success!',
          text: successMsg,
          showConfirmButton: false,
          timer: 2000
        });
      }

      if (errorMsg) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: errorMsg,
          confirmButtonText: 'OK'
        });
      }
    </script>

    <script>
    // SWEETALERT DELETE CONFIRM
    function confirmDelete(categoryID) {
        Swal.fire({
        title: "Delete category?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#e63946",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Yes, delete it"
        }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById(`deleteForm-${categoryID}`).submit();
        }
        });
    }
    </script>

    <script>
    // AUTO-HIDE FLASH MESSAGES
    setTimeout(() => {
        const flashMessages = document.querySelectorAll('.flash-msg');
        flashMessages.forEach(msg => {
        msg.style.transition = 'opacity 0.5s';
        msg.style.opacity = '0';

        setTimeout(() => msg.remove(), 500);
        });
    }, 3500);
    </script>

</body>
</html>
