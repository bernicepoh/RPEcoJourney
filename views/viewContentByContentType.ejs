<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="/translations.js"></script>

  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-color: #e8dfcf;
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
      min-height: 100vh;
    }

    /* Hero banner */
    .hero {
      position: relative;
      width: 100%;
      min-height: 240px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding: 24px 16px;
    }
    .hero::before {
      content: '';
      position:absolute; inset:0;
    }

    /* Content Type Description */
    .cat-card {
      position: relative;
      z-index: 1;
      background:#145a32;
      color:#fff;
      border-radius: 28px;
      padding: 24px 28px;
      width: min(980px, 92%);
      text-align:center;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
      border: 3px solid #2e7d32;
    }
    .cat-card h2 {
      margin:0 0 10px 0;
      font-size:1.35rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }
    .cat-card p {
      margin:0;
      line-height:1.7;
      font-size:1.05rem;
    }

    /* Fixed column for all previews */
    .file-box {
      width: 250px;              /* all previews share SAME width */
      height: 160px;             /* adjust height if needed */
      display: flex;
      align-items: center;       /* center vertically */
      justify-content: center;   /* center horizontally */
      margin-right: 25px;
    }

    /* Image / video auto-fit inside the box */
    .file-box img,
    .file-box video {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      border-radius: 12px;
    }

    .engagement-bar {
        display: flex;
        align-items: center;
        gap: 25px;
        margin-top: 10px;
    }

    .eng-section {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #ffffffc9;
        padding: 6px 12px;
        border-radius: 10px;
        box-shadow: 0 1px 3px #0001;
        transition: 0.2s;
    }

    .eng-section:hover {
        background: #f2f2f2;
    }

    .eng-section button {
        border: none;
        background: none;
        font-size: 14px;
        cursor: pointer;
        padding: 0;
    }

    .eng-section .count {
        font-weight: 600;
        color: #444;
        font-size: 14px;
    }

    .back-link {
      display: inline-block;
      margin-top: 50px;
      text-decoration: none;
      color: #256b45;
      font-weight: 700;
      font-size: 1rem;
      transition: color 0.3s ease;
    }

    .back-link:hover {
      text-decoration: underline;
      color: #1a4b32;
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }
  </style>
</head>
<body>
  <%- include ('partials/navbar.ejs') %>  

  <%
    const heroBg = (contentType && contentType.contentTypeImage) 
      ? '/uploads/' + contentType.contentTypeImage 
      : '/uploads/default.png';
  %>

  <!-- HERO -->
  <section class="hero" style="background-image: url('<%= heroBg %>');">
    <div class="cat-card">
      <h2>
        <%= contentType && contentType.contentTypeName 
            ? contentType.contentTypeName.toUpperCase() 
            : "Content Type Not Found" %>
      </h2>

      <p>
        <% if (contentType && contentType.contentTypeDescription) { %>
          <%= contentType.contentTypeDescription.split('.').slice(1).join('.').trim() %>
        <% } %>
      </p>
    </div>
  </section>

<div class="container">
  <br>
  <% for(let i=0; i < contentList.length; i++) { %>
  <div class="d-flex align-items-center mb-4 p-3">
    <div class="file-box">
      <% 
        const fileUrl = contentList[i].contentFile;
        const ext = contentList[i].contentFile.split('.').pop().toLowerCase();
        
        let previewUrl;
        
        if (['png','jpg','jpeg','gif','webp'].includes(ext)) {
          previewUrl = fileUrl; // Direct image
        } else if (['mp4','mov','avi'].includes(ext)) {
          previewUrl = fileUrl; // Direct video
        } else if (['pdf'].includes(ext)) {
          // PDF: request first page as image
          previewUrl = fileUrl
            .replace('/upload/', '/upload/pg_1,f_auto,q_auto,w_500/')
            .replace(/\.pdf$/i, '.jpg');
        } else if (['doc','docx','ppt','pptx','xls','xlsx'].includes(ext)) {
          // Office: assumes Aspose created .../image/upload/{public_id}.pdf
          // Replace /raw/ with /image/ and append .pdf.jpg with pg_1
          previewUrl = fileUrl
            .replace('/raw/upload/', '/image/upload/pg_1,f_auto,q_auto,w_500/')
            .replace(/\.(docx?|pptx?|xlsx?)$/i, '.$1.pdf.jpg');
        } else {
          previewUrl = '/images/default-doc-icon.png';
        }
      %>

      <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
        <img src="<%= previewUrl %>" alt="Preview">
      <% } else if (['mp4','mov','avi'].includes(ext)) { %>
        <video autoplay loop muted playsinline>
          <source src="<%= previewUrl %>">
        </video>
      <% } else { %>
        <a href="<%= fileUrl %>" target="_blank">
          <img src="<%= previewUrl %>" alt="<%= ext.toUpperCase() %> Preview" 
               onerror="this.src='/images/default-doc-icon.png';"
               style="width:100%;height:100%;object-fit:contain;border-radius:12px;">
          <div class="file-type-overlay" style="
            position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.7);color:white;
            padding:4px 8px;border-radius:20px;font-weight:bold;font-size:12px;">
            <%= ext.toUpperCase() %>
          </div>
        </a>
      <% } %>
    </div>

    <div style="flex:1">
      <h5 class="mb-1" style="color:#155f39;font-weight:700;">
        <a href="/content/<%= contentList[i].contentID %>" style="color:inherit; text-decoration:none;">
          <%= contentList[i].contentTitle %>
        </a>
      </h5>

      <p class="mb-2" style="font-style:italic;color:#155f39;font-size:1.03em;">
        <%= contentList[i].contentDescription.split('.')[0] + '.' %>
      </p>

      <div class="engagement-bar">
        <div class="eng-section">
          <!-- LIKE BUTTON -->
          <button class="like-btn" data-content-id="<%= contentList[i].contentID %>">
            <span class="heart-icon"><%= contentList[i].userLiked ? "❤️" : "🤍" %></span>
            <span class="like-count"><%= contentList[i].likeCount %></span>
            <span class="like-text">Like</span>
          </button>
        </div>

        <!-- COMMENT BUTTON -->
        <div class="eng-section">
          <button class="comment-btn" onclick="addComment('<%= contentList[i].contentID %>')">
            💬 <span class="comment-text">Comment</span>
          </button>
          <span class="count"><%= contentList[i].commentCount %></span>
        </div>

        <!-- SHARE BUTTON -->
        <div class="eng-section">
          <button class="share-btn" data-content-id="<%= contentList[i].contentID %>">
            ↗️ <span class="share-text">Share</span>
          </button>
          <span class="count"><%= contentList[i].totalShares || 0 %></span>
        </div>
      </div> 
    </div>
  </div>
<% } %>

    <a href="/categories" class="back-link" id="backLink">← Back to Categories</a>
</div>

  <script> //the edit was just the tab/spaces cos i OCD lol
    document.addEventListener('DOMContentLoaded', () => {
      // Translate UI elements
      document.querySelectorAll('.like-text').forEach(el => el.textContent = t('like'));
      document.querySelectorAll('.comment-text').forEach(el => el.textContent = t('comment'));
      document.querySelectorAll('.share-text').forEach(el => el.textContent = t('share'));
      const backLink = document.getElementById('backLink');
      if (backLink) backLink.textContent = t('backToCategories');

      const likeButtons = document.querySelectorAll('.like-btn');

      likeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const contentID = btn.getAttribute('data-content-id');
          console.log("Clicked button for contentID:", contentID, btn);

          fetch(`/toggle-like/${contentID}`, {
            method: 'POST'
          })
          .then(res => {
            if (res.status === 401) {
              // Not logged in
              alert(t('loginToLike'));
              return null;
            }
            return res.json();
          })
          .then(data => {
            console.log("Server returned:", data);
            if (!data) return;

            if (!data.success) {
              console.error('Toggle like failed.');
              return;
            }

            // Update heart icon
            const heartSpan = btn.querySelector('.heart-icon');
            if (data.liked) {
              heartSpan.textContent = '❤️';
            } else {
              heartSpan.textContent = '🤍';
            }

            // Update count text (number only)
            const countSpan = btn.querySelector('.like-count');
            countSpan.textContent = data.likeCount;
          })
          .catch(err => {
            console.error('Error toggling like:', err);
          });
        });
      });
    });
  </script>

  <script>
  function addComment(contentID) {
      window.location.href = `/content/${contentID}?from=contentType`;
  }
  </script>

  <script>
  document.addEventListener("DOMContentLoaded", () => {

    const baseURL = window.location.origin;

    document.querySelectorAll('.share-btn').forEach(btn => {
      btn.addEventListener('click', async () => {

        const contentID = btn.dataset.contentId;
        const shareURL = `${baseURL}/content/${contentID}`;

        // PHONE / MOBILE SHARE
        if (navigator.share) {
          try {
            await navigator.share({
              title: "RPEcoJourney Content",
              text: "Check out this sustainability content!",
              url: shareURL
            });
          } catch (err) {}
        }
        // DESKTOP FALLBACK
        else {
          await navigator.clipboard.writeText(shareURL);
          alert("Link copied!");
        }

        // UPDATE BACKEND (will fail silently if not logged in)
        try {
          await fetch(`/share/${contentID}`, { method: "POST" });
        } catch (e) {}

        // UPDATE UI COUNTER  
        const countSpan = btn.parentElement.querySelector('.count');
        if (countSpan) {
          countSpan.textContent = parseInt(countSpan.textContent) + 1;
        }

  document.addEventListener("DOMContentLoaded", async () => {
      const baseURL = await getBaseURL();

      document.querySelectorAll('.share-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
              const contentID = btn.dataset.contentId;
              const shareURL = `${baseURL}/content/${contentID}`;

              // PHONE SHARE
              if (navigator.share) {
                  try {
                      await navigator.share({
                          title: t('shareTitle'),
                          text: t('shareText'),
                          url: shareURL
                      });
                  } catch (err) {}
              } 
              // DESKTOP
              else {
                  await navigator.clipboard.writeText(shareURL);
                  alert(t('linkCopied'));
              }

              // UPDATE BACKEND
              await fetch(`/share/${contentID}`, { method: "POST" });

              // 🔥 UPDATE UI COUNTER
              const countSpan = btn.parentElement.querySelector('.count');
              const current = parseInt(countSpan.textContent);
              countSpan.textContent = current + 1;
          });
      });
    });

  });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>