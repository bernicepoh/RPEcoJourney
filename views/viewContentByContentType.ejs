<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="/translations.js"></script>

  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-image: url("/uploads/background.png");
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
      min-height: 100vh;
    }

    /* Hero banner */
    .hero {
      position: relative;
      width: 100%;
      min-height: 240px;
      background: url('/uploads/environmental-banner.png') center/cover no-repeat;
      background-color:#cfe9c9;
      display:flex;
      align-items:center;
      justify-content:center;
      padding: 24px 16px;
    }
    .hero::before {
      content: '';
      position:absolute; inset:0;
      background: linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0));
    }

    /* Content Type Description */
    .cat-card {
      position: relative;
      z-index: 1;
      background:#145a32;
      color:#fff;
      border-radius: 28px;
      padding: 24px 28px;
      width: min(980px, 92%);
      text-align:center;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
      border: 3px solid #2e7d32;
    }
    .cat-card h2 {
      margin:0 0 10px 0;
      font-size:1.35rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }
    .cat-card p {
      margin:0;
      line-height:1.7;
      font-size:1.05rem;
    }

    /* Spotlight (Content Type Manager) */
    .spotlight {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 18px;
      background: #155f39;              /* deep green!!!! */
      color: #fff;
      padding: 22px 28px;
      border-radius: 28px;               
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
      max-width: 1100px;               
      margin: 18px auto;                 /* center on page */
    }

    .spotlight__avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.6);
      box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    }

    .spotlight__content {
      display: grid;
      gap: 6px;
    }

    .spotlight__title {
      margin: 0;
      font-style: italic;              
      font-weight: 700;
      letter-spacing: 0.1px;
    }

    .spotlight__card {
      margin: 0;
      line-height: 1.6;            /* uhm slightly softer white */
    }

    /* Fixed column for all previews */
    .file-box {
      width: 250px;              /* all previews share SAME width */
      height: 160px;             /* adjust height if needed */
      display: flex;
      align-items: center;       /* center vertically */
      justify-content: center;   /* center horizontally */
      margin-right: 25px;
    }

    /* Image / video auto-fit inside the box */
    .file-box img,
    .file-box video {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      border-radius: 12px;
    }

    .engagement-bar {
        display: flex;
        align-items: center;
        gap: 25px;
        margin-top: 10px;
    }

    .eng-section {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #ffffffc9;
        padding: 6px 12px;
        border-radius: 10px;
        box-shadow: 0 1px 3px #0001;
        transition: 0.2s;
    }

    .eng-section:hover {
        background: #f2f2f2;
    }

    .eng-section button {
        border: none;
        background: none;
        font-size: 14px;
        cursor: pointer;
        padding: 0;
    }

    .eng-section .count {
        font-weight: 600;
        color: #444;
        font-size: 14px;
    }

    .back-link {
      display: inline-block;
      margin-top: 50px;
      text-decoration: none;
      color: #256b45;
      font-weight: 700;
      font-size: 1rem;
      transition: color 0.3s ease;
    }

    .back-link:hover {
      text-decoration: underline;
      color: #1a4b32;
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }
  </style>
</head>
<body>
  <%- include ('partials/navbar.ejs') %>  

  <%
    const heroBg = (contentType && contentType.contentTypeImage) 
      ? '/uploads/' + contentType.contentTypeImage 
      : '/uploads/default.png';
  %>

  <!-- HERO -->
  <section class="hero" style="background-image: url('<%= heroBg %>');">
    <div class="cat-card">
      <h2>
        <%= contentType && contentType.contentTypeName 
            ? contentType.contentTypeName.toUpperCase() 
            : "Content Type Not Found" %>
      </h2>

      <p>
        <% if (contentType && contentType.contentTypeDescription) { %>
          <%= contentType.contentTypeDescription.split('.').slice(1).join('.').trim() %>
        <% } %>
      </p>
    </div>
  </section>

<div class="container">
  <br>
  <% for(let i=0; i < contentList.length; i++) { %>
    <div class="d-flex align-items-center mb-4 p-3">
      <div class="file-box">
        <% const ext = contentList[i].contentFile.split('.').pop().toLowerCase(); %>
        <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
          <img src="/uploads/<%= contentList[i].contentFile %>">
        <% } else if (ext === 'pdf') { %>
          <a href="/uploads/<%= contentList[i].contentFile %>" target="_blank">
            <img class="file-icon" src="/uploads/pdf.png" style="width: 150px;">
          </a>
        <% } else if (['doc','docx'].includes(ext)) { %>
          <a href="/uploads/<%= contentList[i].contentFile %>" target="_blank">
            <img class="file-icon" src="/uploads/word.png" style="width: 150px;">
          </a>
        <% } else if (['ppt','pptx'].includes(ext)) { %>
          <a href="/uploads/<%= contentList[i].contentFile %>" target="_blank">
            <img class="file-icon" src="/uploads/ppt.png" style="width: 150px;">
          </a>
        <% } else if (['mp4','mov','avi'].includes(ext)) { %>
          <video autoplay loop muted playsinline>
            <source src="/uploads/<%= contentList[i].contentFile %>">
          </video>
        <% } else { %>
          <a href="/uploads/<%= contentList[i].contentFile %>" target="_blank">
            <img class="file-icon" src="/uploads/file.png" style="width: 150px;">
          </a>
        <% } %>
      </div>

      <div style="flex:1">
            <h5 class="mb-1" style="color:#155f39;font-weight:700;">
              <a href="/content/<%= contentList[i].contentID %>" style="color:inherit; text-decoration:none;">
                <%= contentList[i].contentTitle %>
              </a>
            </h5>

            <p class="mb-2" style="font-style:italic;color:#155f39;font-size:1.03em;"><%= contentList[i].contentDescription.split('.')[0] + '.' %></p>

            <div class="engagement-bar">
            <div class="eng-section">

              <!-- LIKE BUTTON -->
              <button class="like-btn" data-content-id="<%= contentList[i].contentID %>">
                  <span class="heart-icon"><%= contentList[i].userLiked ? "❤️" : "🤍" %></span>

                  <!-- LIKE COUNT -->
                  <span class="like-count"><%= contentList[i].likeCount %></span>
                  <span class="like-text">Like</span>
              </button>
            </div>

              <!-- COMMENT BUTTON -->
            <div class="eng-section">
                <button class="comment-btn" onclick="addComment('<%= contentList[i].contentID %>')">
                    💬 <span class="comment-text">Comment</span>
                </button>

                <!-- COMMENT COUNT -->
                <span class="count"><%= contentList[i].commentCount %></span>
            </div>

            <!-- SHARE BUTTON -->
            <div class="eng-section">
                    <button class="share-btn" data-content-id="<%= contentList[i].contentID %>">
                        ↗️ <span class="share-text">Share</span>
                    </button>
                    
                    <!-- SHARE COUNT -->
                    <span class="count"><%= contentList[i].totalShares || 0 %></span>
                </div>
            </div> 
          </div>
        </div>
      <% } %>
    <a href="/categories" class="back-link" id="backLink">← Back to Categories</a>
</div>

  <script> //the edit was just the tab/spaces cos i OCD lol
    document.addEventListener('DOMContentLoaded', () => {
      // Translate UI elements
      document.querySelectorAll('.like-text').forEach(el => el.textContent = t('like'));
      document.querySelectorAll('.comment-text').forEach(el => el.textContent = t('comment'));
      document.querySelectorAll('.share-text').forEach(el => el.textContent = t('share'));
      const backLink = document.getElementById('backLink');
      if (backLink) backLink.textContent = t('backToCategories');

      const likeButtons = document.querySelectorAll('.like-btn');

      likeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const contentID = btn.getAttribute('data-content-id');
          console.log("Clicked button for contentID:", contentID, btn);

          fetch(`/toggle-like/${contentID}`, {
            method: 'POST'
          })
          .then(res => {
            if (res.status === 401) {
              // Not logged in
              alert(t('loginToLike'));
              return null;
            }
            return res.json();
          })
          .then(data => {
            console.log("Server returned:", data);
            if (!data) return;

            if (!data.success) {
              console.error('Toggle like failed.');
              return;
            }

            // Update heart icon
            const heartSpan = btn.querySelector('.heart-icon');
            if (data.liked) {
              heartSpan.textContent = '❤️';
            } else {
              heartSpan.textContent = '🤍';
            }

            // Update count text (number only)
            const countSpan = btn.querySelector('.like-count');
            countSpan.textContent = data.likeCount;
          })
          .catch(err => {
            console.error('Error toggling like:', err);
          });
        });
      });
    });
  </script>

  <script>
  function addComment(contentID) {
      window.location.href = `/content/${contentID}?from=contentType`;
  }
  </script>

  <script>
  async function getBaseURL() {
      try {
          const res = await fetch('/ngrok-url');
          const data = await res.json();
          if (data.url) return data.url;
      } catch (error) {
        console.log("No ngrok URL found, using local");
      }
      return window.location.origin;
  }

  document.addEventListener("DOMContentLoaded", async () => {
      const baseURL = await getBaseURL();

      document.querySelectorAll('.share-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
              const contentID = btn.dataset.contentId;
              const shareURL = `${baseURL}/content/${contentID}`;

              // PHONE SHARE
              if (navigator.share) {
                  try {
                      await navigator.share({
                          title: t('shareTitle'),
                          text: t('shareText'),
                          url: shareURL
                      });
                  } catch (err) {}
              } 
              // DESKTOP
              else {
                  await navigator.clipboard.writeText(shareURL);
                  alert(t('linkCopied'));
              }

              // UPDATE BACKEND
              await fetch(`/share/${contentID}`, { method: "POST" });

              // 🔥 UPDATE UI COUNTER
              const countSpan = btn.parentElement.querySelector('.count');
              const current = parseInt(countSpan.textContent);
              countSpan.textContent = current + 1;
          });
      });
  });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>