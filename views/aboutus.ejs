<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us | RPECOJOURNEY</title>
  <script src="/translations.js"></script>

  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: 'Georgia', serif;
    }

    /* Background */
    body {
      background: #e8dfcf;
      color: #073b3a;
      line-height: 1.8;
      position: relative;
    }

    .about-container {
      padding: 80px 10%;
    }

    /* About Us Section */
    .about-section h2 {
      font-size: 3.2rem;
      text-align: center;
      margin-bottom: 50px;
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.7);
    }

    .about-row {
      display: flex;
      justify-content: center;
      align-items: stretch; /* This forces both children to be the same height */
      flex-wrap: nowrap;
      gap: 40px;
    }

    .about-text {
      flex: 1;
      font-size: 1.4rem; /* Slightly smaller to fit better */
      color: #f5f5f5;
      text-align: justify;
      background-color: rgba(0, 0, 0, 0.6);
      padding: 30px;
      border-radius: 10px;
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .about-image {
      flex: 0 0 auto;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .about-image img {
      width: 100%;
      max-width: 600px; /* 💚 sweet spot */
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
      object-fit: cover;
    }

    /* Vision Section */
    .vision-section {
      margin: 80px 0;
      background-color: rgba(46, 139, 87, 0.6);
      padding: 50px;
      border-radius: 10px;
      text-align: center;
    }

    .vision-section h3 {
      font-size: 2.8rem;
      margin-bottom: 20px;
      font-style: italic;
      color: #d4f4d4;
    }

    .vision-section p {
      font-size: 1.6rem;
      color: #fff;
    }

    /* Mission Section */
    .mission-section {
      background-color: rgba(0, 0, 0, 0.7);
      padding: 50px;
      border-radius: 10px;
    }

    .mission-section h3 {
      font-size: 2.8rem;
      text-align: center;
      margin-bottom: 30px;
      font-style: italic;
      color: #d4f4d4;
    }

    .mission-section ul {
      list-style-type: disc;
      margin: 0 auto;
      max-width: 950px;
      font-size: 1.5rem;
      color: #f5f5f5;
      text-align: left;
      padding-left: 50px;
      line-height: 2;
    }

    .mission-section li {
      margin-bottom: 18px;
    }

    /* Responsive (mobile only) */
    @media (max-width: 992px) {
      .about-row {
        flex-direction: column;
        align-items: center;
      }
      .about-image img {
        max-width: 100%;
      }
      .about-text {
        font-size: 1.4rem;
      }
    }

    footer { 
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }
  </style>
</head>
<body>
  <!-- Include Navbar -->
  <%- include('partials/navbar') %>

  <div class="about-container">
    <!-- ABOUT US SECTION -->
    <section class="about-section">
      <h2 id="aboutHeading">About Us</h2>
      <div class="about-row">
        <div class="about-text">
          <p id="aboutPara1">
            <strong>RPEcoJourney</strong> is a platform created by Republic Polytechnic students to
            celebrate and share our commitment to sustainability. Our goal is to
            showcase innovative projects, creative solutions, and meaningful initiatives
            that contribute to a greener and more sustainable future.
          </p>
          <p id="aboutPara2">
            Through this website, RP students can highlight their environmental efforts,
            inspire others to take action, and connect with like-minded individuals who
            care about our planet. RPEcoJourney is not just a collection of projects—it’s
            a growing community of changemakers dedicated to making sustainability a way of life.
          </p>
        </div>
        <div class="about-image">
          <img src="https://res.cloudinary.com/dmyv7fbha/image/upload/v1769654898/aboutus_gmc0gx.jpg" alt="RP Students Sustainability Project" />
        </div>
      </div>
    </section>

    <!-- VISION SECTION -->
    <section class="vision-section">
      <h3 id="visionHeading">Vision</h3>
      <p id="visionText">
        To inspire a community of Republic Polytechnic students who lead the way in building a
        sustainable and environmentally conscious future.
      </p>
    </section>

    <!-- MISSION SECTION -->
    <section class="mission-section">
      <h3 id="missionHeading">Mission</h3>
      <ul>
        <li id="mission1">To provide a platform for RP students to showcase their sustainability projects and creative green solutions.</li>
        <li id="mission2">To raise awareness about environmental challenges and promote sustainable practices within the RP community.</li>
        <li id="mission3">To encourage collaboration and innovation among students passionate about making a positive impact on the planet.</li>
        <li id="mission4">To celebrate student achievements in sustainability and motivate others to join the journey toward a greener tomorrow.</li>
      </ul>
    </section>

     <div class="Location-Info">
        <div class="Locate">
            <h2 id="locateHeading">Locate Us!</h2>
           <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.5533339967915!2d103.78298867359057!3d1.4428309985435963!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31da1305aa7388d7%3A0x2b7f5e0463382f8!2sRepublic%20Polytechnic!5e0!3m2!1sen!2ssg!4v1763017441787!5m2!1sen!2ssg" width="700" height="450" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <h2 class="address" id="addressText">
            Republic Polytechnic<br>
            9 Woodlands Ave 9, Singapore 738964

        </h2>
    </div>
  </div>

  <footer id="footerText">
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>

  <script>
    // Translate page content on load
    document.addEventListener('DOMContentLoaded', () => {
      // About Us section
      const aboutHeading = document.getElementById('aboutHeading');
      const aboutPara1 = document.getElementById('aboutPara1');
      const aboutPara2 = document.getElementById('aboutPara2');
      
      if (aboutHeading) aboutHeading.textContent = t('aboutUsTitle');
      if (aboutPara1) aboutPara1.innerHTML = t('aboutPara1');
      if (aboutPara2) aboutPara2.innerHTML = t('aboutPara2');

      // Vision section
      const visionHeading = document.getElementById('visionHeading');
      const visionText = document.getElementById('visionText');
      
      if (visionHeading) visionHeading.textContent = t('visionHeading');
      if (visionText) visionText.textContent = t('visionText');

      // Mission section
      const missionHeading = document.getElementById('missionHeading');
      const mission1 = document.getElementById('mission1');
      const mission2 = document.getElementById('mission2');
      const mission3 = document.getElementById('mission3');
      const mission4 = document.getElementById('mission4');
      
      if (missionHeading) missionHeading.textContent = t('missionHeading');
      if (mission1) mission1.textContent = t('mission1');
      if (mission2) mission2.textContent = t('mission2');
      if (mission3) mission3.textContent = t('mission3');
      if (mission4) mission4.textContent = t('mission4');

      // Location
      const locateHeading = document.getElementById('locateHeading');
      const addressText = document.getElementById('addressText');
      
      if (locateHeading) locateHeading.textContent = t('locateUs');
      if (addressText) addressText.innerHTML = t('address');

      // Footer
      const footerText = document.getElementById('footerText');
      if (footerText) footerText.innerHTML = t('footer');
    });
  </script>
</body>
</html>