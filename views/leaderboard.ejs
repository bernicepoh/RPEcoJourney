<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Leaderboard | RPEcoJourney</title>
    <script src="/translations.js"></script>

    <style>
        body {
            background-color: #e8dfcf;
            background-size: cover;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
        }

        .leaderboard-container {
            max-width: 900px;
            margin: 40px auto;
            background: rgba(255, 255, 255, 0.92);
            border-radius: 25px;
            padding: 30px 40px;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.12);
            backdrop-filter: blur(4px);
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 35px;
            color: #1f4b2c;
            font-weight: 800;
        }

        /* Tabs */
        .tabs {
            display: flex;
            justify-content: center;
            margin-bottom: 25px;
            background: #e3f6df;
            padding: 8px;
            border-radius: 40px;
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
            gap: 5px;
        }

        .tab {
            padding: 10px 25px;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 600;
            color: #1f4b2c;
            background: transparent;
            transition: 0.3s;
        }

        .tab.active {
            background: #69b578;
            color: white;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 16px;
        }

        th {
            text-align: left;
            padding: 12px 5px;
            color: #1f4b2c;
            font-size: 15px;
            border-bottom: 2px solid #c8e8c3;
        }

        td {
            padding: 12px 5px;
            border-bottom: 1px solid #e4f2e1;
            color: #1f4b2c;
        }

        .profile-pic {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 10px;
        }

        .user-flex {
            display: flex;
            align-items: center;
        }

        .fire {
            color: #ff5722;
            font-size: 18px;
        }
    </style>
</head>

<body>
<%- include('partials/navbar') %>

<div class="leaderboard-container">

    <h1 id="leaderboardTitle">LEADERBOARD</h1>

    <!-- Tabs -->
    <div class="tabs">
        <div class="tab active" id="tabOverall">Overall</div>
        <div class="tab" id="tabMonthly">Monthly</div>
        <div class="tab" id="tabFriends">Friends</div>
    </div>

    <!-- Table -->
    <table>
        <thead>
            <tr>
                <th id="thRank">Rank</th>
                <th id="thUser">User</th>
                <th id="thLevel">Level</th>
                <th>XP</th>
                <th id="thStreak">Streak</th>
            </tr>
        </thead>

        <tbody>
        <% users.forEach((u, index) => { %>

            <tr>
                <!-- Rank -->
                <td>
                    <% if (index === 0) { %>
                        🥇
                    <% } else if (index === 1) { %>
                        🥈
                    <% } else if (index === 2) { %>
                        🥉
                    <% } else { %>
                        <%= index + 1 %>
                    <% } %>
                </td>

                <!-- User + Picture -->
                <td>
                    <div class="user-flex">
                        <img class="profile-pic" src="<%= u.image %>" alt="">
                        <%= u.userName %>
                    </div>
                </td>

                <!-- Level -->
                <td>
                    <div class="user-flex">
                        <% if (u.levelBadge) { %>
                            <img src="<%= u.levelBadge %>" style="width:25px; height:25px; border-radius:50%; margin-right:8px;" alt="Level Badge">
                        <% } %>
                        Lv <%= u.level %>
                    </div>
                </td>

                <!-- XP -->
                <td><%= u.totalXP %> XP</td>

                <!-- Streak -->
                <td>
                    <% if (u.streak > 0) { %>
                        <span class="fire">🔥</span> <%= u.streak %>
                    <% } else { %>
                        —
                    <% } %>
                </td>
            </tr>

        <% }) %>
        </tbody>
    </table>

</div>

<script>
    // Translate page content on load
    document.addEventListener('DOMContentLoaded', () => {
        const leaderboardTitle = document.getElementById('leaderboardTitle');
        const tabOverall = document.getElementById('tabOverall');
        const tabMonthly = document.getElementById('tabMonthly');
        const tabFriends = document.getElementById('tabFriends');
        const thRank = document.getElementById('thRank');
        const thUser = document.getElementById('thUser');
        const thLevel = document.getElementById('thLevel');
        const thStreak = document.getElementById('thStreak');

        if (leaderboardTitle) leaderboardTitle.textContent = t('leaderboardTitle');
        if (tabOverall) tabOverall.textContent = t('tabOverall');
        if (tabMonthly) tabMonthly.textContent = t('tabMonthly');
        if (tabFriends) tabFriends.textContent = t('tabFriends');
        if (thRank) thRank.textContent = t('rank');
        if (thUser) thUser.textContent = t('user');
        if (thLevel) thLevel.textContent = t('level');
        if (thStreak) thStreak.textContent = t('streak');
    });
</script>

</body>
</html>
