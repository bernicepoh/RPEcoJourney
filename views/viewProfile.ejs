<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="/translations.js"></script>

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Georgia', serif;
            background-color: #e8dfcf;
            background-repeat: no-repeat;
            background-size: cover; 
            background-position: center;
        }

        .profile-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 100px;
            padding-bottom: 40px;
        }

        .profile-title {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 40px;
            color: #1b5e20;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
            animation: fadeIn 0.6s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 50px;
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            padding: 50px 70px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(10px);
            animation: slideIn 0.7s ease-in-out;
            max-width: 800px;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .profile-card img {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid #2e7d32;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
        }

        .profile-card img:hover {
            transform: scale(1.05) rotate(2deg);
        }

        .profile-info {
            text-align: left;
            font-size: 18px;
            line-height: 40px;
            color: #1b5e20;
            flex: 1;
        }

        .profile-info div {
            padding: 8px 0;
            border-bottom: 1px solid rgba(46, 125, 50, 0.2);
        }

        .profile-info div:last-of-type {
            border-bottom: none;
            margin-bottom: 20px;
        }

        .profile-info b {
            font-weight: 700;
            color: #2e7d32;
            display: inline-block;
            min-width: 150px;
        }

        .edit-btn {
            padding: 14px 30px;
            background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(27, 94, 32, 0.3);
        }

        .edit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(27, 94, 32, 0.4);
            background: linear-gradient(135deg, #1b5e20 0%, #134818 100%);
        }

        @media (max-width: 768px) {
            .profile-card {
                flex-direction: column;
                text-align: center;
                padding: 40px 30px;
            }

            .profile-info {
                text-align: center;
            }

            .profile-info b {
                display: block;
                margin-bottom: 5px;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>

<div class="profile-wrapper">

    <div class="profile-title" id="profileTitle">Profile</div>

    <div class="profile-card">

        
        <% if (user.image) { %>
            <img src="<%= user.image %>" alt="Profile Picture">
            
        <% } else { %>
            <img src="https://res.cloudinary.com/dmyv7fbha/image/upload/v1769968875/defaultUser_rgp4og.png" alt="Profile Picture">
        <% } %>

      
        <div class="profile-info">
            <div><b id="usernameLabel">Username</b>: <%= user.userName %></div>
            <div><b id="emailLabel">Email</b>: <%= user.email %></div>
            <div><b id="contactLabel">Contact Number</b>: <%= user.contactNo %></div>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
                <b>Level</b>: 
                <img src="<%= user.levelBadge %>" style="width:25px; height:25px; border-radius:50%;">
                Level <%= user.level %> - <%= user.levelTitle %>
            </div>
            <br>
            <a href="/editProfile/<%= user.userID %>">
                <button class="edit-btn" id="editProfileBtn">Edit Profile</button>
            </a>
        </div>

    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const profileTitle = document.getElementById('profileTitle');
        const usernameLabel = document.getElementById('usernameLabel');
        const emailLabel = document.getElementById('emailLabel');
        const contactLabel = document.getElementById('contactLabel');
        const editProfileBtn = document.getElementById('editProfileBtn');
        
        if (profileTitle) profileTitle.textContent = t('profileTitle');
        if (usernameLabel) usernameLabel.textContent = t('usernameLabel');
        if (emailLabel) emailLabel.textContent = t('emailLabel');
        if (contactLabel) contactLabel.textContent = t('contactLabel');
        if (editProfileBtn) editProfileBtn.textContent = t('editProfileBtn');
    });
</script>

</body>
</html>
