<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quiz | RPECOJOURNEY</title>
  <style>
    body { font-family: "Arial", sans-serif; background: url('/images/backgroundimage.jpg') no-repeat center center fixed; background-size: cover; margin: 0; padding: 0; color: #0b2535; }
    body::before { content: ""; position: fixed; inset: 0; background-color: rgba(255,255,255,0.85); z-index: -1; }
    .quiz-container { max-width: 900px; margin: 100px auto; background: #a9c6d9; border-radius: 15px; padding: 40px; box-shadow: 0 4px 10px rgba(0,0,0,0.2); position: relative; }
    .back-btn { position: absolute; top: 20px; left: 25px; background-color: #256b45; color: #fff; border: 0; padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; text-decoration: none; font-size: 1rem; transition: .3s; }
    .back-btn:hover { background-color: #1a4b32; }
    h2 { text-align: center; font-size: 2.6rem; margin-bottom: 20px; color: #0b2535; }
    p.intro { text-align: center; font-size: 1.2rem; color: #333; margin-bottom: 30px; }
    #timer { font-size: 1.6rem; font-weight: 700; color: #256b45; background: rgba(255,255,255,.8); width: fit-content; margin: 0 auto 20px; padding: 10px 24px; border-radius: 12px; box-shadow: 0 2px 6px rgba(0,0,0,.18); }
    .question-block { margin-bottom: 30px; background: rgba(255,255,255,.6); padding: 25px; border-radius: 10px; }
    .question-block h3 { font-size: 1.4rem; margin-bottom: 10px; font-style: italic; }
    .option { display: block; margin: 10px 0; background: #fff; border: 2px solid transparent; border-radius: 25px; padding: 10px 15px; font-size: 1rem; text-align: left; cursor: pointer; transition: .3s; }
    .option:hover { border-color: #2e8b57; background-color: #e9f5ef; }
    .btn-submit { display: block; margin: 40px auto 0; background-color: #256b45; color: #fff; padding: 15px 30px; border-radius: 10px; border: 0; cursor: pointer; font-weight: 700; font-size: 1.1rem; transition: .3s; }
    .btn-submit:hover { background-color: #1a4b32; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="quiz-container">
    <a href="/quiz" class="back-btn">← Back to Topics</a>

    <h2>Sustainability Quiz 🌿</h2>
    <p class="intro">You have <strong>20 seconds per question</strong> — the timer will submit automatically when time runs out.</p>

    <div id="timer">⏳ Time left: <span id="timeLeft">0</span>s</div>

    <form id="quizForm" method="POST" action="/quiz/submit">
      <input type="hidden" name="categoryId" value="<%= categoryId %>">
      <input type="hidden" name="setNumber" value="<%= setNumber %>">

      <% if (questions && questions.length > 0) { %>
        <% questions.forEach((q, index) => { %>
          <div class="question-block">
            <h3><em>Question <%= index + 1 %> of <%= questions.length %></em></h3>
            <p><%= q.question %></p>

            <label class="option">
              <input type="radio" name="ans_<%= q.id %>" value="1" required> A) <%= q.option1 %>
            </label>
            <label class="option">
              <input type="radio" name="ans_<%= q.id %>" value="2"> B) <%= q.option2 %>
            </label>
            <label class="option">
              <input type="radio" name="ans_<%= q.id %>" value="3"> C) <%= q.option3 %>
            </label>
            <label class="option">
              <input type="radio" name="ans_<%= q.id %>" value="4"> D) <%= q.option4 %>
            </label>
          </div>
        <% }) %>
      <% } else { %>
        <p>No questions found for this set.</p>
      <% } %>

      <button type="button" id="confirmSubmit" class="btn-submit">Submit Quiz</button>
    </form>
  </div>

  <script>
    const totalQuestions = <%= questions && questions.length ? questions.length : 0 %>;
    let timeLeft = totalQuestions * 20;
    const timerDisplay = document.getElementById("timeLeft");
    const quizForm = document.getElementById("quizForm");
    const confirmBtn = document.getElementById("confirmSubmit");

    timerDisplay.textContent = timeLeft;

    const timer = setInterval(() => {
      timeLeft--;
      timerDisplay.textContent = timeLeft;
      if (timeLeft <= 15) timerDisplay.parentElement.style.color = "#d9534f";
      if (timeLeft <= 0) {
        clearInterval(timer);
        alert("⏰ Time's up! Submitting your quiz...");
        quizForm.submit();
      }
    }, 1000);

    confirmBtn.addEventListener("click", () => {
      const ok = confirm("⚠️ Submit your answers now?");
      if (ok) { clearInterval(timer); quizForm.submit(); }
    });

    
  </script>
</body>
</html>