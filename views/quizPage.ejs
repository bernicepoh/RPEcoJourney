<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sustainability Quiz</title>

  <style>
    body {
      font-family: 'Poppins', system-ui, sans-serif;
      margin: 0;
      padding: 0;
      background: url("/images/quizBackground.jpg") no-repeat center center fixed;
      background-size: cover;
      min-height: 100vh;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.35);
      z-index: -1;
    }

    .quiz-container {
      max-width: 900px;
      margin: 60px auto;
      background: rgba(255, 255, 255, 0.82);
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    }

    h2 {
      text-align: center;
      color: #0d3c3d;
      font-size: 2rem;
      margin-bottom: 10px;
    }

    .subtitle {
      text-align: center;
      color: #305e5f;
      margin-bottom: 30px;
    }

    .question-box {
      background: #d2e5f0;
      padding: 30px;
      border-radius: 18px;
      box-shadow: inset 0 0 8px rgba(0,0,0,0.05);
    }

    .question-number {
      font-style: italic;
      margin-bottom: 15px;
      color: #0d3c3d;
    }

    .question-text {
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 25px;
      color: #0d3c3d;
    }

    .option {
      margin: 10px 0;
      padding: 12px 16px;
      border-radius: 30px;
      background: #ffffff;
      display: block;
      border: 1px solid #ced7df;
      cursor: pointer;
      transition: 0.15s;
    }

    .option:hover { background: #eef7ee; }

    .correct { background: #8dc47c !important; color: white !important; font-weight: 600; }
    .incorrect { background: #df7c7c !important; color: white !important; font-weight: 600; }

    .btn-next {
      padding: 12px 25px;
      background: #85b36d;
      color: white;
      text-decoration: none;
      border-radius: 25px;
      margin-top: 20px;
      float: right;
      font-weight: 600;
    }

    .btn-next:hover { background: #6f945a; }
  </style>
</head>

<body>

<div class="quiz-container">
  <h2>Sustainability Quiz</h2>
  <p class="subtitle">Test your knowledge about sustainability!</p>

  <div class="question-box">

    <!-- 🟢 Question Number (now fixed!) -->
    <div class="question-number">
      Question <%= (questionIndex || 0) + 1 %> of <%= totalQuestions %>
    </div>

    <div class="question-text"><%= question.question %></div>

    <% if (!feedback) { %>

      <!-- 🟢 Answering Form -->
      <form id="quizForm" action="/quiz/game/answer" method="POST">
        <input type="hidden" name="quizID" value="<%= question.quizID %>">
        <input type="hidden" name="categoryID" value="<%= categoryID %>">
        <input type="hidden" name="setNumber" value="<%= setNumber %>">
        
        <!-- 🟢 NEW FIX: REAL QUESTION INDEX -->
        <input type="hidden" name="questionIndex" value="<%= questionIndex || 0 %>">

        <% for (let i = 1; i <= 4; i++) { %>
          <label class="option">
            <input type="radio" name="answer" value="<%= i %>" required>
            <%= String.fromCharCode(64 + i) %>) <%= question["option" + i] %>
          </label>
        <% } %>

        <button type="submit" class="btn-next">Submit →</button>
      </form>

    <% } else { %>

      <!-- Feedback view -->
      <% for (let i = 1; i <= 4; i++) { %>
        <div class="option 
          <% if (i === question.correctOption) { %> correct 
          <% } else if (i === userAnswer) { %> incorrect <% } %>">
          <%= String.fromCharCode(64 + i) %>) <%= question["option" + i] %>
        </div>
      <% } %>

      <!-- 🟢 NEXT or FINISH BUTTON -->
      <% if (nextQuizID && (questionIndex + 1) < totalQuestions) { %>
        <a href="/quiz/game/next/<%= nextQuizID %>/<%= categoryID %>/<%= setNumber %>?index=<%= questionIndex + 1 %>"class="btn-next">Next Question →</a>
        
        <% } else { %>
          <a href="/quiz/game/complete/<%= categoryID %>/<%= setNumber %>"
            class="btn-next">Finish Quiz →</a>
      
      <% } %>


    <% } %>

  </div>
</div>

</body>
</html>





