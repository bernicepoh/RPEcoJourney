<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sustainability Dashboard | Eco Journey</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Georgia', serif;
            background-color: #e8dfcf;
            background-repeat: no-repeat; 
            background-size: cover;
            background-position: center; 
            background-attachment: fixed;
            min-height: 100vh; 
            color: #2c3e50;
        }

        .dashboard-container { 
            max-width: 1100px; 
            margin: 40px auto; 
            padding: 40px; 
            background: rgba(255, 255, 255, 0.4); 
            backdrop-filter: blur(10px); 
            border-radius: 30px;
        }

        /* READABILITY FIX: High Opacity White Panels */
        .glass-panel {
            background: rgba(255, 255, 255, 0.97) !important; 
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid #ffffff;
        }

        .stats-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); 
            gap: 24px; 
        }

        .stat-card { 
            padding: 30px; 
            text-align: center; 
        }

        .stat-card h3 { 
            font-size: 2rem; 
            font-weight: 800; 
            color: #1b5e20; 
            font-family: 'Poppins', sans-serif; 
        }
        
        /* Heatmap Grid Aligned Sunday-Saturday */
        .heatmap-wrapper { 
            display: grid; 
            grid-auto-flow: column; 
            grid-template-rows: repeat(7, 1fr); 
            gap: 8px; 
        }

        .heatmap-square { 
            width: 20px; 
            height: 20px; 
            border-radius: 5px; 
            background-color: #ebedf0; 
        }

        .level-1 { background: #c8e6c9; } 
        .level-2 { background: #81c784; } 
        .level-3 { background: #2e7d32; }

        .history-title { 
            background: white; 
            color: #1b5e20; 
            padding: 10px 20px; 
            border-radius: 12px; 
            display: inline-block; 
            box-shadow: 0 4px 10px rgba(0,0,0,0.1); 
            margin-bottom: 25px; 
        }

        .log-card { 
            padding: 24px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 18px; 
            border-left: 10px solid #4CAF50 !important; 
        }

        .log-xp { 
            background: #e8f5e9; 
            padding: 10px 20px; 
            border-radius: 50px; 
            font-weight: 800; 
            color: #2e7d32; 
            border: 1px solid #c8e6c9; 
        }

        @media (max-width: 768px) {
            .dashboard-container {
                margin: 20px;
                padding: 20px;
            }
        }
    </style>
</head>
<body>

<%- include('partials/navbar') %>

<div class="dashboard-container">
    <header class="mb-5 text-center">
        <h1 class="fw-bold display-4" style="color: #1b5e20; font-family: 'Poppins', sans-serif;">Sustainability Journey</h1>
        <p class="lead fw-bold" style="color: #2e7d32;">Track your daily contributions and lifetime milestones.</p>
    </header>

    <div class="text-center my-4">
        <button id="wrappedBtn" class="btn btn-lg btn-success rounded-pill px-5 shadow-lg fw-bold" 
                style="background: linear-gradient(45deg, #1b5e20, #4caf50); border: none;">
            🎁 VIEW SEASON WRAP
        </button>
    </div>

    <div class="stats-grid mb-5">
        <div class="stat-card glass-panel"><span>⭐</span><p class="fw-bold m-0 text-muted">Total XP</p><h3>+<%= stats.currentXP %></h3></div>
        <div class="stat-card glass-panel"><span>🧠</span><p class="fw-bold m-0 text-muted">Quizzes</p><h3><%= stats.quizCount %></h3></div>
        <div class="stat-card glass-panel"><span>🎯</span><p class="fw-bold m-0 text-muted">Missions</p><h3><%= stats.missionCount %></h3></div>
        <div class="stat-card glass-panel"><span>🔥</span><p class="fw-bold m-0 text-muted">Streak</p><h3><%= stats.currentStreak %> Days</h3></div>
    </div>

    <div class="viz-card glass-panel p-5 mb-5 text-center">
        <h5 id="month-name" class="fw-bold text-success mb-4" style="font-family: 'Poppins', sans-serif;"></h5>
        <div class="d-flex justify-content-center gap-3 align-items-center">
            <div class="d-flex flex-column justify-content-between h-100 py-1 small fw-bold text-muted" style="height: 140px;">
                <span>Sun</span><span>Tue</span><span>Thu</span><span>Sat</span>
            </div>
            <div id="month-grid" class="heatmap-wrapper"></div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 mt-5">
        <h2 class="history-title m-0">Activity History</h2>
        <div class="bg-white p-2 rounded-3 shadow-sm">
            <label class="me-2 small fw-bold text-muted">Filter Month:</label>
            <select id="logMonthFilter" class="form-select border-0 fw-bold text-success" style="width: auto;" onchange="filterLogsByMonth()"></select>
        </div>
    </div>

    <div id="log-list">
        <% if (logs && logs.length > 0) { %>
            <% logs.forEach(log => { %>
                <div class="log-card glass-panel" data-month="<%= log.formattedDate.split(' ')[1] %>">
                    <div>
                        <strong class="d-block text-success" style="font-size: 1.15rem;"><%= log.earnedFrom %></strong>
                        <small class="text-muted"><%= log.formattedDate %></small>
                    </div>
                    <div class="log-xp">+<%= log.xpEarned %> XP</div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<div class="modal fade" id="ecoWrappedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" style="background: rgba(255,255,255,0.96); backdrop-filter: blur(15px);">
            <div class="modal-body d-flex flex-column align-items-center justify-content-center text-center p-5">
                <div id="wrap-content">
                    <h1 class="display-3 fw-bold text-success mb-2" id="wrap-title"></h1>
                    <p class="h4 text-muted mb-5" id="wrap-period"></p>
                    <div class="glass-panel p-5 shadow-lg border-success" style="max-width:650px;">
                        <h2 class="fw-bold text-dark mb-4" id="wrap-personality"></h2>
                        <p class="h5 leading-relaxed italic" id="wrap-analysis"></p>
                    </div>
                    <button class="btn btn-success btn-lg rounded-pill px-5 mt-5 fw-bold" data-bs-dismiss="modal">AWESOME!</button>
                </div>
            </div>
        </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const hData = <%- heatmapData %>;
    const now = new Date();

    function renderHeatmap() {
        const grid = document.getElementById('month-grid');
        const monthLabel = document.getElementById('month-name');
        const month = now.getMonth();
        const year = now.getFullYear();
        const mNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        monthLabel.innerText = `CURRENT MONTH: ${mNames[month].toUpperCase()} ${year}`;
        
        const first = new Date(year, month, 1);
        const last = new Date(year, month + 1, 0);
        let start = new Date(first);
        while (start.getDay() !== 0) { start.setDate(start.getDate() - 1); }
        grid.innerHTML = '';
        let curr = new Date(start);
        while (curr <= last || curr.getDay() !== 0) {
            const key = curr.toISOString().split('T')[0];
            const sq = document.createElement('div');
            if (curr.getMonth() === month) {
                const xp = hData[key] || 0;
                let lvl = 'level-0';
                if (xp >= 125) lvl = 'level-3';
                else if (xp >= 50) lvl = 'level-2';
                else if (xp > 0) lvl = 'level-1';
                sq.className = `heatmap-square ${lvl}`;
                sq.title = `${curr.toDateString()}: ${xp} XP`;
            } else { sq.style.visibility = 'hidden'; sq.className = 'heatmap-square'; }
            grid.appendChild(sq);
            curr.setDate(curr.getDate() + 1);
            if (curr > new Date(year, month + 1, 7)) break;
        }
    }


    document.getElementById('wrappedBtn').addEventListener('click', async () => {
        try {
            const res = await fetch('/eco-wrapped');
            if (res.status === 403) {
                const err = await res.json();
                alert(err.message);
                return;
            }
            const data = await res.json();
            const modal = new bootstrap.Modal(document.getElementById('ecoWrappedModal'));
            modal.show();
            document.getElementById('wrap-title').innerText = data.title;
            document.getElementById('wrap-period').innerText = data.quarter;
            document.getElementById('wrap-personality').innerText = data.personality;
            document.getElementById('wrap-analysis').innerText = data.analysis;
        } catch (err) {
            alert("Oops! The season wrap isn't available yet. Come back on the last day of the quarter!");
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        renderHeatmap();
        const filter = document.getElementById('logMonthFilter');
        const mNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const optAll = document.createElement('option');
        optAll.value = 'all'; optAll.innerText = 'All History';
        filter.appendChild(optAll);
        for(let i=0; i<12; i++){
            const opt = document.createElement('option');
            opt.value = mNames[i]; opt.innerText = mNames[i];
            if(i === now.getMonth()) opt.selected = true;
            filter.appendChild(opt);
        }
        filterLogsByMonth();
    });

    function filterLogsByMonth() {
        const val = document.getElementById('logMonthFilter').value;
        document.querySelectorAll('.log-card').forEach(card => {
            card.style.display = (val === 'all' || card.dataset.month === val) ? 'flex' : 'none';
        });
    }
</script>
</body>
</html>