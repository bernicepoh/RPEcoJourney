<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eco Progress Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background-color: #e8dfcf;
            font-family: 'Arial', sans-serif;
            margin: 0;
            background-repeat: no-repeat;
            background-size: cover; 
            background-position: center;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 20px;
        }

        h1 {
            text-align: center;
            color: #0b2535;
            margin-bottom: 25px;
            font-size: 2.4rem;
        }

        .top-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: 0.25s ease;
        }

        /* 🌟 CLICKABLE XP CARD */
        .xp-card {
            cursor: pointer;
        }

        .xp-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(107, 191, 89, 0.35);
        }

        .card h2 {
            font-size: 1.4rem;
            color: #0b2535;
            margin-bottom: 8px;
        }

        .xp-bar {
            width: 100%;
            height: 12px;
            background: #dcdcdc;
            border-radius: 10px;
            margin: 15px 0;
        }

        .xp-fill {
            height: 100%;
            background: #6bbf59;
            border-radius: 10px;
            transition: width 0.4s ease;
        }

        .check-btn {
            width: 100%;
            background: #6bbf59;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            cursor: pointer;
            font-weight: 600;
        }

        .check-btn:hover {
            background-color: #4fa34b;
        }

        .disabled-btn {
            width: 100%;
            background: #b3b3b3;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: not-allowed;
            opacity: 0.8;
        }

        .action-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-top: 20px;
        }

        .action-card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            font-weight: 600;
            color: #0b2535;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            cursor: pointer;
            border: 1px solid #d9e6da;
            transition: 0.2s ease;
        }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

        .missions {
            background: white;
            padding: 25px;
            border-radius: 18px;
            margin-top: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .mission-item {
            font-size: 1.1rem;
            padding: 15px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
        }

        .mission-item:last-child {
            border-bottom: none;
        }

        .status-badge {
            font-weight: bold;
            font-size: 0.9rem;
            padding: 5px 12px;
            border-radius: 20px;
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="container">

        <h1><%= user.userName %>'s Sustainability Journey 🌿</h1>

        <p style="text-align:center; color:#4fa34b; margin-top:10px;">
            Keep growing your green habits! 🌱
        </p>

        <div style="background:white; padding:25px; border-radius:18px; margin:30px auto; width:85%; display:flex; align-items:center; gap:20px; box-shadow:0 4px 15px rgba(0,0,0,0.1);">

            <img src="<%= user.profilePhoto %>" 
                 style="width:110px; height:110px; border-radius:50%; border:4px solid #e6f7e6; object-fit: cover;">

            <div>
                <h2 style="margin:0; font-size:1.8rem; color:#0b2535;">
                    <%= user.userName %>
                </h2>

                <div style="margin-top:10px; background:#e8f6e8; padding:8px 12px; border-radius:10px; display:inline-flex; align-items:center; gap:8px; font-weight:600;">
                    <img src="/uploads/levelbadge/<%= progress.levelBadge %>" style="width:30px;">
                    <span>Level <%= progress.level %> – <%= progress.levelTitle %></span>
                </div>
            </div>
        </div>

        <div class="top-grid">

            <!-- 🌟 CLICKABLE XP CARD -->
            <a href="/xphistory" style="text-decoration:none; color:inherit;">
                <div class="card xp-card">
                    <h2>Level <%= progress.level %></h2>

                    <div class="xp-bar"
                         title="<%= xpNeeded - progress.xp %> XP until Level <%= progress.level + 1 %>! Keep going! 🌿">
                        <div class="xp-fill" style="width:<%= xpPercent %>%"></div>
                    </div>

                    <p><strong><%= progress.xp %> / <%= xpNeeded %> XP</strong></p>

                    <p style="font-size:0.85rem; color:#6bbf59; margin-top:8px;">
                        👉 View XP History
                    </p>
                </div>
            </a>

            <!-- STREAK CARD -->
            <div class="card">
                <h2>🔥 Streak: <%= progress.streak %> days</h2>
                <p>Last Check-In: <%= progress.lastCheckinDate ? progress.lastCheckinDate : "—" %></p>

                <%
                    let last = progress.lastCheckinDate
                        ? new Date(progress.lastCheckinDate).toISOString().slice(0, 10)
                        : null;
                    let today = new Date().toISOString().slice(0, 10);
                %>

                <% if (last === today) { %>
                    <button class="disabled-btn" disabled>✔ Already checked in today</button>
                <% } else { %>
                    <form action="/do-checkin" method="POST">
                        <button class="check-btn">Check In Today</button>
                    </form>
                <% } %>
            </div>

        </div>

        <div class="action-grid">
            <a href="/quiz" style="text-decoration:none;">
                <div class="action-card">📘 Take a Quiz</div>
            </a>

            <a href="/categories" style="text-decoration:none;">
                <div class="action-card">🌱 Explore Content</div>
            </a>
        </div>

        <div class="missions">
            <h2 style="margin-bottom: 5px;">📋 Your Random Missions</h2>
            <p style="font-size: 0.85rem; color: #666; margin-bottom: 20px;">
                These change every week! Complete them for bonus XP.
            </p>

            <% if (missions && missions.length > 0) { %>
                <% missions.forEach(m => { %>
                    <div class="mission-item">
                        <span>
                            <%= m.missionType.includes('Quiz') ? '📝' : '🌿' %> 
                            <%= m.missionType %>
                        </span>

                        <% if (m.xpEarned > 0) { %>
                            <span class="status-badge" style="background:#e8f6e8; color:#28a745;">
                                ✅ Completed
                            </span>
                        <% } else { %>
                            <span class="status-badge" style="background:#f0f0f0; color:#888;">
                                ⚪ In Progress
                            </span>
                        <% } %>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; color: #888;">
                    No missions assigned yet. Try refreshing!
                </p>
            <% } %>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);

            if (urlParams.get("already") === "true") {
                Swal.fire({
                    icon: 'info',
                    title: 'Already Checked In!',
                    text: 'You can only check in once per day. Come back tomorrow! 🌿',
                    confirmButtonColor: '#6bbf59'
                });
            }

            <% if (streakMissed) { %>
                Swal.fire({
                    title: "Awww… You lost your streak 😢",
                    text: "Start fresh today and come back tomorrow to rebuild it! 🌱",
                    icon: "warning",
                    confirmButtonColor: "#28a745"
                });
            <% } %>

            <% if (leveledUp) { %>
                Swal.fire({
                    title: 'LEVEL UP! 🎉',
                    html: 'Congratulations <b><%= user.userName %></b>!<br>You have reached <b>Level <%= progress.level %></b>: <br>✨ <i><%= progress.levelTitle %></i> ✨',
                    icon: 'success',
                    confirmButtonText: 'Keep going!',
                    confirmButtonColor: '#6bbf59',
                    backdrop: `rgba(0,123,0,0.2) url("/uploads/confetti.gif") center/cover`
                });
            <% } %>

            window.history.replaceState({}, document.title, window.location.pathname);
        });
    </script>

</body>
</html>