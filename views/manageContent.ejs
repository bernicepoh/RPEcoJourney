<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Contents</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/stylesheet.css">
 
    <style>
        body {
            font-family: 'Georgia', serif;
            font-size: larger;
            margin: 0;
            padding: 0;
            background-image: url("/images/background.png");
            background-repeat: no-repeat;
            background-size: cover; 
            background-position: center;
        }
 
        .content-card {
            border: 1px solid #ccc;
            padding: 16px;
            margin: 10px;
            border-radius: 8px;
            box-shadow: 2px 2px 12px rgba(0, 0, 0, 0.1);
            background-color: white;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
 
        .content-card img {
            width: 100%;
            max-height: 180px;
            object-fit: contain;
            margin-bottom: 16px;
            border-radius: 4px;
        }
 
        .content-card h4 {
            margin: 8px 0;
            font-size: 1.2rem;
            text-align: center;
        }
 
        .content-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 16px;
        }
 
        .container {
            text-align: center;
        }
 
        .navbar {
            background-color: #733E24 !important;
        }
 
        .navbar .nav-link {
            color: white;
        }
 
        .navbar .nav-link:hover {
            color: #f0f0f0 !important;
        }
 
        .button-group {
            display: flex;
            width: 100%;
            gap: 10px;
        }
 
        .button-group a {
            flex: 1;
            padding: 10px;
            text-align: center;
            border-radius: 5px;
            color: white;
            text-decoration: none;
        }
 
        .btn-edit, .btn-delete, .btn-back {
            background-color: #733E24;
        }
 
        .btn-back {
            margin-top: 10%;
            color: white;
        }

        .file-box {
            width: 250px;              /* all previews share SAME width */
            height: 160px;             /* adjust height if needed */
            display: flex;
            align-items: center;       /* center vertically */
            justify-content: center;   /* center horizontally */
            margin-right: 25px;
        }

        /* Image / video auto-fit inside the box */
        .file-box img,
        .file-box video {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 12px;
        }
    </style>
 
</head>
<body>
    <%- include ('partials/navbar.ejs') %>
 
    <div class="container mt-4">
        <h1 class="text-center">Content Management</h1>
 
        <div class="content-container" id="contentContainer">
            <% if (content && content.length > 0) { %>
                <% content.forEach(content => { %>
                    <div class="card content-card">
                        <div class="file-box">
                            <% const ext = content.contentFile.split('.').pop().toLowerCase(); %>
                            <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
                            <img src="/uploads/<%= content.contentFile %>">
                            <% } else if (ext === 'pdf') { %>
                            <a href="/uploads/<%= content.contentFile %>" target="_blank">
                                <img class="file-icon" src="/images/pdf.png" style="width: 150px;">
                            </a>
                            <% } else if (['doc','docx'].includes(ext)) { %>
                            <a href="/uploads/<%= content.contentFile %>" target="_blank">
                                <img class="file-icon" src="/images/word.png" style="width: 150px;">
                            </a>
                            <% } else if (['ppt','pptx'].includes(ext)) { %>
                            <a href="/uploads/<%= content.contentFile %>" target="_blank">
                                <img class="file-icon" src="/images/ppt.png" style="width: 150px;">
                            </a>
                            <% } else if (['mp4','mov','avi'].includes(ext)) { %>
                            <video autoplay loop muted playsinline>
                                <source src="/uploads/<%= content.contentFile %>">
                            </video>
                            <% } else { %>
                            <a href="/uploads/<%= content.contentFile %>" target="_blank">
                                <img class="file-icon" src="/images/file.png" style="width: 150px;">
                            </a>
                            <% } %>
                        </div>
                        <h4><%= content.contentTitle %></h4>
                        <div class="button-group">
                            <a href="/editContent/<%= content.contentID %>" class="btn btn-edit">Edit</a>
                            <form action="/deleteContent/<%= content.contentID %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this content?');" title="Delete" aria-label="Delete">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No content available.</p>
            <% } %>
        </div>
 
        <div>
            <a href="/" class="btn btn-back">Back</a>
        </div>
 
    </div>
</body>
</html>