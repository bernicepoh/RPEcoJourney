<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Contents</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background-color: #e8dfcf;
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }

        .add-content-btn {
            display: inline-block;
            padding: 12px 24px;
            background-color: #6bbf59;  
            color: white;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            transition: 0.25s ease;
            font-size: 1rem;
        }
        .add-content-btn:hover {
            background-color: green;
            transform: translateY(-2px);
        }

      
        .content-card {
            height: 380px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-radius: 12px;
            overflow: hidden;
            padding: 15px;
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

       
        .file-box {
            width: 100%;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .file-box img,
        .file-box video {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 10px;
        }

       
        .content-title {
            font-size: 1.1rem;
            font-weight: bold;
            text-align: center;
        }

        .content-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 15px;
            padding-top: 0;
        }

        
        .edit-btn {
            font-size: 0.8rem !important;
            font-weight: 500 !important;
            padding: 4px 10px !important;
            background-color: #f4a261;
            color: #1a4d2e !important; 
            border-radius: 6px;
            display: inline-block;
            width: auto !important;
        }

       
        .delete-btn {
            background-color: #e63946;
            color: white;
            font-size: 0.85em;
            padding: 5px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: 0.25s ease;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .delete-btn:hover {
            background-color: #cc2f3c;
        }

    </style>
</head>

<body>
    <%- include('partials/navbar.ejs') %>

    <div class="container mt-4">
        <h2 class="mb-4 text-center fw-bold">Manage Contents</h2>

        <div class="text-center mb-3">
            <a href="/addContent" class="add-content-btn">+ Add New Content</a>
        </div>

        <div class="row">
            <% if (content && content.length > 0) { %>
                <% content.forEach(c => { %>

                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm content-card">

                        <div class="file-box">
                            <% const ext = c.contentFile?.split('.').pop().toLowerCase(); %>

                            <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
                                <img src="<%= c.contentFile %>">
                            <% } else if (ext === 'pdf') { %>
                                <a href="<%= c.contentFile %>" target="_blank">
                                    <img src="<%= c.contentFile %>" style="width:150px;">
                                </a>
                            <% } else if (['doc','docx'].includes(ext)) { %>
                                <a href="<%= c.contentFile %>" target="_blank">
                                    <img src="<%= c.contentFile %>" style="width:150px;">
                                </a>
                            <% } else if (['ppt','pptx'].includes(ext)) { %>
                                <a href="<%= c.contentFile %>" target="_blank">
                                    <img src="<%= c.contentFile %>" style="width:150px;">
                                </a>
                            <% } else if (['mp4','mov','avi'].includes(ext)) { %>
                                <video autoplay loop muted playsinline>
                                    <source src="<%= c.contentFile %>">
                                </video>
                            <% } else { %>
                                <a href="<%= c.contentFile %>" target="_blank">
                                    <img src="<%= c.contentFile %>" style="width:150px;">
                                </a>
                            <% } %>
                        </div>

                        <h5 class="content-title"><%= c.contentTitle %></h5>

                        <div class="content-actions">
                            <a href="/editContent/<%= c.contentID %>" class="btn btn-primary btn-sm">✏ Edit</a>

                            <form id="deleteForm-<%= c.contentID %>" 
                                  action="/deleteContent/<%= c.contentID %>" 
                                  method="POST">
                                <button type="button" 
                                        class="delete-btn" 
                                        onclick="confirmDelete('<%= c.contentID %>')">
                                    🗑 Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>

                <% }) %>
            <% } else { %>
                <p>No content available.</p>
            <% } %>
        </div>

    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    
    <script>
        const successMsg = "<%= flashSuccess ? flashSuccess : '' %>";
        const errorMsg   = "<%= flashError ? flashError : '' %>";

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: successMsg.toLowerCase().includes('updated')
                    ? 'Updated Successfully!'
                    : successMsg.toLowerCase().includes('added')
                    ? 'Content Added!'
                    : 'Success!',
                text: successMsg,
                showConfirmButton: false,
                timer: 2000
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMsg,
                confirmButtonText: 'OK'
            });
        }
    </script>

    
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: "Delete content?",
                text: "This action cannot be undone.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#e63946",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete it"
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteForm-${id}`).submit();
                }
            });
        }
    </script>

</body>
</html>
