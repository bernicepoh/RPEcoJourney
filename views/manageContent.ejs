<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Contents</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background-color: #e8dfcf;
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }

        .add-content-btn {
            display: inline-block;
            padding: 12px 24px;
            background-color: #6bbf59;  
            color: white;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            transition: 0.25s ease;
            font-size: 1rem;
        }
        .add-content-btn:hover {
            background-color: green;
            transform: translateY(-2px);
        }

      
        .content-card {
            height: 380px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-radius: 12px;
            overflow: hidden;
            padding: 15px;
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

       
        .file-box {
            width: 100%;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .file-box img,
        .file-box video {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 10px;
        }

       
        .content-title {
            font-size: 1.1rem;
            font-weight: bold;
            text-align: center;
        }

        .content-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 15px;
            padding-top: 0;
        }

        
        .edit-btn {
            font-size: 0.8rem !important;
            font-weight: 500 !important;
            padding: 4px 10px !important;
            background-color: #f4a261;
            color: #1a4d2e !important; 
            border-radius: 6px;
            display: inline-block;
            width: auto !important;
        }

       
        .delete-btn {
            background-color: #e63946;
            color: white;
            font-size: 0.85em;
            padding: 5px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: 0.25s ease;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .delete-btn:hover {
            background-color: #cc2f3c;
        }

    </style>
</head>

<body>
    <%- include('partials/navbar.ejs') %>

    <div class="container mt-4">
        <h2 class="mb-4 text-center fw-bold">Manage Contents</h2>

        <% if (user && user.userType === 'Writer') { %>
        <div class="text-center mb-3">
            <a href="/addContent" class="add-content-btn">+ Add New Content</a>
        </div>
        <% } %>

        <% if (user && (user.userType === 'Admin' || user.userType === 'Manager')) { %>
        <div class="alert alert-info text-center" role="alert">
            <strong>ℹ️ Note:</strong> As a <%= user.userType %>, you can view and approve/reject content, but only Writers can publish new content.
        </div>
        <% } %>

        <div class="row">
            <% if (content && content.length > 0) { %>
                <% content.forEach(c => { %>

                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm content-card">

                        <div class="file-box" style="position: relative; background:#f5f5f5; border-radius:10px;">
                            <% const ext = c.contentFile?.split('.').pop().toLowerCase(); %>

                            <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
                                <!-- Image preview -->
                                <img src="<%= c.contentFile %>?w=250&h=180&c=fill" alt="<%= c.contentTitle %>" style="width:100%; height:100%; object-fit:contain;">
                            
                            <% } else if (['mp4','mov','avi'].includes(ext)) { %>
                                <!-- Video preview with play button -->
                                <video style="width:100%; height:100%; object-fit:cover;" muted>
                                    <source src="<%= c.contentFile %>">
                                </video>
                                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:35px;background:rgba(0,0,0,0.5);border-radius:50%;width:60px;height:60px;display:flex;align-items:center;justify-content:center;">▶️</div>
                            
                            <% } else if (ext === 'pdf') { %>
                                <!-- PDF preview: show document icon -->
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#d32f2f;">
                                  <img src="https://res.cloudinary.com/dmyv7fbha/image/upload/v1770013716/pdf_bnonfy.png" alt="PDF" style="width:80px; height:80px; object-fit:contain;">
                                </div>
                                <div style="position:absolute;top:8px;right:8px;background:rgba(211,47,47,0.9);color:white;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:bold;">PDF</div>
                            
                            <% } else if (['doc','docx'].includes(ext)) { %>
                                <!-- Word document preview -->
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#1976d2;">
                                  <img src="https://res.cloudinary.com/dmyv7fbha/image/upload/v1770013716/word_kwqxym.png" alt="Word Document" style="width:80px; height:80px; object-fit:contain;">
                                </div>
                                <div style="position:absolute;top:8px;right:8px;background:rgba(25,118,210,0.9);color:white;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:bold;">DOC</div>
                            
                            <% } else if (['ppt','pptx'].includes(ext)) { %>
                                <!-- PowerPoint preview -->
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#d84315;">
                                  <img src="https://res.cloudinary.com/dmyv7fbha/image/upload/v1770013716/ppt_s5awbi.png" alt="PowerPoint Document" style="width:80px; height:80px; object-fit:contain;">
                                </div>
                                <div style="position:absolute;top:8px;right:8px;background:rgba(216,67,21,0.9);color:white;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:bold;">PPT</div>
                            
                            <% } else { %>
                                <!-- Fallback generic file -->
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#757575;">
                                  <div style="font-size:50px;">📃</div>
                                  <div style="margin-top:8px; font-weight:bold; color:#666; font-size:12px;"><%= ext?.toUpperCase() || 'FILE' %></div>
                                </div>
                            <% } %>
                        </div>

                        <h5 class="content-title"><%= c.contentTitle %></h5>

                        <div class="content-actions">
                            <a href="/editContent/<%= c.contentID %>" class="btn btn-primary btn-sm">✏ Edit</a>

                            <form id="deleteForm-<%= c.contentID %>" 
                                  action="/deleteContent/<%= c.contentID %>" 
                                  method="POST">
                                <button type="button" 
                                        class="delete-btn" 
                                        onclick="confirmDelete('<%= c.contentID %>')">
                                    🗑 Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>

                <% }) %>
            <% } else { %>
                <p>No content available.</p>
            <% } %>
        </div>

    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    
    <script>
        const successMsg = "<%= flashSuccess ? flashSuccess : '' %>";
        const errorMsg   = "<%= flashError ? flashError : '' %>";

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: successMsg.toLowerCase().includes('updated')
                    ? 'Updated Successfully!'
                    : successMsg.toLowerCase().includes('added')
                    ? 'Content Added!'
                    : 'Success!',
                text: successMsg,
                showConfirmButton: false,
                timer: 2000
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMsg,
                confirmButtonText: 'OK'
            });
        }
    </script>

    
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: "Delete content?",
                text: "This action cannot be undone.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#e63946",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete it"
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteForm-${id}`).submit();
                }
            });
        }
    </script>

</body>
</html>
