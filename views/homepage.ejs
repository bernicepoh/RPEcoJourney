<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney | Home</title>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      
      background-image: url("/uploads/background.png");
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    .hero {
      text-align: center;
      margin-top: 120px;
      padding: 40px;
    }

    .hero h1 {
      font-size: 3.5rem;
      color: #0b2535;
      font-weight: 800;
      margin-bottom: 15px;
      text-shadow: 1px 1px 4px rgba(255, 255, 255, 0.6);
    }

    .hero p {
      font-size: 1.3rem;
      color: #2e8b57;
      font-weight: 500;
      margin-bottom: 35px;
    }

    .btn {
      background-color: #6bbf59;
      color: white;
      padding: 14px 36px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 5px 12px rgba(0, 0, 0, 0.25);
    }

    .btn:hover {
      background-color: #4fa13d;
      transform: scale(1.05);
    }

    .features {
      display: flex;
      justify-content: center;
      align-items: stretch;
      flex-wrap: wrap;
      gap: 30px;
      margin: 80px auto;
      max-width: 1100px;
      padding: 0 40px;
    }

    .feature-card {
      width: 320px;               
      max-width: 320px;           
      background: rgba(255, 255, 255, 0.8);
      border-radius: 20px;
      padding: 35px 25px;
      text-align: center;
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease;
    }


    .feature-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }

    .feature-card img {
      width: 70px;
      margin-bottom: 20px;
    }

    .feature-card h3 {
      color: #0b2535;
      font-size: 1.4rem;
      margin-bottom: 10px;
    }

    .feature-card p {
      font-size: 1rem;
      color: #333;
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2.5rem; }
      .hero p { font-size: 1rem; }
    }
  </style>
</head>

<% if (loginSuccess && loginSuccess.length > 0) { %>
<script>
Swal.fire({
  icon: 'success',
  title: 'Welcome!',
  text: '<%= loginSuccess %>',
  timer: 1800,
  showConfirmButton: false
});
</script>
<% } %>

<body>
  <%- include('partials/navbar') %>

  <section class="hero">
    <h1>Welcome to RPEcoJourney 🌿</h1>
    <p>Empowering green living through awareness and fun quizzes.</p>
    <a href="/categories" class="btn">Get Started</a>
  </section>

  <section class="features">
    <div class="feature-card">
      <img src="/uploads/leaderboard.png" alt="leaderboard">
      <h3><a href="/leaderboard" style="color:inherit; text-decoration:none;">🌍 Join the Journey</a></h3>
      <p>Compete on the leaderboard and be part of a community driving positive change for our planet.</p>
    </div>

    <div class="feature-card">
      <img src="/uploads/quiz.png" alt="Take Quizzes">
      <h3><a href="/quiz" style="color:inherit; text-decoration:none;">🎯 Challenge Yourself</a></h3>
      <p>Test your knowledge in fun, interactive quizzes designed to inspire greener living habits.</p>
    </div>

    <div class="feature-card">
      <img src="/uploads/dashboard.png" alt="Dashboard">
      <h3><a href="/checkin-board" style="color:inherit; text-decoration:none;">🧭 Your Sustainability Dashboard</a></h3>
      <p>Track your personal growth in sustainability</p>
    </div>
  </section>

  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <% if (loginSuccess && loginSuccess.length > 0) { %>
  <script>
  Swal.fire({
    icon: 'success',
    title: 'Welcome!',
    text: '<%= loginSuccess %>',
    timer: 1800,
    showConfirmButton: false
  });
  </script>
  <% } %>

</body>
</html>

