<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register</title>

  <style>
    body {
      font-family: 'Georgia', serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
    }

    /* LEFT SIDE (same as login) */
    .left-panel {
      width: 50%;
      background: url("/uploads/login.png") no-repeat center center;
      background-size: cover;
      position: relative;
      padding-left: 80px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* DARK OVERLAY */
    .left-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 40, 0, 0.45);
      backdrop-filter: blur(1px);
    }

    .left-panel * {
      position: relative;
      color: white;
    }

    .left-panel h1 {
      font-size: 60px;
      font-weight: 700;
      margin-bottom: 30px;
    }

    .left-panel p {
      font-size: 22px;
      width: 75%;
      line-height: 1.5;
      margin-bottom: 15px;
    }

    /* RIGHT SIDE */
    .right-panel {
      width: 50%;
      background: #e8dfcf;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px;
    }

    .register-box {
      width: 80%;
      max-width: 450px;
      animation: fadeIn 0.6s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    h1 {
      text-align: center;
      font-size: 34px;
      font-weight: 800;
      margin-bottom: 25px;
      color: #2a2a2a;
    }

    .message {
      margin-bottom: 15px;
      padding: 12px;
      border-radius: 8px;
      font-size: 15px;
    }

    .message.error {
      background-color: #f8d7da;
      color: #721c24;
    }

    .message.success {
      background-color: #d4edda;
      color: #155724;
    }

    .field-wrapper {
      margin-bottom: 18px;
    }

    .field-wrapper.error {
      border: 2px solid rgba(255, 0, 0, 0.2);
      padding: 10px;
      border-radius: 10px;
      background: #fff6f6;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: bold;
      font-size: 15px;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccc;
      border-radius: 25px;
      font-size: 15px;
      transition: border-color 0.2s;
    }

    input:focus {
      border-color: #1b5e20;
      outline: none;
    }

    input.error {
      border-color: red !important;
    }

    button {
      width: 100%;
      padding: 14px;
      background-color: #1b5e20;
      border: none;
      color: #fff;
      border-radius: 25px;
      font-size: 18px;
      cursor: pointer;
      font-weight: 600;
      margin-top: 10px;
    }

    button:hover {
      background-color: #134818;
    }

    .login-link {
      text-align: center;
      margin-top: 15px;
      font-size: 15px;
    }

    .login-link a {
      text-decoration: underline;
      color: #004d00;
    }

    footer {
      text-align: center;
      padding: 18px;
      font-size: 1em;
      color: #555;
      position: absolute;
      bottom: 0;
      width: 100%;
    }

    .confirm-status {
      margin-left: 5px;
      font-size: 18px;
    }

  </style>
</head>

<body>

  <!-- LEFT PANEL -->
  <div class="left-panel">
    <h1>Join RPEcoJourney</h1>
    <p>Start your sustainability adventure with XP, badges & missions</p>
    <p>Create an account to begin your EcoJourney 🌱</p>
  </div>

  <!-- RIGHT PANEL -->
  <div class="right-panel">
    <div class="register-box">

      <h1>Create Account</h1>

      <!-- Display errors -->
      <% if (errors && errors.length > 0) { %>
        <% errors.forEach(err => { %>
          <div class="message error"><%= err %></div>
        <% }) %>
      <% } %>

      <!-- Display success messages -->
      <% if (messages && messages.length > 0) { %>
        <% messages.forEach(msg => { %>
          <div class="message success"><%= msg %></div>
        <% }) %>
      <% } %>

      <!-- ERROR PROCESSING (kept exactly as your original logic) -->
      <%
      const fieldErrors = {};
      if (errors) {
        errors.forEach(err => {
          if (err.includes('Gmail')) fieldErrors.email = err;
          else if (err.includes('Password must')) fieldErrors.password = err;
          else if (err.includes('Passwords do not match')) fieldErrors.confirmPassword = err;
          else if (err.includes('8-digit')) fieldErrors.contactNo = err;
          else if (err.includes('All fields')) fieldErrors.all = err;
          else if (err.includes('Email is already in use')) fieldErrors.email = 'EMAIL TAKEN';
          else if (err.includes('Contact number is already in use')) fieldErrors.contactNo = 'CONTACT TAKEN';
          else if (err.toLowerCase().includes('username')) fieldErrors.userName = err;
        });
      }
      %>

      <!-- REGISTRATION FORM -->
      <form action="/register" method="POST">

        <div class="field-wrapper <%= (fieldErrors.all || fieldErrors.userName) ? 'error' : '' %>">
          <label for="userName">Username:</label>
          <input type="text" id="userName" name="userName"
            value="<%= formData?.userName || '' %>"
            placeholder="<%= fieldErrors.userName || 'Enter username' %>"
            class="<%= (fieldErrors.all || fieldErrors.userName) ? 'error' : '' %>" required>
        </div>

        <div class="field-wrapper <%= fieldErrors.email ? 'error' : '' %>">
          <label for="email">Email:</label>
          <input type="email" id="email" name="email"
            value="<%= formData?.email || '' %>"
            placeholder="<%= fieldErrors.email || 'Enter your email' %>"
            class="<%= fieldErrors.email ? 'error' : '' %>" required>
        </div>

        <div class="field-wrapper <%= fieldErrors.password ? 'error' : '' %>">
          <label for="password">Password:</label>
          <input type="password" id="password" name="password"
            placeholder="<%= fieldErrors.password || 'Enter password' %>"
            class="<%= fieldErrors.password ? 'error' : '' %>" required>
        </div>

        <div class="field-wrapper <%= fieldErrors.confirmPassword ? 'error' : '' %>">
          <label for="confirmPassword">Confirm Password:
            <span id="confirmIcon" class="confirm-status"></span>
          </label>
          <input type="password" id="confirmPassword" name="confirmPassword"
            placeholder="<%= fieldErrors.confirmPassword || 'Confirm password' %>"
            class="<%= fieldErrors.confirmPassword ? 'error' : '' %>" required>
        </div>

        <div class="field-wrapper <%= fieldErrors.contactNo ? 'error' : '' %>">
          <label for="contactNo">Contact Number:</label>
          <input type="text" id="contactNo" name="contactNo"
            value="<%= formData?.contactNo || '' %>"
            placeholder="<%= fieldErrors.contactNo || 'Enter contact number' %>"
            class="<%= fieldErrors.contactNo ? 'error' : '' %>">
        </div>

        <button type="submit">Register</button>
      </form>

      <div class="login-link">
        <p>Already have an account? <a href="/">Login here</a></p>
      </div>

    </div>
  </div>

  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>

  <!-- YOUR ORIGINAL JS KEPT EXACTLY SAME -->
  <script>
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');
    const label = document.querySelector('label[for="confirmPassword"]');
    label.innerHTML = 'Confirm Password: <span id="confirmIcon" class="confirm-status"></span>';
    const confirmIcon = document.getElementById('confirmIcon');

    function checkMatch() {
      if (confirmPassword.value === '') {
        confirmIcon.innerHTML = '';
      } else if (confirmPassword.value === password.value) {
        confirmIcon.innerHTML = '✓';
        confirmIcon.style.color = 'green';
      } else {
        confirmIcon.innerHTML = '✗';
        confirmIcon.style.color = 'red';
      }
    }

    confirmPassword.addEventListener('input', checkMatch);
    password.addEventListener('input', checkMatch);

    document.querySelectorAll('.field-wrapper input').forEach(input => {
      input.addEventListener('input', (e) => {
        const wrapper = e.target.closest('.field-wrapper');
        if (wrapper && wrapper.classList.contains('error')) {
          wrapper.classList.remove('error');
          e.target.classList.remove('error');
        }}
      );
    });
  </script>

</body>
</html>


