<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <title>RPEcoJourney - Update content</title>

        <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-image: url("/uploads/background.png");
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
      min-height: 100vh;
    }

    h2 {
      font-size: 2.8rem;
      color: #0b2535;
      margin-bottom: 60px;
    }

    /* Form container layout */
    .form-container {
      display: grid;
      grid-template-columns: 180px auto;
      gap: 25px 40px; /* <-- Increased spacing between label and input */
      align-items: center;
      justify-content: center;
      max-width: 750px;
      margin: 0 auto;
    }

    label {
      text-align: right;
      font-weight: 500;
    }

    .custom-input,
    .custom-textarea {
      background: #86a3ae;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 100%;
    }

    button {
      background-color: #b6cca1;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 180px;
    }

    button:hover {
      background-color: #8dcc6b;
      color: #222;
    }

    input[type="file"]::file-selector-button {
      background-color: #86a3ae;
      border: none;
      border-radius: 7px;
      padding: 6px 20px;
      font-style: italic;
      cursor: pointer;
    }

    input[type="file"]::file-selector-button:hover {
      background-color: #134b61;
      color: #fff;
    }

    .submit-container {
      grid-column: span 2;
      text-align: center;
      margin-top: 50px;
    }

    .file-box {
  width: 350px;              /* all previews share SAME width */
  height: 260px;             /* adjust height if needed */
  display: flex;
  align-items: center;       /* center vertically */
  justify-content: center;   /* center horizontally */
  margin: 40px auto 16px auto; /* centers horizontally with bottom space */
}
 
.file-box img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: 12px;
}
 
.file-box video {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }

  </style>
    </head>
<body>
    <%- include ('partials/navbar.ejs') %>

    <div class="container text-center mt-4">
        <br>
        <h2>Update Content</h2>
        <div class="text-center">
            <form action="/editContent/<%=content.contentID%>" method="POST" enctype="multipart/form-data" class="form-container">
            <label for="contentTitle">Content Title:</label>
            <input type="text" id="contentTitle" name="contentTitle" value="<%=content.contentTitle%>" required class="custom-input">

            <label for="contentDescription">Content Description:</label>
            <textarea id="contentDescription" name="contentDescription" required class="custom-textarea" oninput="autoExpand(this)"><%=content.contentDescription%></textarea>

            <label for="categoryID">Category:</label>
            <select name="contentTypeID" id="contentTypeID" required class="custom-input">
              <option value="">Select category</option> <!-- Empty value ensures it's invalid -->
              <option value="1">Environmental</option>
              <option value="2">Social</option>
              <option value="3">Governance</option>
            </select>
            
                <label for="file">Current File:</label>
                <input type="hidden" name="currentFile" value = "<%= content.contentFile %>" >
                <div class="file-box">
                  <% const ext = content.contentFile.split('.').pop().toLowerCase(); %>
                  <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
                  <img src="/uploads/<%= content.contentFile %>">
                  <% } else if (ext === 'pdf') { %>
                  <a href="/uploads/<%= content.contentFile %>" target="_blank">
                      <img class="file-icon" src="/uploads/pdf.png" style="width: 150px;">
                  </a>
                  <% } else if (['doc','docx'].includes(ext)) { %>
                  <a href="/uploads/<%= content.contentFile %>" target="_blank">
                      <img class="file-icon" src="/uploads/word.png" style="width: 150px;">
                  </a>
                  <% } else if (['ppt','pptx'].includes(ext)) { %>
                  <a href="/uploads/<%= content.contentFile %>" target="_blank">
                      <img class="file-icon" src="/uploads/ppt.png" style="width: 150px;">
                  </a>
                  <% } else if (['mp4','mov','avi'].includes(ext)) { %>
                  <video autoplay loop muted playsinline>
                      <source src="/uploads/<%= content.contentFile %>">
                  </video>
                  <% } else { %>
                  <a href="/uploads/<%= content.contentFile %>" target="_blank">
                      <img class="file-icon" src="/uploads/file.png" style="width: 150px;">
                  </a>
                  <% } %>
                </div>
                
                <label for="contentFile">New File:</label>
                <input type="file" id="contentFile" name="contentFile">

                <div class="submit-container">
                    <button type="submit">Update Content</button> <br><br>
                </div>
            </form>
        </div>
    </div>

    <script>
        function autoExpand(textarea) {
        textarea.style.height = "auto";
        textarea.style.height = textarea.scrollHeight + "px";
        }

        window.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('textarea').forEach(autoExpand);
        });
    </script>

    <footer>
        &copy; 2025 RPEcoJourney. All Rights Reserved.
    </footer>
</body>
</html>