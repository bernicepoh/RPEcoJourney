<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <title>RPEcoJourney - Update content</title>

        <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-image: url("/images/contentBackground.png") !important;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: bottom center;
      min-height: 100vh;
    }

    h2 {
      font-size: 2.8rem;
      color: #0b2535;
      margin-bottom: 60px;
    }

    /* Form container layout */
    .form-container {
      display: grid;
      grid-template-columns: 180px auto;
      gap: 25px 40px; /* <-- Increased spacing between label and input */
      align-items: center;
      justify-content: center;
      max-width: 750px;
      margin: 0 auto;
    }

    label {
      text-align: right;
      font-weight: 500;
    }

    .custom-input,
    .custom-textarea {
      background: #86a3ae;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 100%;
    }

    button {
      background-color: #b6cca1;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 180px;
    }

    button:hover {
      background-color: #8dcc6b;
      color: #222;
    }

    input[type="file"]::file-selector-button {
      background-color: #86a3ae;
      border: none;
      border-radius: 7px;
      padding: 6px 20px;
      font-style: italic;
      cursor: pointer;
    }

    input[type="file"]::file-selector-button:hover {
      background-color: #134b61;
      color: #fff;
    }

    .submit-container {
      grid-column: span 2;
      text-align: center;
      margin-top: 50px;
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }

  </style>
    </head>
<body>
    <%- include ('partials/navbar.ejs') %>

    <div class="container text-center mt-4">
        <br>
        <h2>Update Content</h2>
        <div class="text-center">
            <form action="/editContent/<%=content.contentID%>" method="POST" enctype="multipart/form-data" class="form-container">
            <label for="contentTitle">Content Title:</label>
            <input type="text" id="contentTitle" name="contentTitle" value="<%=content.contentTitle%>" required class="custom-input">

            <label for="contentDescription">Content Description:</label>
            <textarea id="contentDescription" name="contentDescription" required class="custom-textarea" oninput="autoExpand(this)"><%=content.contentDescription%></textarea>

            <label for="categoryID">Category:</label>
            <select name="categoryID" id="categoryID" required class="custom-input">
                    <option value="-">Select Category</option>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.categoryID %>" <%= category.categoryID == content.categoryID ? 'selected' : '' %>><%= category.categoryName %></option>
                    <% }) %>    
            </select>

                <label for="file">Current File:</label>
                <input type="hidden" name="currentFile" value = <%= content.contentFile %> >
                <img src = "/images/<%= content.contentFile %>" width="20%">
                
                <label for="contentFile">New File:</label>
                <input type="file" id="contentFile" name="contentFile">

                <div class="submit-container">
                    <button type="submit">Update Content</button> <br><br>
                </div>
            </form>
        </div>
    </div>

    <script>
        function autoExpand(textarea) {
        textarea.style.height = "auto";
        textarea.style.height = textarea.scrollHeight + "px";
        }

        window.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('textarea').forEach(autoExpand);
        });
    </script>

    <footer>
        &copy; 2025 RPEcoJourney. All Rights Reserved.
    </footer>
</body>
</html>