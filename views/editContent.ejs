<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.js" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/translations.js"></script>
        <title>RPEcoJourney - Update content</title>

        <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-color: #e8dfcf;
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
      min-height: 100vh;
    }

    h2 {
      font-size: 2.8rem;
      color: #0b2535;
      margin-bottom: 60px;
    }

    
    .form-container {
      display: grid;
      grid-template-columns: 180px auto;
      gap: 25px 40px; 
      align-items: center;
      justify-content: center;
      max-width: 750px;
      margin: 0 auto;
    }

    label {
      text-align: right;
      font-weight: 500;
    }

    .custom-input,
    .custom-textarea {
      background: #86a3ae;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 100%;
    }

    button {
      background-color: #b6cca1;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 180px;
    }

    button:hover {
      background-color: #8dcc6b;
      color: #222;
    }

    input[type="file"]::file-selector-button {
      background-color: #86a3ae;
      border: none;
      border-radius: 7px;
      padding: 6px 20px;
      font-style: italic;
      cursor: pointer;
    }

    input[type="file"]::file-selector-button:hover {
      background-color: #134b61;
      color: #fff;
    }

    .submit-container {
      grid-column: span 2;
      text-align: center;
      margin-top: 50px;
    }

    .file-box {
  width: 350px;             
  height: 260px;             
  display: flex;
  align-items: center;       
  justify-content: center;   
  margin: 40px auto 16px auto; 
}
 
.file-box img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: 12px;
}
 
.file-box video {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }

  </style>
    </head>
<body>
    <%- include ('partials/navbar.ejs') %>

    <div class="container text-center mt-4">
        <br>
        <h2 id="pageTitle">Update Content</h2>
        <div class="text-center">
            <form action="/editContent/<%=content.contentID%>" method="POST" enctype="multipart/form-data" class="form-container">
            <label for="contentTitle" id="titleLabel">Content Title:</label>
            <input type="text" id="contentTitle" name="contentTitle" value="<%=content.contentTitle%>" required class="custom-input">

            <label for="contentDescription" id="descLabel">Content Description:</label>
            <textarea id="contentDescription" name="contentDescription" required class="custom-textarea" oninput="autoExpand(this)"><%=content.contentDescription%></textarea>

            <label for="categoryID" id="categoryLabel">Category:</label>
            <select name="contentTypeID" id="contentTypeID" required class="custom-input">
              <option value="">Select category</option> 
              <option value="1">Environmental</option>
              <option value="2">Social</option>
              <option value="3">Governance</option>
            </select>
            
                <label for="file" id="currentFileLabel">Current File:</label>
                <input type="hidden" name="currentFile" value = "<%= content.contentFile %>" >
                <div class="file-box" style="position: relative; background:#f5f5f5;">
                  <% const ext = content.contentFile.split('.').pop().toLowerCase(); %>
                  <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
                    <img src="<%= content.contentFile %>?w=350&h=260&c=fill" style="width:100%; height:100%; object-fit:contain;">
                  <% } else if (ext === 'pdf') { %>
                    <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#d32f2f;">
                      <div style="font-size:70px;">📄</div>
                      <div style="margin-top:12px; font-weight:bold; color:#666;">PDF Document</div>
                    </div>
                    <div style="position:absolute;top:8px;right:8px;background:rgba(211,47,47,0.9);color:white;padding:4px 8px;border-radius:20px;font-size:12px;font-weight:bold;">PDF</div>
                  <% } else if (['doc','docx'].includes(ext)) { %>
                    <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#1976d2;">
                      <div style="font-size:70px;">📘</div>
                      <div style="margin-top:12px; font-weight:bold; color:#666;">Word Document</div>
                    </div>
                    <div style="position:absolute;top:8px;right:8px;background:rgba(25,118,210,0.9);color:white;padding:4px 8px;border-radius:20px;font-size:12px;font-weight:bold;">DOC</div>
                  <% } else if (['ppt','pptx'].includes(ext)) { %>
                    <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#d84315;">
                      <div style="font-size:70px;">🎪</div>
                      <div style="margin-top:12px; font-weight:bold; color:#666;">PowerPoint</div>
                    </div>
                    <div style="position:absolute;top:8px;right:8px;background:rgba(216,67,21,0.9);color:white;padding:4px 8px;border-radius:20px;font-size:12px;font-weight:bold;">PPT</div>
                  <% } else if (['mp4','mov','avi'].includes(ext)) { %>
                    <video style="width:100%; height:100%; object-fit:cover;" muted>
                      <source src="<%= content.contentFile %>">
                    </video>
                    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:40px;background:rgba(0,0,0,0.5);border-radius:50%;width:60px;height:60px;display:flex;align-items:center;justify-content:center;">▶️</div>
                  <% } else { %>
                    <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#757575;">
                      <div style="font-size:70px;">📃</div>
                      <div style="margin-top:12px; font-weight:bold; color:#666;"><%= ext.toUpperCase() %></div>
                    </div>
                  <% } %>
                </div>
                
                <label for="contentFile" id="newFileLabel">New File (Optional):</label>
                <div>
                  <input type="file" id="contentFile" name="contentFile"
                    accept=".jpg,.jpeg,.png,.gif,.webp,.mp4,.mov,.avi,.pdf,.doc,.docx,.ppt,.pptx">
                  <small id="fileHelp" style="display:block; margin-top:8px; color:#555; font-style:italic;">
                    Leave empty to keep current file. Accepted formats: Images (JPG, PNG, GIF, WebP), Videos (MP4, MOV, AVI), PDF, Word (DOC, DOCX), PowerPoint (PPT, PPTX). Max 10MB.
                  </small>
                  <div id="fileError" style="color:#e63946; margin-top:8px; font-weight:600; display:none;"></div>
                </div>

                <div class="submit-container">
                    <button type="submit" id="submitBtn">Update Content</button> <br><br>
                </div>
            </form>
        </div>
    </div>

    <script>
        const ALLOWED_EXTENSIONS = ['jpg','jpeg','png','gif','webp','mp4','mov','avi','pdf','doc','docx','ppt','pptx'];
        const MAX_FILE_SIZE = 10 * 1024 * 1024; 

        function autoExpand(textarea) {
          textarea.style.height = "auto";
          textarea.style.height = textarea.scrollHeight + "px";
        }

        window.addEventListener('DOMContentLoaded', function() {
          document.querySelectorAll('textarea').forEach(autoExpand);
          

          const pageTitle = document.getElementById('pageTitle');
          const titleLabel = document.getElementById('titleLabel');
          const descLabel = document.getElementById('descLabel');
          const categoryLabel = document.getElementById('categoryLabel');
          const currentFileLabel = document.getElementById('currentFileLabel');
          const newFileLabel = document.getElementById('newFileLabel');
          const submitBtn = document.getElementById('submitBtn');
          
          if (pageTitle) pageTitle.textContent = t('updateContent');
          if (titleLabel) titleLabel.textContent = t('contentTitle') + ':';
          if (descLabel) descLabel.textContent = t('contentDescription') + ':';
          if (categoryLabel) categoryLabel.textContent = t('category') + ':';
          if (currentFileLabel) currentFileLabel.textContent = t('currentFile') + ':';
          if (newFileLabel) newFileLabel.textContent = t('newFile') + ':';
          if (submitBtn) submitBtn.textContent = t('updateBtn');

  
          const fileInput = document.getElementById('contentFile');
          const fileError = document.getElementById('fileError');
          const form = fileInput.closest('form');

          fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            fileError.style.display = 'none';
            fileError.textContent = '';

            if (!file) return; 

  
            const fileName = file.name.toLowerCase();
            const ext = fileName.split('.').pop();

            if (!ALLOWED_EXTENSIONS.includes(ext)) {
              fileError.textContent = `❌ File type ".${ext}" not allowed. Please use: Images, Videos, PDF, Word, or PowerPoint.`;
              fileError.style.display = 'block';
              fileInput.value = '';
              return;
            }

            if (file.size > MAX_FILE_SIZE) {
              fileError.textContent = `❌ File size exceeds 10MB limit. Current: ${(file.size / 1024 / 1024).toFixed(2)}MB`;
              fileError.style.display = 'block';
              fileInput.value = '';
              return;
            }
          });
        });
    </script>

    <footer>
        &copy; 2025 RPEcoJourney. All Rights Reserved.
    </footer>
</body>
</html>