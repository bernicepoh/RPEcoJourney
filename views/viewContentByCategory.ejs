<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-image: url("/images/categoryBackground.png") !important;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: bottom center;
      min-height: 100vh;
    }

    /* Hero Banner */
    .hero {
      width: 100%;
      min-height: 240px;
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      background-color: #cfe9c9;
      position: relative;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0));
    }

    .cat-card {
      position: relative;
      z-index: 2;
      background:#145a32;
      color:#fff;
      border-radius: 28px;
      padding: 24px 28px;
      width: min(980px, 92%);
      text-align:center;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
      border: 3px solid #2e7d32;
    }

    .cat-card h2 {
      margin:0 0 10px 0;
      font-size:1.35rem;
      text-transform: uppercase;
      font-weight: 700;
    }

    .spotlight {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 18px;
      background: #155f39;
      color: #fff;
      padding: 22px 28px;
      border-radius: 28px;
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
      max-width: 1100px;
      margin: 18px auto;
    }

    .spotlight__avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
    }

    footer {
      text-align: center;
      padding: 25px;
      font-size: 1.1em;
      color: #555;
    }
  </style>
</head>
<body>

<%- include('partials/navbar') %>

<%
  const heroBg = (cat && cat.categoryImage) 
                 ? '/images/' + cat.categoryImage 
                 : '/images/default.png';
%>

<!-- HERO -->
<section class="hero" style="background-image: url('<%= heroBg %>');">
  <div class="cat-card">
    <h2><%= cat.categoryName.toUpperCase() %></h2>
    <p><%= cat.categoryDescription && cat.categoryDescription.includes('-') 
          ? cat.categoryDescription.split('-')[1].trim()
          : "" %></p>
  </div>
</section>


<!-- MANAGER SPOTLIGHT -->
<section class="spotlight">
  <img class="spotlight__avatar" src="/images/manager-irdina.png">
  <div>
    <h4 style="margin:0; font-weight:700; font-style:italic;">
      MS Irdina — Head of <%= cat ? cat.categoryName : "" %> Sustainability
    </h4>
    <p style="margin:0;">
      Oversees this category in RPEcoJourney, leading initiatives promoting eco-awareness within RP.
    </p>
  </div>
</section>


<!-- CONTENT LIST -->
<div class="container">
  <br>

  <% const hasContent = contentList && contentList.length > 0; %>

  <% if (hasContent) { %>

    <% for (let i = 0; i < contentList.length; i++) { 
         const item = contentList[i];
         const likedByUser = item.userLiked > 0;  // from SQL SUM()
         const likeCount = item.likeCount || 0;
    %>
      <div class="d-flex align-items-center mb-4 p-3">
        <!-- Image -->
        <img src="/images/<%= item.contentFile %>" alt="Content image"
             style="width:200px;height:auto;border-radius:12px;
                    box-shadow:0 2px 8px rgba(0,0,0,0.11);
                    object-fit:cover;margin-right:20px;">

        <div style="flex:1">
          <!-- Title -->
          <h5 class="mb-1" style="color:#155f39;font-weight:700;">
            <a href="/content/<%= item.contentID %>" 
               style="color:inherit; text-decoration:none;">
              <%= item.contentTitle %>
            </a>
          </h5>

          <!-- Short description (first sentence) -->
          <p class="mb-2" style="font-style:italic;color:#155f39;font-size:1.03em;">
            <%= item.contentDescription.split('.')[0] + '.' %>
          </p>

          <!-- Action buttons -->
          <div class="d-flex align-items-center">
            <!-- LIKE BUTTON -->
            <button class="like-btn btn btn-light btn-sm me-2" 
                    data-content-id="<%= item.contentID %>"
                    style="display:flex;align-items:center;gap:6px;">
              <span class="heart-icon"><%= likedByUser ? "❤️" : "🤍" %></span>
              <span class="like-text">Like</span>
            </button>

            <!-- LIKE COUNT -->
            <span class="like-count" 
                  data-content-id="<%= item.contentID %>"
                  style="margin-right:15px;color:#155f39;font-weight:600;">
              <%= likeCount %> like<%= likeCount === 1 ? "" : "s" %>
            </span>

              <!-- COMMENT BUTTON -->
            <a href="/content/<%= item.contentID %>" class="btn btn-light btn-sm me-2">
              💬 Comment
            </a>

            <!-- Placeholder: Comment / Share (future) -->
            
            <button class="btn btn-light btn-sm" title="Share">↗️</button>
          </div>
        </div>
      </div>
    <% } %>

  <% } else { %>

    <p style="text-align:center; font-size:1.25rem; color:#145a32; margin-top:22px;">
      🚫 No content available yet — stay tuned!
    </p>

  <% } %>
</div>


<footer>&copy; 2025 RPEcoJourney. All Rights Reserved.</footer>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const likeButtons = document.querySelectorAll('.like-btn');

  likeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const contentID = btn.getAttribute('data-content-id');

      fetch(`/toggle-like/${contentID}`, {
        method: 'POST'
      })
      .then(res => {
        if (res.status === 401) {
          // Not logged in
          alert('Please log in to like posts.');
          return null;
        }
        return res.json();
      })
      .then(data => {
        if (!data) return;

        if (!data.success) {
          console.error('Toggle like failed.');
          return;
        }

        // Update heart icon
        const heartSpan = btn.querySelector('.heart-icon');
        if (data.liked) {
          heartSpan.textContent = '❤️';
        } else {
          heartSpan.textContent = '🤍';
        }

        // Update count text
        const countSpan = document.querySelector(
          `.like-count[data-content-id="${contentID}"]`
        );
        if (countSpan) {
          const count = data.likeCount;
          countSpan.textContent = `${count} like${count === 1 ? "" : "s"}`;
        }
      })
      .catch(err => {
        console.error('Error toggling like:', err);
      });
    });
  });
});
</script>

</body>
</html>
