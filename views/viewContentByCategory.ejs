<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-image: url("/images/categoryBackground.png") !important;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: bottom center;
      min-height: 100vh;
    }

    /* Hero banner */
    .hero {
      position: relative;
      width: 100%;
      min-height: 240px;
      background: url('/images/environmental-banner.png') center/cover no-repeat;
      background-color:#cfe9c9;
      display:flex;
      align-items:center;
      justify-content:center;
      padding: 24px 16px;
    }
    .hero::before {
      content: '';
      position:absolute; inset:0;
      background: linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0));
    }

    /* Category Description */
    .cat-card {
      position: relative;
      z-index: 1;
      background:#145a32;
      color:#fff;
      border-radius: 28px;
      padding: 24px 28px;
      width: min(980px, 92%);
      text-align:center;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
      border: 3px solid #2e7d32;
    }
    .cat-card h2 {
      margin:0 0 10px 0;
      font-size:1.35rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }
    .cat-card p {
      margin:0;
      line-height:1.7;
      font-size:1.05rem;
    }

    /* Spotlight (Category Manager) */
    .spotlight {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 18px;
      background: #155f39;              /* deep green!!!! */
      color: #fff;
      padding: 22px 28px;
      border-radius: 28px;               
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
      max-width: 1100px;               
      margin: 18px auto;                 /* center on page */
    }

    .spotlight__avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.6);
      box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    }

    .spotlight__content {
      display: grid;
      gap: 6px;
    }

    .spotlight__title {
      margin: 0;
      font-style: italic;              
      font-weight: 700;
      letter-spacing: 0.1px;
    }

    .spotlight__card {
      margin: 0;
      line-height: 1.6;            /* uhm slightly softer white */
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }
  </style>
</head>
<body>
    <%- include ('partials/navbar.ejs') %>  

    <section class="hero">
        <div class="cat-card">
            <h2><%= (category.categoryName || 'Category').toUpperCase() %></h2>
            <p>
                <%= category.categoryDescription 
                ? category.categoryDescription 
                : 'This category highlights initiatives, knowledge, and actions that support RP’s sustainability journey.' %>
            </p>
        </div>
    </section>

    <!-- Manager for each Category -->
    <section class="spotlight" aria-label="Category Lead">
    <% const manager = { name: 'Ms Irdina', photo: '/images/manager-irdina.png' }; %>
    <img class="spotlight__avatar"
       src="<%= manager.photo %>"
       alt="<%= manager.name %>">
    <div class="spotlight__content">
    <h4 class="spotlight__title">
      MS Irdina Head Management of Environmental Sustainability
    </h4>
    <p class="spotlight__card">
      Oversees the Environmental category on RPEcoJourney, leading initiatives that promote eco-friendly practices and sustainability awareness within Republic Polytechnic.
    </p>
    </div>
    </section>



    <div class="container">
      <br>
      <% for(let i=0; i < category.length; i++) { %>
        <div class="d-flex align-items-center mb-4 p-3">
          <img src="/images/<%= category[i].contentFile %>" alt="Content image" style="width:200px;height:auto;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.11);object-fit:cover;margin-right:20px;">
          <div style="flex:1">
  
            <h5 class="mb-1" style="color:#155f39;font-weight:700;">
              <a href="/content/<%= category[i].contentID %>" style="color:inherit; text-decoration:none;">
                <%= category[i].contentTitle %>
              </a>
            </h5>

            <p class="mb-2" style="font-style:italic;color:#155f39;font-size:1.03em;"><%= category[i].contentDescription.split('.')[0] + '.' %></p>
            <div>
              <button class="btn btn-light btn-sm me-2" title="Like" aria-label="Like">❤</button>
              <button class="btn btn-light btn-sm me-2" title="Comment" aria-label="Comment">💬</button>
              <button class="btn btn-light btn-sm" title="Share" aria-label="Share">↗️</button>
            </div>
          </div>
        </div>
      <% } %>
    </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>