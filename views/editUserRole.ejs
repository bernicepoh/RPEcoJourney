<body>
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update User Role</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Georgia', serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #e8dfcf;
            background-repeat: no-repeat;
            background-size: cover; 
            background-position: center;
        }

        .card-role {
            width: 400px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            background-color: #fff;
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        .btn-update {
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="card-role">
        <h2>Update User Role</h2>

        <form action="/editUserRole/<%= user.userID %>" method="POST">
            <div class="mb-3">
                <label for="userType" class="form-label">Select Role:</label>
                <select name="userType" id="userType" class="form-select" required>
                    <option value="Admin" <%= user.userType === 'Admin' ? 'selected' : '' %>>Admin</option>
                    <option value="User" <%= user.userType === 'User' ? 'selected' : '' %>>User</option>
                    <option value="Writer" <%= user.userType === 'Writer' ? 'selected' : '' %>>Writer</option>
                    <option value="Manager" <%= user.userType === 'Manager' ? 'selected' : '' %>>Manager</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-update">Update Role</button>
        </form>
    </div>
</body>
</html>

    
</body>
</html>