<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-color: #e8dfcf;
      background-repeat: no-repeat;
      background-size: cover; 
      background-position: center;
    }
    .desc-divider {
      border: none;
      border-top: 2px solid #d2c9c7;
      margin: 32px auto 32px auto;
      width: 80%;
    }
    .desc-text {
      font-style: italic;
      text-align: center;
      margin: 0 auto;
      max-width: 900px;
      margin-bottom: 40px;
    }
    .main-image {
      display: block;
      margin: 24px auto 0 auto;
      max-width: 96%;
      border-radius: 8px;
    }
 
    footer {
      text-align: center;
      padding: 25px;
      font-size: 1.1em;
      color: #555;
    }
 
    .back-link {
      display: inline-block;
      margin-top: 50px;
      text-decoration: none;
      color: #256b45;
      font-weight: 700;
      font-size: 1rem;
      transition: color 0.3s ease;
    }
 
    .back-link:hover {
      text-decoration: underline;
      color: #1a4b32;
    }
 
    .file-box {
      width: 800px;              /* all previews share SAME width */
      height: 600px;             /* adjust height if needed */
      display: flex;
      align-items: center;       /* center vertically */
      justify-content: center;   /* center horizontally */
      margin: 40px auto 16px auto; /* centers horizontally with bottom space */
    }
    
    .file-box img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      border-radius: 12px;
    }
    
    .file-box video {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    
    /* Comment form container */
    .comment-form {
      max-width: 750px;
      margin: 30px auto 0;
      padding: 20px;
      background: white; /* 👈 solid light eco white */
      border-radius: 14px;
      border: 1px solid #cfe6cf;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
    }

    /* Label */
    .comment-form .form-label {
      font-size: 0.95em;
      font-weight: 600;
      color: #2f5d3a;
      margin-bottom: 8px;
      display: block;
    }

    /* Textarea */
    .comment-area {
      width: 100%;
      min-height: 150px;   /* 👈 bigger */
      padding: 14px 16px;
      font-size: 0.95em;
      line-height: 1.6;
      border-radius: 10px;
      border: 2px solid #a7cfa9;
      background-color: #ffffff;
      color: #2c2c2c;
      resize: vertical;
    }

   .comment-area::placeholder {
      color: #7fa58c;
      font-style: italic;
    }

    /* Focus state */
    .comment-area:focus {
      border-color: #5fa777;
      box-shadow: 0 0 0 3px rgba(95, 167, 119, 0.2);
    }

    /* ==============================
        Edit Comment Box Enhancements
      ============================== */
      .edit-textarea-container {
        margin-bottom: 15px;
      }

      .form-control {
        width: 100%;
        min-height: 150px; /* 👈 bigger typing area */
        padding: 14px 16px;
        font-size: 1em;
        line-height: 1.6;
        border: 1.5px solid #b7d4b1;
        border-radius: 10px;
        background-color: #ffffff;  /* Solid background */
        resize: vertical;
        transition: border-color 0.3s, box-shadow 0.3s ease;
      }

      /* Focus effect */
      .form-control:focus {
        border-color: #5fa777;
        box-shadow: 0 0 0 3px rgba(95, 167, 119, 0.2);
      }

      /* Button padding and spacing */
      button {
        padding: 8px 16px;
        margin-top: 12px;
        font-size: 1em;
      }

      button:focus {
        outline: none;
      }

    .comment-box {
      background: #edf3ef;
      border: 1px solid #d6e4d9;
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 14px;
      display: flex;
      gap: 12px;
    }

    .comment-box.blocked {
      background: #fdecea;
      border: 1px solid #f5c2c7;
    }

    .comment-content {
      flex: 1;
    }

    .comment-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .comment-time {
      font-size: 0.85em;
      opacity: 0.6;
    }

    .comment-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
    }

    .comment-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 14px;
    }

    .publish-btn {
      background: #2a7e4e;
      color: white;
      font-weight: 600;
      border-radius: 10px;
      padding: 6px 22px;
      border: none;
      margin-top: 8px;
      float: right;
    }

    .btn-link.text-success {
        font-weight: 600;
      }

  </style>
</head>
<body>
  <%- include ('partials/navbar.ejs') %>
  <script src="/translations.js"></script>
 
  <div class="container mt-3 mb-5">
    <% if (content) { %>
      <h3 class="text-center mt-2" style="font-style:italic;" id="contentPageTitle">
        <%= content.contentTitle %>
      </h3>
 
      <div class="file-box">
  <% const ext = content.contentFile.split('.').pop().toLowerCase(); %>

  <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
    <!-- Images -->
    <img src="<%= content.contentFile %>">

  <% } else if (ext === 'pdf') { %>
    <!-- PDFs: embed with iframe -->
    <iframe
      src="<%= content.contentFile %>"
      style="width:100%; height:100%; border:none;"
    ></iframe>

  <% } else if (['doc','docx'].includes(ext)) { %>
    <!-- Word docs: use Office Web Viewer -->
    <iframe 
      src="https://view.officeapps.live.com/op/embed.aspx?src=<%= encodeURIComponent(content.contentFile) %>" 
      style="width:100%; height:100%; border:none;"></iframe>

  <% } else if (['ppt','pptx'].includes(ext)) { %>
    <!-- PowerPoint: use Office Web Viewer -->
    <iframe
      src="https://view.officeapps.live.com/op/embed.aspx?src=<%= encodeURIComponent(content.contentFile) %>"
      style="width:100%; height:100%; border:none;"
    ></iframe>

  <% } else if (['mp4','mov','avi'].includes(ext)) { %>
    <!-- Videos (you already had this) -->
    <video autoplay loop muted playsinline controls style="max-width:100%; max-height:100%; object-fit:contain;">
      <source src="<%= content.contentFile %>">
    </video>

  <% } else { %>
    <!-- Fallback: still allow download -->
    <a href="<%= content.contentFile %>" target="_blank">
      <img class="file-icon" src="<%= content.contentFile %>" style="width: 150px;">
    </a>
  <% } %>
</div>
 
 
      <hr class="desc-divider">
 
      <div class="desc-text" id="contentDescription">
        <%= content.contentDescription %>
      </div>
 
      <hr class="desc-divider" style="margin-top:45px;">
 
<div style="display:flex; justify-content:space-between; align-items:center; max-width:750px; margin:auto;">
  <h4 style="font-weight:600; color:#145a32;" id="commentsHeading">Comments</h4>
 
  <!-- SORT DROPDOWN -->
  <form method="GET" style="margin:0;">
    <select name="sort" id="sortDropdown" onchange="this.form.submit()" class="form-select form-select-sm">
      <option value="newest" <%= sort === 'newest' ? 'selected' : '' %> id="sortNewest">Newest</option>
      <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %> id="sortOldest">Oldest</option>
      <option value="az" <%= sort === 'az' ? 'selected' : '' %> id="sortAZ">A → Z</option>
      <option value="za" <%= sort === 'za' ? 'selected' : '' %> id="sortZA">Z → A</option>
    </select>
  </form>
</div>

<hr>  
 
<% comments.forEach(c => { %>

  <!-- ================= BLOCKED COMMENT ================= -->
  <% if (c.isBlocked) { %>

    <!-- OWNER VIEW -->
    <% if (sessionUser && sessionUser.userID === c.userID) { %>
      <div class="comment-box blocked">
        🚫 Your comment was removed for violating community guidelines.
      </div>

    <!-- ADMIN / MANAGER VIEW -->
<% } else if (
  sessionUser &&
  ['Admin','Manager'].includes(sessionUser.userType)
) { %>

  <div class="comment-box blocked" style="display:flex; gap:12px;">
    <img
      src="<%= c.userImage || 'https://res.cloudinary.com/dmyv7fbha/image/upload/v1769968875/defaultUser_rgp4og.png' %>"
      class="comment-avatar"
    >

    <div class="comment-content">
      <div class="comment-header">
        <strong>
          <%= c.userType %> - <%= c.userName %>
          <span class="badge bg-danger ms-2">Blocked</span>
        </strong>
        <span class="comment-time"><%= c.createdAt %></span>
      </div>

      <p style="font-style:italic; opacity:0.85;">
        <%= c.commentText %>
      </p>

      <!-- 🔓 UNBLOCK BUTTON (ADMIN / MANAGER ONLY) -->
      <form
        action="/comment/unblock/<%= c.commentID %>"
        method="POST"
        style="margin-top:6px;"
      >
        <input type="hidden" name="contentID" value="<%= content.contentID %>">

        <button
          type="button"
          class="btn btn-link p-0 text-success"
          onclick="confirmUnblock('<%= c.commentID %>', '<%= content.contentID %>')">
          🔓 Unblock
        </button>
      </form>

    </div>
  </div>

    <% } %>

  <!-- ================= NORMAL COMMENT ================= -->
  <% } else { %>

    <div class="comment-box" style="display:flex; gap:12px;">

      <!-- ✅ AVATAR IS BACK -->
      <img
        src="<%= c.userImage || 'https://res.cloudinary.com/dmyv7fbha/image/upload/v1769968875/defaultUser_rgp4og.png' %>"
        class="comment-avatar"
      >

      <div class="comment-content">

        <div class="comment-header">
          <strong>
            <%= c.userType %> - <%= c.userName %>
          </strong>
          <span class="comment-time"><%= c.createdAt %></span>
        </div>

        <p id="commentText-<%= c.commentID %>"><%= c.commentText %></p>

        <!-- EDIT FORM -->
        <form
          action="/comment/edit/<%= c.commentID %>"
          method="POST"
          id="editForm-<%= c.commentID %>"
          style="display:none;"
        >
          <input type="hidden" name="contentID" value="<%= content.contentID %>">
          
          <!-- Enhanced Edit Textarea -->
          <div class="edit-textarea-container">
            <textarea name="updatedText" class="form-control" rows="4"><%= c.commentText %></textarea>
          </div>

          <button class="btn btn-success btn-sm mt-3">Save</button>
          <button type="button" class="btn btn-secondary btn-sm mt-3"
                  onclick="cancelEdit('<%= c.commentID %>')">Cancel</button>
        </form>

        <!-- ACTION BUTTONS -->
        <% if (sessionUser) { %>
          <div style="margin-top:6px;">

            <!-- ✏️ EDIT + 🗑️ DELETE (OWNER ONLY, INCLUDING ADMIN ON OWN COMMENT) -->
            <% if (sessionUser.userID === c.userID) { %>
              <button
                class="btn btn-link p-0 me-2"
                onclick="enableEdit('<%= c.commentID %>')">
                ✏️ Edit
              </button>

              <button
                class="btn btn-link p-0 text-danger"
                onclick="confirmDelete('<%= c.commentID %>')">
                🗑️ Delete
              </button>
            <% } %>

            <!-- 🚫 BLOCK (ADMIN / MANAGER ON OTHER USERS ONLY) -->
            <% if (
              sessionUser.userID !== c.userID &&
              ['Admin','Manager'].includes(sessionUser.userType)
            ) { %>
              <form
                action="/comment/block/<%= c.commentID %>"
                method="POST"
                style="display:inline;">
                <input type="hidden" name="contentID" value="<%= content.contentID %>">

                <button
                  type="button"
                  class="btn btn-link p-0 text-danger"
                  onclick="confirmBlock('<%= c.commentID %>', '<%= content.contentID %>')">
                  🚫 Block
                </button>
              </form>
            <% } %>

          </div>
        <% } %>

      </div>
    </div>

  <% } %>

<% }) %>

  <!-- Add new comment box -->
  <form action="/content/<%= content.contentID %>/comment" 
        method="POST" 
        class="comment-form">

    <label class="form-label" id="commentLabel">Write a comment:</label>

    <textarea 
      name="commentText" 
      class="comment-area" 
      id="commentPlaceholder"
      placeholder="Share your thoughts respectfully 🌱"
      required></textarea>

    <div class="comment-actions">
      <button type="submit" class="publish-btn" id="publishBtn">Publish</button>
    </div>
  </form>

  <a href="/contentType/<%= content.contentTypeID %>/content" class="back-link" id="backLink">← Back to <%= content.contentTypeName %></a>
 
    <% } else { %>
      <p>No content found.</p>
    <% } %>
  </div>
 
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 
  <script>

function enableEdit(id) {
  document.getElementById("commentText-" + id).style.display = "none";
  document.getElementById("editForm-" + id).style.display = "block";
}
 
function cancelEdit(id) {
  document.getElementById("commentText-" + id).style.display = "block";
  document.getElementById("editForm-" + id).style.display = "none";
}
 
function confirmDelete(commentID) {
  Swal.fire({
    title: "Delete this comment?",
    text: "This action cannot be undone.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Delete"
  }).then((result) => {
    if (result.isConfirmed) {

      // Create a POST form dynamically
      const form = document.createElement("form");
      form.method = "POST";
      form.action = "/comment/delete/" + commentID;

      document.body.appendChild(form);
      form.submit();
    }
  });
}

function confirmBlock(commentID, contentID) {
  Swal.fire({
    title: "Block this comment?",
    text: "The comment will be hidden from public users.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#e74c3c",
    cancelButtonColor: "#6c757d",
    confirmButtonText: "Yes, block it",
    cancelButtonText: "Cancel"
  }).then((result) => {
    if (result.isConfirmed) {
      const form = document.createElement("form");
      form.method = "POST";
      form.action = `/comment/block/${commentID}`;

      const input = document.createElement("input");
      input.type = "hidden";
      input.name = "contentID";
      input.value = contentID;

      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  });
}

function confirmUnblock(commentID, contentID) {
  Swal.fire({
    title: "Unblock this comment?",
    text: "This comment will become visible to all users again.",
    icon: "question",
    showCancelButton: true,
    confirmButtonColor: "#2ecc71",
    cancelButtonColor: "#6c757d",
    confirmButtonText: "Yes, unblock it",
    cancelButtonText: "Cancel"
  }).then((result) => {
    if (result.isConfirmed) {
      const form = document.createElement("form");
      form.method = "POST";
      form.action = `/comment/unblock/${commentID}`;

      const input = document.createElement("input");
      input.type = "hidden";
      input.name = "contentID";
      input.value = contentID;

      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  });
}
 
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
const params = new URLSearchParams(window.location.search);
const moderation = params.get("moderation");

if (moderation === "blocked") {
  Swal.fire({
    icon: "success",
    title: "Comment Blocked",
    text: "The comment has been hidden from public view.",
    timer: 2000,
    showConfirmButton: false
  });
}

if (moderation === "unblocked") {
  Swal.fire({
    icon: "success",
    title: "Comment Restored",
    text: "The comment is now visible again.",
    timer: 2000,
    showConfirmButton: false
  });
}
</script>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    const error = urlParams.get("error");
 
    // SUCCESS POPUP
    if (urlParams.get("success") === "posted") {
        Swal.fire({
            icon: "success",
            title: "Comment Posted!",
            text: "Your comment has been successfully added.",
            timer: 2000,
            showConfirmButton: false
        });
    }
   
    if (error === "rate_limit") {
        Swal.fire({
            icon: "warning",
            title: "AI Moderation Busy",
            text: "Please try again in a few seconds.",
            confirmButtonColor: "#6ab04c"
        });
    }
 
    if (error === "moderation_fail") {
        Swal.fire({
            icon: "error",
            title: "AI Moderation Error",
            text: "Something went wrong. Please try again later.",
            confirmButtonColor: "#eb4d4b"
        });
    }
 
    if (error === "inappropriate") {
        Swal.fire({
            icon: "error",
            title: "Comment Blocked",
            text: "Your comment contains inappropriate content. Please rewrite and try again.",
            confirmButtonColor: "#e74c3c"
        });
    }

    // ✅ COMMENT EDITED (NEW)
    if (urlParams.get("success") === "edited") {
      Swal.fire({
        icon: "success",
        title: "Comment Updated!",
        text: "Your changes have been saved.",
        timer: 1800,
        showConfirmButton: false
      });
    }

    // ✅ Translate view content page elements
    document.addEventListener('DOMContentLoaded', () => {
      const commentsHeading = document.getElementById('commentsHeading');
      const commentLabel = document.getElementById('commentLabel');
      const commentPlaceholder = document.getElementById('commentPlaceholder');
      const publishBtn = document.getElementById('publishBtn');
      const backLink = document.getElementById('backLink');
      const sortNewest = document.getElementById('sortNewest');
      const sortOldest = document.getElementById('sortOldest');
      const sortAZ = document.getElementById('sortAZ');
      const sortZA = document.getElementById('sortZA');

      if (commentsHeading) commentsHeading.textContent = t('commentsHeading');
      if (commentLabel) commentLabel.textContent = t('commentLabel');
      if (commentPlaceholder) commentPlaceholder.placeholder = t('commentLabel');
      if (publishBtn) publishBtn.textContent = t('publishBtn');
      if (sortNewest) sortNewest.textContent = t('sortNewest');
      if (sortOldest) sortOldest.textContent = t('sortOldest');
      if (sortAZ) sortAZ.textContent = t('sortAZ');
      if (sortZA) sortZA.textContent = t('sortZA');
    });
</script>
 
</body>
</html>