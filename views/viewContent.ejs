<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      background-image: url("/images/categoryBackground.png") !important;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: bottom center;
      min-height: 100vh;
    }
    .desc-divider {
      border: none;
      border-top: 2px solid #d2c9c7;
      margin: 32px auto 32px auto;
      width: 80%;
    }
    .desc-text {
      font-style: italic;
      text-align: center;
      margin: 0 auto;
      max-width: 600px;
      margin-bottom: 40px;
    }
    .main-image {
      display: block;
      margin: 24px auto 0 auto;
      max-width: 96%;
      border-radius: 8px;
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }

    .back-link {
      display: inline-block;
      margin-top: 50px;
      text-decoration: none;
      color: #256b45;
      font-weight: 700;
      font-size: 1rem;
      transition: color 0.3s ease;
    }

    .back-link:hover {
      text-decoration: underline;
      color: #1a4b32;
    }

.file-box {
  width: 350px;              /* all previews share SAME width */
  height: 260px;             /* adjust height if needed */
  display: flex;
  align-items: center;       /* center vertically */
  justify-content: center;   /* center horizontally */
  margin: 40px auto 16px auto; /* centers horizontally with bottom space */
}

.file-box img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: 12px;
}

.file-box video {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.comment-area {
      width: 100%;
      min-height: 55px;
      border-radius: 7px;
      padding: 8px 12px;
      background: #a7c3bb42;
      border: 1px solid #bddad1;
      resize: vertical;
    }

    .publish-btn {
      background: #2a7e4e;
      color: white;
      font-weight: 600;
      border-radius: 10px;
      padding: 6px 22px;
      border: none;
      margin-top: 8px;
      float: right;
    }
  </style>
</head>
<body>
  <%- include ('partials/navbar.ejs') %>

  <div class="container mt-3 mb-5">
    <% if (content) { %>
      <h3 class="text-center mt-2" style="font-style:italic;">
        <%= content.contentTitle %>
      </h3>

      <div class="file-box">
        <% const ext = content.contentFile.split('.').pop().toLowerCase(); %>
        <% if (['png','jpg','jpeg','gif','webp'].includes(ext)) { %>
          <img src="/uploads/<%= content.contentFile %>">
        <% } else if (ext === 'pdf') { %>
          <a href="/uploads/<%= content.contentFile %>" target="_blank">
            <img class="file-icon" src="/images/pdf.png" style="width: 150px;">
          </a>
        <% } else if (['doc','docx'].includes(ext)) { %>
          <a href="/uploads/<%= content.contentFile %>" target="_blank">
            <img class="file-icon" src="/images/word.png" style="width: 150px;">
          </a>
        <% } else if (['ppt','pptx'].includes(ext)) { %>
          <a href="/uploads/<%= content.contentFile %>" target="_blank">
            <img class="file-icon" src="/images/ppt.png" style="width: 150px;">
          </a>
        <% } else if (['mp4','mov','avi'].includes(ext)) { %>
          <video autoplay loop muted playsinline>
            <source src="/uploads/<%= content.contentFile %>">
          </video>
        <% } else { %>
          <a href="/uploads/<%= content.contentFile %>" target="_blank">
            <img class="file-icon" src="/images/file.png">
          </a>
        <% } %>
      </div>

      <hr class="desc-divider">

      <div class="desc-text">
        <%= content.contentDescription %>
      </div>


      

      <hr class="desc-divider" style="margin-top:45px;">

<div style="display:flex; justify-content:space-between; align-items:center; max-width:750px; margin:auto;">
  <h4 style="font-weight:600; color:#145a32;">Comments</h4>

  <!-- SORT DROPDOWN -->
  <form method="GET" style="margin:0;">
    <select name="sort" onchange="this.form.submit()" class="form-select form-select-sm" style="width:auto;">
      <option value="newest" selected>Newest</option>
      <option value="oldest">Oldest</option>
      <option value="az">A → Z</option>
      <option value="za">Z → A</option>
    </select>
  </form>
</div>


<!-- If no comments -->
<% if (comments.length === 0) { %>
  <p style="text-align:center; color:#6e6e6e;">No comments yet — be the first to share your thoughts!</p>
<% } else { %>

  <div class="mt-3" style="max-width:750px; margin:auto;">
    <% comments.forEach(c => { %>
      <div style="background:#edf3ef; border-radius:10px; padding:10px 15px; margin-bottom:12px; border:1px solid #d6e4d9; display:flex; gap:12px;">

        <!-- Avatar -->
        <img 
          src="/images/<%= c.userImage ? c.userImage : 'default-avatar.png' %>" 
          style="width:48px; height:48px; border-radius:50%; object-fit:cover;"
        >

        <div style="flex:1;">
          <strong><%= c.userName %></strong>
          <small style="opacity:0.6; margin-left:6px;"><%= c.createdAt.toLocaleString() %></small>

          <!-- Normal text mode -->
          <p id="commentText-<%= c.commentID %>" style="margin:4px 0; font-size:0.98em;"><%= c.commentText %></p>

          <!-- Hidden Edit Box -->
          <form action="/comment/edit/<%= c.commentID %>" method="POST" style="display:none;" id="editForm-<%= c.commentID %>">
            <input type="hidden" name="contentID" value="<%= content.contentID %>">
            <textarea name="updatedText" class="form-control" rows="2"><%= c.commentText %></textarea>
            <button class="btn btn-success btn-sm mt-2">Save</button>
            <button type="button" class="btn btn-secondary btn-sm mt-2" onclick="cancelEdit('<%= c.commentID %>')">Cancel</button>
          </form>


          <!-- Action buttons -->
          <% if (sessionUser && sessionUser.userID === c.userID) { %>
            <div style="margin-top:5px;">
              <button class="btn btn-link p-0 me-2" onclick="enableEdit('<%= c.commentID %>')">✏️ Edit</button>
              <button class="btn btn-link p-0 text-danger" onclick="confirmDelete('<%= c.commentID %>')">🗑️ Delete</button>
            </div>
          <% } %>
        </div>

      </div>
    <% }) %>
  </div>

<% } %>


<!-- Add new comment box -->
<form action="/content/<%= content.contentID %>/comment" method="POST" style="max-width:750px; margin:25px auto 0;">
  <label class="form-label" style="font-size:0.98em;">Write a comment:</label>
  <textarea name="commentText" class="comment-area" required></textarea>
  <button type="submit" class="publish-btn">Publish</button>
</form>



      <a href="/category/<%= content.categoryID %>/content" class="back-link">← Back to <%= content.categoryName %></a>

    <% } else { %>
      <p>No content found.</p>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
function enableEdit(id) {
  document.getElementById("commentText-" + id).style.display = "none";
  document.getElementById("editForm-" + id).style.display = "block";
}

function cancelEdit(id) {
  document.getElementById("commentText-" + id).style.display = "block";
  document.getElementById("editForm-" + id).style.display = "none";
}

function confirmDelete(id) {
  Swal.fire({
    title: "Delete this comment?",
    text: "This action cannot be undone.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Delete"
  }).then(result => {
    if (result.isConfirmed) {
      window.location.href = "/comment/delete/" + id;
    }
  });
}

  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>