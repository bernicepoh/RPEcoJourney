<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R2XFVQP3B4"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R2XFVQP3B4');
    </script>

    <style>
        body {
            font-family: 'Georgia', serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
        }

        /* LEFT SIDE */
        .left-panel {
            width: 50%;
            background: url("/uploads/login.png") no-repeat center center;
            background-size: cover;
            position: relative;
            padding-left: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* DARK OVERLAY */
        .left-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 40, 0, 0.45);
            backdrop-filter: blur(1px);
        }

        .left-panel * {
            position: relative;
            color: white;
        }

        .left-panel h1 {
            font-size: 60px;
            font-weight: 700;
            margin-bottom: 40px;
        }

        .left-panel p {
            font-size: 22px;
            width: 75%;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        /* RIGHT SIDE */
        .right-panel {
            width: 50%;
            background: #e8dfcf;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        /* LOGIN CARD ANIMATION */
        .login-box {
            width: 80%;
            max-width: 420px;
            animation: fadeIn 0.6s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-box h2 {
            text-align: center;
            font-weight: 800;
            font-size: 36px; 
            line-height: 1.3;
        }

        .login-box small {
            display: block;
            text-align: center;
            margin-bottom: 25px;
        }

        /* INPUTS */
        .form-control {
            padding: 14px;
            border-radius: 25px;
            margin-bottom: 18px;
            font-size: 16px;
        }

        /* BUTTON */
        .btn-login {
            width: 100%;
            padding: 14px;
            border-radius: 25px;
            background: #1b5e20;
            color: white;
            font-size: 18px;
            border: none;
            margin-top: 10px;
            font-weight: 600;
        }

        .btn-login:hover {
            background: #134818;
        }

        /* LINKS */
        .extra-links {
            text-align: center;
            margin-top: 15px;
            font-size: 15px;
        }

        .extra-links a {
            color: #004d00;
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <!-- LEFT PANEL -->
    <div class="left-panel">
        <h1>RPEcoJourney</h1>
        <p>Grow your sustainability journey with XP, badges & daily missions</p>
        <br><br>
        <p>Log in to continue your sustainability adventure</p>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="login-box">

            <h2>Welcome Back,<br>Eco Warrior 🌍</h2>
            <small>Log in to continue your RP EcoJourney</small>

            <!-- ERRORS -->
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <% errors.forEach(error => { %>
                        <p class="mb-0"><%= error %></p>
                    <% }); %>
                </div>
            <% } %>

            <!-- SUCCESS MESSAGES -->
            <% if (messages && messages.length > 0) { %>
                <div class="alert alert-success">
                    <% messages.forEach(message => { %>
                        <p class="mb-0"><%= message %></p>
                    <% }); %>
                </div>
            <% } %>

            <form action="/" method="POST">
                <label>Username</label>
                <input type="text" id="username" name="userName" class="form-control" required>

                <label>Password</label>
                <input type="password" id="password" name="password" class="form-control" required>

                <button type="submit" class="btn-login">Log In</button>
            </form>

            <div class="extra-links">
                <p>
                    New to RPEcoJourney?
                    <a href="/register">Create an account</a>
                </p>
                <a href="/forgot-password">Forget Password?</a>
            </div>

        </div>
    </div>

</body>
</html>



