<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RPEcoJourney | Home</title>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      margin: 0;
      font-family: "Poppins", sans-serif;
      background: url("/images/backgroundimage.jpg") no-repeat center center fixed;
      background-size: cover;
      color: #0b2535;
      overflow-x: hidden;
    }

    .overlay {
      background-color: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(8px);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .hero {
      text-align: center;
      margin-top: 120px;
      padding: 40px;
    }

    .hero h1 {
      font-size: 3.5rem;
      color: #0b2535;
      font-weight: 800;
      margin-bottom: 15px;
      text-shadow: 1px 1px 4px rgba(255, 255, 255, 0.6);
    }

    .hero p {
      font-size: 1.3rem;
      color: #2e8b57;
      font-weight: 500;
      margin-bottom: 35px;
    }

    .btn {
      background-color: #6bbf59;
      color: white;
      padding: 14px 36px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 5px 12px rgba(0, 0, 0, 0.25);
    }

    .btn:hover {
      background-color: #4fa13d;
      transform: scale(1.05);
    }

    .features {
      display: flex;
      justify-content: center;
      align-items: stretch;
      flex-wrap: wrap;
      gap: 30px;
      margin: 80px auto;
      max-width: 1100px;
      padding: 0 40px;
    }

    .feature-card {
      flex: 1 1 300px;
      background: rgba(255, 255, 255, 0.8);
      border-radius: 20px;
      padding: 35px 25px;
      text-align: center;
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease;
    }

    .feature-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }

    .feature-card img {
      width: 70px;
      margin-bottom: 20px;
    }

    .feature-card h3 {
      color: #0b2535;
      font-size: 1.4rem;
      margin-bottom: 10px;
    }

    .feature-card p {
      font-size: 1rem;
      color: #333;
    }

    footer {
      text-align: center;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.7);
      font-weight: 500;
      color: #0b2535;
    }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2.5rem; }
      .hero p { font-size: 1rem; }
    }
  </style>
</head>

<body>
  <%- include('partials/navbar') %>

  <div class="overlay">
    <section class="hero">
      <h1>Welcome to RPEcoJourney 🌿</h1>
      <p>Empowering green living through awareness and fun quizzes.</p>
      <a href="/quiz" class="btn">Get Started</a>
    </section>

    <section class="features">
      <div class="feature-card">
        <img src="/images/leaf-icon.png" alt="Eco Awareness">
        <h3>Learn Sustainability</h3>
        <p>Explore quizzes that raise awareness about environmental, social, and governance topics.</p>
      </div>

      <div class="feature-card">
        <img src="/images/quiz-icon.png" alt="Take Quizzes">
        <h3>Challenge Yourself</h3>
        <p>Test your knowledge in fun, interactive quizzes designed to inspire greener living habits.</p>
      </div>

      <div class="feature-card">
        <img src="/images/community-icon.png" alt="Community">
        <h3>Join the Journey</h3>
        <p>Compete on the leaderboard and be part of a community driving positive change for our planet.</p>
      </div>
    </section>

    <footer>
      © 2025 RPEcoJourney | Built by RP Students for a Greener Future 🌎
    </footer>
  </div>
</body>
</html>