<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;

      /* 🔹 Cloudinary background image */
      background-image: url("https://res.cloudinary.com/dmyv7fbha/image/upload/background.png");
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;

      min-height: 100vh;  
    }

    h2 {
      font-size: 2.8rem;
      color: #0b2535;
      margin-bottom: 60px;
    }

    .form-container {
      display: grid;
      grid-template-columns: 180px auto;
      gap: 25px 40px;
      align-items: center;
      justify-content: center;
      max-width: 750px;
      margin: 0 auto;
    }

    label {
      text-align: right;
      font-weight: 500;
    }

    .custom-input,
    .custom-textarea {
      background: #86a3ae;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 100%;
    }

    button {
      background-color: #b6cca1;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 180px;
    }

    button:hover {
      background-color: #8dcc6b;
      color: #222;
    }

    input[type="file"]::file-selector-button {
      background-color: #86a3ae;
      border: none;
      border-radius: 7px;
      padding: 6px 20px;
      font-style: italic;
      cursor: pointer;
    }

    input[type="file"]::file-selector-button:hover {
      background-color: #134b61;
      color: #fff;
    }

    .submit-container {
      grid-column: span 2;
      text-align: center;
      margin-top: 50px;
    }

    footer {
      text-align: center;
      padding: 25px;
      font-size: 1.1em;
      color: #555;
    }
  </style>
</head>

<body>
  <%- include('partials/navbar.ejs') %>

  <div class="container text-center mt-4">
    <br>
    <h2>Publish Content</h2>

    <form action="/addContent" method="POST" enctype="multipart/form-data" class="form-container">

      <label for="contentTypeID">Category:</label>
      <select name="contentTypeID" id="contentTypeID" required class="custom-input">
        <option value="">Select category</option>
        <option value="1">Environmental</option>
        <option value="2">Social</option>
        <option value="3">Governance</option>
      </select>

      <label for="contentTitle">Title:</label>
      <input type="text" id="contentTitle" name="contentTitle" required class="custom-input" placeholder="Input Title">

      <label for="contentDescription">Description:</label>
      <textarea
        id="contentDescription"
        name="contentDescription"
        required
        class="custom-textarea"
        placeholder="Input Description"
        oninput="autoExpand(this)">
      </textarea>

      <label for="contentFile">File Upload:</label>
      <input type="file" id="contentFile" name="contentFile" required>

      <div class="submit-container">
        <small class="text-muted d-block mb-3">
          Uploaded files will be stored securely in Cloudinary
        </small>
        <button type="submit">Publish Content</button>
      </div>

    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function autoExpand(textarea) {
      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";
    }
  </script>

  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>