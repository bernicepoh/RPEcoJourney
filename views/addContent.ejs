<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="/translations.js"></script>

  <style>
    body {
      font-family: 'Georgia', serif;
      font-size: larger;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background-color: #e8dfcf;
    }

    h2 {
      font-size: 2.8rem;
      color: #0b2535;
      margin-bottom: 60px;
    }

    /* Form container layout */
    .form-container {
      display: grid;
      grid-template-columns: 180px auto;
      gap: 25px 40px; 
      align-items: center;
      justify-content: center;
      max-width: 750px;
      margin: 0 auto;
    }

    label {
      text-align: right;
      font-weight: 500;
    }

    /* UPDATED: Changed color to #000 (Black) for typed text and dropdowns */
    .custom-input,
    .custom-textarea {
      background: #86a3ae;
      color: #000; /* Actual text color changed to black */
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 100%;
    }

    /* NEW: This targets the placeholder text specifically */
    .custom-input::placeholder,
    .custom-textarea::placeholder {
      color: #000;
      opacity: 1; /* Ensures color isn't faded by browser defaults */
    }

    button {
      background-color: #b6cca1;
      color: #222;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-style: italic;
      width: 180px;
    }

    button:hover {
      background-color: #8dcc6b;
    }

    input[type="file"]::file-selector-button {
      background-color: #86a3ae;
      border: none;
      border-radius: 7px;
      padding: 6px 20px;
      font-style: italic;
      cursor: pointer;
    }

    input[type="file"]::file-selector-button:hover {
      background-color: #134b61;
      color: #fff;
    }

    .submit-container {
      grid-column: span 2;
      text-align: center;
      margin-top: 50px;
    }

    footer {
      text-align: center; 
      padding: 25px; 
      font-size: 1.1em; 
      color: #555; 
    }

  </style>
</head>
<body>
  <%- include ('partials/navbar.ejs') %>

  <div class="container text-center mt-4">
    <br>
    <h2 id="publishContentTitle">Publish Content</h2>
    <form action="/addContent" method="POST" enctype="multipart/form-data" class="form-container">

      <label for="contentTypeID" id="categoryLbl">Category:</label>
      <select name="contentTypeID" id="contentTypeID" required class="custom-input">
        <option value="">Select category</option> 
        <option value="1">Environmental</option>
        <option value="2">Social</option>
        <option value="3">Governance</option>
      </select>


      <label for="contentTitle" id="titleLbl">Title:</label>
      <input type="text" id="contentTitle" name="contentTitle" required class="custom-input" placeholder="Input Title">

      <label for="contentDescription" id="descLbl">Description:</label>
      <textarea id="contentDescription" name="contentDescription" required class="custom-textarea" placeholder="Input Description" oninput="autoExpand(this)"></textarea>

      <label for="contentFile" id="fileLbl">File Upload:</label>
      <div>
        <input type="file" id="contentFile" name="contentFile" required 
          accept=".jpg,.jpeg,.png,.gif,.webp,.mp4,.mov,.avi,.pdf,.doc,.docx,.ppt,.pptx">
        <small id="fileHelp" style="display:block; margin-top:8px; color:#555; font-style:italic;">
          Accepted formats: Images (JPG, PNG, GIF, WebP), Videos (MP4, MOV, AVI), PDF, Word (DOC, DOCX), PowerPoint (PPT, PPTX). Max 10MB.
        </small>
        <div id="fileError" style="color:#e63946; margin-top:8px; font-weight:600; display:none;"></div>
      </div>

      <div class="submit-container">
        <button type="submit" id="publishBtn">Publish Content</button> <br><br>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const ALLOWED_EXTENSIONS = ['jpg','jpeg','png','gif','webp','mp4','mov','avi','pdf','doc','docx','ppt','pptx'];
    const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB

    document.addEventListener('DOMContentLoaded', () => {
      // Translate UI elements
      const publishContentTitle = document.getElementById('publishContentTitle');
      const categoryLbl = document.getElementById('categoryLbl');
      const titleLbl = document.getElementById('titleLbl');
      const descLbl = document.getElementById('descLbl');
      const fileLbl = document.getElementById('fileLbl');
      const publishBtn = document.getElementById('publishBtn');

      if (publishContentTitle) publishContentTitle.textContent = t('publishContentTitle');
      if (categoryLbl) categoryLbl.textContent = t('categoryLabel');
      if (titleLbl) titleLbl.textContent = t('titleLabel');
      if (descLbl) descLbl.textContent = t('descriptionLabel');
      if (fileLbl) fileLbl.textContent = t('fileUploadLabel');
      if (publishBtn) publishBtn.textContent = t('publishContentBtn');

      // File validation
      const fileInput = document.getElementById('contentFile');
      const fileError = document.getElementById('fileError');
      const form = fileInput.closest('form');

      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        fileError.style.display = 'none';
        fileError.textContent = '';

        if (!file) return;

        // Check file extension
        const fileName = file.name.toLowerCase();
        const ext = fileName.split('.').pop();

        if (!ALLOWED_EXTENSIONS.includes(ext)) {
          fileError.textContent = `❌ File type ".${ext}" not allowed. Please use: Images, Videos, PDF, Word, or PowerPoint.`;
          fileError.style.display = 'block';
          fileInput.value = '';
          return;
        }

        // Check file size
        if (file.size > MAX_FILE_SIZE) {
          fileError.textContent = `❌ File size exceeds 10MB limit. Current: ${(file.size / 1024 / 1024).toFixed(2)}MB`;
          fileError.style.display = 'block';
          fileInput.value = '';
          return;
        }
      });

      // Form submission validation
      form.addEventListener('submit', (e) => {
        const file = fileInput.files[0];
        if (!file) {
          e.preventDefault();
          fileError.textContent = '❌ Please select a file to upload.';
          fileError.style.display = 'block';
        }
      });
    });

    function autoExpand(textarea) {
      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";
    }
  </script>

  <footer>
    &copy; 2025 RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>