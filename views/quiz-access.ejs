<!DOCTYPE html>
<html>
<head>
    <title>EcoJourney Quiz</title>
    <style>
        body {
            background: url('/images/qrbg.png') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Georgia', serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }

        .box {
            background: rgba(255,255,255,0.92);
            padding: 28px;
            border-radius: 18px;
            width: 90%;
            max-width: 420px;
            text-align: center;
            box-shadow: 0 6px 18px rgba(0,0,0,0.15);
            animation: fadeIn 0.8s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to   { opacity: 1; transform: scale(1); }
        }
    </style>
</head>

<body>
    <div class="box">
        <h2>Welcome, Guest 🌿</h2>
        <p>You will be redirected to the quiz automatically...</p>

        <script>
            setTimeout(() => {
                window.location.href = "/quiz";
            }, 5000);
        </script>
    </div>
</body>
</html>

