<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>All Users</title>
    <style>
        body {
            min-height: 100vh;
            background-image: url("/images/background.png");
            background-repeat: no-repeat;
            background-size: cover; 
            background-position: center;
        }
    </style>
</head>
<body>
    <div><%- include ('partials/navbar.ejs') %></div>

    <div class="container mt-4">
        <h2 class="mb-4">All Users</h2>

        <div class="row">
            <% if (users && users.length > 0) { %>

                <% users.forEach(function(u) { %>
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><%= u.userName %></h5>
                                <p class="card-text mb-1"><strong>Email:</strong> <%= u.email %></p>
                                <p class="card-text mb-1"><strong>Contact:</strong> <%= u.contactNo %></p>
                                <p class="card-text"><strong>User Type:</strong> <%= u.userType %></p>

                                <!-- OPTIONAL BUTTONS -->
                                <div class="d-flex justify-content-between">
                                    <a href="/editUserRole/<%= u.userID %>" class="btn btn-primary btn-sm">Edit</a>
                                    <a href="/deleteUser/<%= u.userID %>" class="btn btn-danger btn-sm">Delete</a>
                                </div>

                            </div>
                        </div>
                    </div>
                <% }) %>

            <% } else { %>
                <p>No users found.</p>
            <% } %>
        </div>
    </div>

</body>
</html>
