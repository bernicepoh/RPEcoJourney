<!DOCTYPE html>
<html>
<head>
    <title>Quiz Results</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/translations.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #e8dfcf;
            background-size: cover;
            margin: 0;
            padding: 40px 20px;
        }

        /* ============================
           2-COLUMN MAIN LAYOUT
        =============================*/
        .results-container {
            display: grid;
            grid-template-columns: 1fr 1.4fr;
            gap: 30px;
            width: 100%;
            max-width: 1400px;
            margin: auto;
        }

        /* LEFT PANEL - Quiz Completion Card */
        .left-panel {
            background: linear-gradient(135deg, #fff9f0 0%, #ffffff 100%);
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            text-align: center;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        /* RIGHT PANEL - Review & Feedback */
        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* ============================
           TYPOGRAPHY
        =============================*/
        h1 {
            color: #1b5e20;
            font-size: 28px;
            margin-bottom: 20px;
            font-weight: 700;
        }

        h3 {
            color: #1b5e20;
            font-size: 20px;
            margin-bottom: 12px;
        }

        /* ============================
           SCORE & XP BOXES
        =============================*/
        .score-box {
            background: linear-gradient(135deg, #d9e8f5 0%, #b3d9ff 100%);
            padding: 35px 25px;
            border-radius: 18px;
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 20px;
            color: #1b5e20;
            box-shadow: 0 4px 15px rgba(27, 94, 32, 0.15);
        }

        .score-box div {
            font-size: 14px;
            color: #555;
            margin-top: 8px;
            font-weight: 500;
        }

        .xp-box {
            background: linear-gradient(135deg, #fff7c2 0%, #fffde7 100%);
            padding: 18px 25px;
            border-radius: 16px;
            display: inline-block;
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 30px;
            border: 2px dashed #fbc02d;
            color: #f57f17;
            line-height: 1.6;
        }

        .xp-box span {
            color: #795548;
        }

        /* ============================
           STAT BOXES
        =============================*/
        .stat-box {
            background: #f1f8e9;
            padding: 12px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            font-size: 15px;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid #66bb6a;
            transition: all 0.3s ease;
        }

        .stat-box:hover {
            background: #dcedc8;
            transform: translateX(5px);
        }

        .stat-box span {
            color: #666;
        }

        .stat-box b {
            color: #1b5e20;
            font-weight: 600;
        }

        /* ============================
           BUTTONS
        =============================*/
        .btn-area {
            margin-top: 35px;
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn {
            padding: 12px 28px;
            border-radius: 25px;
            font-size: 15px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .home-btn {
            background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);
            color: white;
            width: 100%;
        }

        .home-btn:hover {
            background: linear-gradient(135deg, #2e7d32 0%, #388e3c 100%);
            box-shadow: 0 6px 20px rgba(30, 124, 50, 0.3);
            transform: translateY(-2px);
        }

        /* ============================
           QUESTION REVIEW CARD
        =============================*/
        .review-card {
            padding: 28px;
            border-radius: 20px;
            background: white;
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            text-align: left;
            border-top: 5px solid #1b5e20;
        }

        .correct-card {
            background: linear-gradient(135deg, #f1f8e9 0%, #eaffea 100%);
            border-left: 6px solid #2e7d32;
        }

        .wrong-card {
            background: linear-gradient(135deg, #ffebee 0%, #ffecec 100%);
            border-left: 6px solid #d9534f;
        }

        .review-card p {
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 12px;
            color: #555;
        }

        .review-card b {
            color: #1b5e20;
        }

        /* ============================
           EXPLANATION BOX
        =============================*/
        #reviewExplanation {
            margin: 18px 0;
            padding: 16px;
            border-radius: 12px;
            background: #f7f7f7;
            border-left: 5px solid #66bb6a;
            line-height: 1.7;
            font-size: 15px;
            color: #444;
        }

        /* ============================
           KARAOKE & HIGHLIGHT
        =============================*/
        .karaoke {
            padding: 2px 4px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .karaoke:hover {
            background: #e8f5e9;
        }

        .highlight-word {
            background: linear-gradient(90deg, #4caf50, #a8ff78);
            font-weight: 600;
            padding: 3px 6px;
            border-radius: 6px;
        }

        /* ============================
           CONTROLS
        =============================*/
        #playPauseBtn {
            background: linear-gradient(135deg, #ffd65a 0%, #ffca28 100%);
            padding: 10px 18px;
            border: none;
            border-radius: 15px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            margin-top: 15px;
            transition: all 0.3s ease;
            color: #333;
        }

        #playPauseBtn:hover {
            box-shadow: 0 4px 12px rgba(255, 202, 40, 0.3);
            transform: translateY(-2px);
        }

        .speed-control {
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #f5f5f5;
            border-radius: 12px;
        }

        .speed-control label {
            font-weight: 600;
            color: #333;
            font-size: 14px;
        }

        .speed-control input {
            width: 150px;
            height: 6px;
            cursor: pointer;
        }

        .speed-control span {
            font-weight: 600;
            color: #1b5e20;
            min-width: 45px;
        }

        /* ============================
           NAVIGATION
        =============================*/
        .nav-arrows {
            display: flex;
            justify-content: space-between;
            margin-top: 18px;
            gap: 10px;
        }

        .arrow-btn {
            flex: 1;
            background: linear-gradient(135deg, #66bb6a 0%, #4caf50 100%);
            padding: 12px 18px;
            border: none;
            border-radius: 12px;
            color: white;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .arrow-btn:hover {
            background: linear-gradient(135deg, #81c784 0%, #66bb6a 100%);
            box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
            transform: translateY(-2px);
        }

        .arrow-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* ============================
           AI FEEDBACK BOX
        =============================*/
        .ai-box {
            padding: 28px;
            border-radius: 20px;
            background: linear-gradient(135deg, #e8f5e9 0%, #eef7ea 100%);
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            text-align: left;
            border-top: 5px solid #2e7d32;
        }

        .ai-title {
            font-size: 20px;
            font-weight: 700;
            color: #1b5e20;
            margin-bottom: 15px;
        }

        #aiFeedback {
            font-size: 15px;
            line-height: 1.7;
            color: #555;
        }

        /* ============================
           RESPONSIVE DESIGN
        =============================*/
        @media (max-width: 1200px) {
            .results-container {
                grid-template-columns: 1fr;
            }

            .left-panel {
                position: static;
            }
        }

        @media (max-width: 768px) {
            body {
                padding: 20px 15px;
            }

            .results-container {
                gap: 20px;
            }

            .left-panel,
            .right-panel {
                padding: 20px;
            }

            h1 {
                font-size: 24px;
            }

            .score-box {
                font-size: 36px;
                padding: 25px 20px;
            }

            .nav-arrows {
                flex-direction: column;
            }

            .arrow-btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>
   <%- include('partials/navbar') %>

<div class="results-container">

    <div class="left-panel">
        <h1>🎉 Quiz Completed!</h1>

        <div class="score-box">
            <%= score %> / 50
            <div style="font-size:14px;">Total Points Scored</div>
        </div>

        <div class="xp-box">
            🌟 Total XP: <%= xpEarned %><br>
            <span style="font-size: 12px; font-weight: normal; color: #795548;">
                (Base: <%= score * 2 %> + Streak: <%= streakBonus %> + Perfect: <%= perfectBonus %>)
            </span>
        </div>

        <div class="stat-box"><span>📅 Completed On:</span> <b><%= completedAt %></b></div>
        <div class="stat-box"><span>👤 User:</span> <b><%= user.userName %></b></div>
        <div class="stat-box"><span>🔥 Difficulty Level:</span> <b><%= difficulty %></b></div>

        <div class="btn-area">
            <button class="btn home-btn" onclick="window.location.href='/ai/select'">Back to Quiz Selection</button>
        </div>
    </div>

    <div class="right-panel">
        <div id="reviewCard" class="review-card">
            <h3 id="reviewQuestion">Question Review</h3>
            <p id="reviewStatus"></p>
            <p id="reviewYourAnswer"></p>
            <p id="reviewCorrectAnswer"></p>

            <div id="reviewExplanation"></div>

            <button id="playPauseBtn">▶️ Play</button>

            <div class="speed-control">
                <label id="speedLabel">Speed:</label>
                <input type="range" id="speedSlider" min="0.7" max="1.5" step="0.1" value="1">
                <span id="speedValue">1.0x</span>
            </div>

            <div class="nav-arrows">
                <button class="arrow-btn" id="prevBtn" onclick="prevReview()">← Prev</button>
                <button class="arrow-btn" id="nextBtn" onclick="nextReview()">Next →</button>
            </div>
        </div>

        <div class="ai-box">
            <div class="ai-title" id="aiTitle">🤖 AI Feedback & Eco Tips</div>
            <div id="aiFeedback">Loading AI insights...</div>
        </div>
    </div>

</div>

<script>
const review = JSON.parse(localStorage.getItem("aiQuizReview"));
let index = 0;
let aiExplanations = [];

let currentUtterance = null;
let currentWordIndex = 0;
let words = [];
let isPaused = false;
let speedRate = 1;

document.getElementById("speedSlider").addEventListener("input", (e) => {
    speedRate = parseFloat(e.target.value);
    document.getElementById("speedValue").innerText = speedRate.toFixed(1) + "x";

    if (currentUtterance && !isPaused) {
        window.speechSynthesis.cancel();
        startSpeech(aiExplanations[index], currentWordIndex);
    }
});

function loadReviewCard() {
    let q = review.questions[index];
    const isCorrect = review.userAnswers[index] === q.answerIndex;

    document.getElementById("reviewCard").className =
        "review-card " + (isCorrect ? "correct-card" : "wrong-card");

    document.getElementById("reviewStatus").innerHTML =
        isCorrect ? t('correct') : t('incorrect');

    document.getElementById("reviewQuestion").innerHTML =
        `<b>Q${index+1}:</b> ${q.question}`;

    document.getElementById("reviewYourAnswer").innerHTML =
        t('yourAnswer') + ` <b>${q.options[review.userAnswers[index]] ?? t('notAnswered')}</b>`;

    document.getElementById("reviewCorrectAnswer").innerHTML =
        t('correctAnswer') + ` <b>${q.options[q.answerIndex]}</b>`;

    document.getElementById("reviewExplanation").innerHTML =
        `<b>${t('explanation')}</b><br>${aiExplanations[index]}`;

    resetSpeech();
}

function resetSpeech() {
    window.speechSynthesis.cancel();
    currentUtterance = null;
    currentWordIndex = 0;
    isPaused = false;
    document.getElementById("playPauseBtn").innerHTML = "▶️ Play";
}

function nextReview() { if (index < review.questions.length - 1) { index++; loadReviewCard(); } }
function prevReview() { if (index > 0) { index--; loadReviewCard(); } }

async function loadAIInsights() {
    const res = await fetch("/ai/insights", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(review)
    });

    const data = await res.json();
    aiExplanations = data.explanations;

    document.getElementById("aiFeedback").innerHTML = data.feedback;

    loadReviewCard();
}
loadAIInsights();

document.getElementById("playPauseBtn").addEventListener("click", () => {
    const text = aiExplanations[index];

    if (!currentUtterance) startSpeech(text, 0);
    else if (isPaused) resumeSpeech();
    else pauseSpeech();
});

function startSpeech(text, startIndex = 0) {
    words = text.split(/\s+/);

    const wrapped = words.map((w, i) =>
        `<span class="karaoke" data-index="${i}" id="word${i}">${w}</span>`
    ).join(" ");

    document.getElementById("reviewExplanation").innerHTML =
        `<b>💡 Explanation:</b><br>` + wrapped;

    attachWordListeners();

    const remainingText = words.slice(startIndex).join(" ");
    const utter = new SpeechSynthesisUtterance(remainingText);

    utter.lang = "en-US";
    utter.rate = speedRate;

    currentUtterance = utter;
    currentWordIndex = startIndex;

    utter.onboundary = () => {
        highlightWord(currentWordIndex);
        currentWordIndex++;
    };

    utter.onend = () => resetSpeech();

    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(utter);

    document.getElementById("playPauseBtn").innerHTML = "⏸ Pause";
    isPaused = false;
}

function pauseSpeech() {
    window.speechSynthesis.pause();
    isPaused = true;
    document.getElementById("playPauseBtn").innerHTML = "▶️ Resume";
}

function resumeSpeech() {
    window.speechSynthesis.resume();
    isPaused = false;
    document.getElementById("playPauseBtn").innerHTML = "⏸ Pause";
}

function highlightWord(i) {
    document.querySelectorAll(".karaoke")
        .forEach(el => el.classList.remove("highlight-word"));

    const el = document.getElementById("word" + i);
    if (el) el.classList.add("highlight-word");
}

function attachWordListeners() {
    document.querySelectorAll(".karaoke").forEach(span => {

        let pressTimer = null;
        let longPress = false;

        const start = (e) => {
            longPress = false;
            e.preventDefault();

            pressTimer = setTimeout(() => {
                longPress = true;
                showWordMeaning(span.innerText);
            }, 600);
        };

        const end = () => {
            clearTimeout(pressTimer);

            if (!longPress) {
                const idx = parseInt(span.dataset.index);
                startSpeech(aiExplanations[index], idx);
            }
        };

        span.addEventListener("mousedown", start);
        span.addEventListener("mouseup", end);
        span.addEventListener("mouseleave", end);

        span.addEventListener("touchstart", start, { passive: false });
        span.addEventListener("touchend", end);
        span.addEventListener("touchcancel", end);
    });
}

async function showWordMeaning(word) {
    const res = await fetch("/ai/word-meaning", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ word })
    });

    const data = await res.json();

    Swal.fire({
        title: `📘 ${word}`,
        html: `<p style="font-size:16px;">${data.meaning}</p>`,
        confirmButtonText: "OK"
    });
}


document.addEventListener('DOMContentLoaded', () => {
    const quizCompletedTitle = document.getElementById('quizCompletedTitle');
    const totalPointsText = document.getElementById('totalPointsText');
    const totalXpLabel = document.getElementById('totalXpLabel');
    const baseLabel = document.getElementById('baseLabel');
    const streakLabel = document.getElementById('streakLabel');
    const perfectLabel = document.getElementById('perfectLabel');
    const completedOnLabel = document.getElementById('completedOnLabel');
    const userLabel = document.getElementById('userLabel');
    const difficultyLabel = document.getElementById('difficultyLabel');
    const backToQuizBtn = document.getElementById('backToQuizBtn');
    const speedLabel = document.getElementById('speedLabel');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const aiTitle = document.getElementById('aiTitle');
    const aiFeedback = document.getElementById('aiFeedback');

    if (quizCompletedTitle) quizCompletedTitle.textContent = t('quizCompleted');
    if (totalPointsText) totalPointsText.textContent = t('totalPointsScored');
    if (totalXpLabel) totalXpLabel.textContent = t('totalXP');
    if (baseLabel) baseLabel.textContent = t('base');
    if (streakLabel) streakLabel.textContent = t('streakBonus');
    if (perfectLabel) perfectLabel.textContent = t('perfectBonus');
    if (completedOnLabel) completedOnLabel.innerHTML = t('completedOn');
    if (userLabel) userLabel.innerHTML = t('userLabel');
    if (difficultyLabel) difficultyLabel.innerHTML = t('difficultyLevel');
    if (backToQuizBtn) backToQuizBtn.textContent = t('backToQuizSelection');
    if (speedLabel) speedLabel.textContent = t('speed');
    if (prevBtn) prevBtn.innerHTML = t('prev');
    if (nextBtn) nextBtn.innerHTML = t('next');
    if (aiTitle) aiTitle.textContent = t('aiFeedback');
    if (aiFeedback && aiFeedback.textContent === 'Loading AI insights...') {
        aiFeedback.textContent = t('loadingInsights');
    }
});
</script>

</body>
</html>

















