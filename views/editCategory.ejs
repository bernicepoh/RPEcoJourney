<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPEcoJourney - Edit Category</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
  body {
    font-family: 'Georgia', serif;
    background: #e8f5e9;
    background-image: url("/images/background.png");
  background-repeat: no-repeat;
  background-size: cover; 
  background-position: center;
  }

  .form-card {
    max-width: 650px;
    margin: 60px auto;
    padding: 32px;
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0px 6px 18px rgba(0,0,0,0.13);
    border: 3px solid #2d6a4f;
  }

  h2 {
    color: #145a32;
    font-weight: 700;
    margin-bottom: 18px;
  }

  label {
    font-weight: 600;
    color: #145a32;
    margin-top: 8px;
  }

  input[type="text"], textarea {
    width: 100%;
    border: 2px solid #a3c9a8;
    border-radius: 8px;
    padding: 10px;
    transition: 0.2s;
  }

  input[type="text"]:focus, textarea:focus {
    border-color: #2d6a4f;
    outline: none;
    background: #f4fff6;
  }

  #previewImg {
    max-width: 300px;
    border-radius: 10px;
    display: block;
    margin-top: 8px;
    box-shadow: 0px 4px 12px rgba(0,0,0,0.18);
  }

  .update-btn {
    background: #2d6a4f;
    color: white;
    padding: 10px 26px;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    font-size: 1.05em;
    transition: 0.2s;
    width: 100%;
    margin-top: 10px;
  }

  .update-btn:hover {
    background: #1b472f;
    transform: translateY(-2px);
  }

  .file-text {
    font-size: 0.9em;
    color: #2d6a4f;
  }

</style>
</head>

<body>

<%- include('partials/navbar.ejs') %>

<div class="form-card">
  <h2 class="text-center">Edit Category</h2>

  <form action="/editCategory/<%= category.categoryID %>" method="POST" enctype="multipart/form-data">

    <label>Category Name:</label>
    <input type="text" name="categoryName" 
           value="<%= category.categoryName %>" required>

    <label>Category Description:</label>
    <textarea name="categoryDescription" rows="3" required><%= category.categoryDescription %></textarea>

    <label>Current Image:</label>
    <input type="hidden" name="currentImage" value="<%= category.categoryImage %>">
    <img id="previewImg" src="/images/<%= category.categoryImage %>">

    <label>Upload New Image:</label>
    <input type="file" name="categoryImage" accept="image/*" 
           onchange="previewImage(event)">
    <span id="fileNameDisplay" class="file-text"></span>

    <button type="submit" class="update-btn">Update Category</button>
  </form>
</div>

<script>
function previewImage(event) {
  const file = event.target.files[0];
  const preview = document.getElementById("previewImg");
  const fileNameLabel = document.getElementById("fileNameDisplay");

  if (file) {
    preview.src = URL.createObjectURL(file);
    preview.style.display = "block";
    fileNameLabel.textContent = file.name;
  }
}
</script>

</body>
</html>
