<nav>
  <a href="/adminDashboard">
    <h1>RPEcoJourney</h1>
  </a>

  <ul>

    <% if (user && user.userType !== "Guest") { %>  
      <!-- NORMAL USER NAV LINKS -->
      <li><a href="/homepage">Home</a></li>
      <li><a href="/aboutus">About Us</a></li>
      <li><a href="/categories">Browse Content</a></li>
    <% } %>

    <!-- BOTH user + guest can see Quiz -->
    <li><a href="/ai/select">Quiz Me!</a></li>

  </ul>

  <% if (user && user.userType !== "Guest") { %>
    <ul>
      <li><a href="/viewProfile/<%= user.userID %>">Profile</a></li>
      <li><a href="#" id="logoutBtn">Logout</a></li>
    </ul>
  <% } %>

</nav>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  // Logout confirmation
  const logoutBtn = document.getElementById('logoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', function(e) {
      e.preventDefault();
      
      Swal.fire({
        title: 'Are you sure?',
        text: 'Do you want to log out?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#4CAF50',
        cancelButtonColor: '#4CAF50',
        confirmButtonText: 'Yes, logout',
        cancelButtonText: 'No, stay'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/';
        }
      });
    });
  }
</script>

<style>
  nav {
    background-color: #8bc34a;
    color: #0b2535;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 2.5rem;
    font-family: 'Georgia', serif;
  }

  nav h1 {
    margin: 0;
    font-size: 2.3rem;
    font-weight: 900;
    letter-spacing: 1px;
    color: #003b2b;
  }

  nav a {
    text-decoration: none;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 45px;
    margin: 0;
    padding: 0;
  }

  nav ul li a {
    color: #0b2535;
    text-decoration: none;
    font-style: italic;
    font-size: 1.4rem;
    font-weight: 700;
    transition: all 0.25s ease-in-out;
  }

  nav ul li a:hover {
    text-decoration: underline;
    color: #1a1a1a;
  }

  .profile-pic {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #0b2535;
  }
</style>