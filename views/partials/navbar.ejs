<nav>
  <a href="/adminDashboard">
    <h1>RPEcoJourney</h1>
  </a>

  <ul>

    <% if (user) { %>  
      <!-- NORMAL USER NAV LINKS -->
      <li><a href="/homepage"><%= __('nav.home') %></a></li>
      <li><a href="/aboutus"><%= __('nav.aboutUs') %></a></li>
      <li><a href="/categories"><%= __('nav.browseContent') %></a></li>
    <% } %>

    <!-- BOTH user + guest can see Quiz -->
    <li><a href="/ai/select"><%= __('nav.quizMe') %></a></li>

  </ul>

  <% if (user) { %>
    <ul>
      <li><a href="/viewProfile/<%= user.userID %>"><%= __('nav.profile') %></a></li>
      <li><a href="#" id="logoutBtn"><%= __('nav.logout') %></a></li>
      <% if (user.userType !== "Admin" && user.userType !== "Writer" && user.userType !== "Manager") { %>
        <li class="language-switcher">
          <select id="languageSelect" onchange="changeLanguage(this.value)">
            <option value="en" <%= currentLanguage === 'en' ? 'selected' : '' %>>English</option>
            <option value="ms" <%= currentLanguage === 'ms' ? 'selected' : '' %>>Bahasa Melayu</option>
            <option value="ta" <%= currentLanguage === 'ta' ? 'selected' : '' %>>தமிழ்</option>
            <option value="zh" <%= currentLanguage === 'zh' ? 'selected' : '' %>>中文</option>
          </select>
        </li>
      <% } %>
    </ul>
  <% } %>

</nav>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  // Language change function
  function changeLanguage(lang) {
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('lang', lang);
    window.location.href = currentUrl.toString();
  }

  // Logout confirmation
  const logoutBtn = document.getElementById('logoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', function(e) {
      e.preventDefault();
      
      Swal.fire({
        title: '<%= __("logout.title") %>',
        text: '<%= __("logout.text") %>',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#4CAF50',
        cancelButtonColor: '#4CAF50',
        confirmButtonText: '<%= __("logout.confirmButton") %>',
        cancelButtonText: '<%= __("logout.cancelButton") %>'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/';
        }
      });
    });
  }
</script>

<style>
  nav {
    background-color: #8bc34a;
    color: #0b2535;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 2.5rem;
    font-family: 'Georgia', serif;
  }

  nav h1 {
    margin: 0;
    font-size: 2.3rem;
    font-weight: 900;
    letter-spacing: 1px;
    color: #003b2b;
  }

  nav a {
    text-decoration: none;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 45px;
    margin: 0;
    padding: 0;
  }

  nav ul li a {
    color: #0b2535;
    text-decoration: none;
    font-style: italic;
    font-size: 1.4rem;
    font-weight: 700;
    transition: all 0.25s ease-in-out;
  }

  nav ul li a:hover {
    text-decoration: underline;
    color: #1a1a1a;
  }

  /* Language Switcher Styles */
  .language-switcher {
    display: flex;
    align-items: center;
  }

  #languageSelect {
    background-color: #003b2b;
    color: white;
    border: 2px solid #003b2b;
    padding: 8px 12px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.25s ease-in-out;
    font-family: 'Georgia', serif;
  }

  #languageSelect:hover {
    background-color: #0b2535;
    border-color: #0b2535;
  }

  #languageSelect:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(139, 195, 74, 0.3);
  }

  #languageSelect option {
    background-color: white;
    color: #003b2b;
    padding: 8px;
  }

  .profile-pic {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #0b2535;
  }
</style>