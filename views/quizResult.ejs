<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Result | RPEcoJourney</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Georgia", serif;
      background: url('/images/quizBackground.jpg') no-repeat center center fixed;
      background-size: cover;
      min-height: 100vh;
    }

    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.85);
      z-index: -1;
    }

    .container {
      max-width: 900px;
      margin: 120px auto;
      background: white;
      padding: 50px;
      border-radius: 25px;
      box-shadow: 0px 8px 25px rgba(0, 0, 0, 0.15);
      text-align: center;
    }

    h1 {
      font-size: 2.5rem;
      color: #0b2535;
      margin-bottom: 10px;
    }

    .caption {
      color: #277c37;
      font-size: 1.1rem;
      margin-bottom: 20px;
      font-style: italic;
    }

    .xp-earned {
      font-size: 1.3rem;
      margin: 15px 0;
      font-weight: bold;
      color: #1b4d2b;
    }

    /* XP BAR */
    .xp-bar-wrapper {
      width: 70%;
      height: 10px;
      background: #d0e7cc;
      border-radius: 10px;
      margin: 10px auto 5px;
      position: relative;
      cursor: pointer;
    }
    .xp-bar-fill {
      height: 100%;
      background: #2d6a4f;
      border-radius: 10px;
    }

    /* Tooltip */
    .xp-bar-wrapper:hover::after {
      content: attr(title);
      position: absolute;
      top: -35px;
      left: 50%;
      transform: translateX(-50%);
      background: #2d6a4f;
      color: white;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
      white-space: nowrap;
      box-shadow: 0 3px 10px rgba(0,0,0,0.2);
    }

    .xp-bar-wrapper:hover::before {
      content: "";
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      border-width: 6px;
      border-style: solid;
      border-color: #2d6a4f transparent transparent transparent;
    }

    .btn {
      background: #1b4d2b;
      color: white;
      border: none;
      padding: 10px 35px;
      border-radius: 25px;
      cursor: pointer;
      margin-top: 25px;
      font-size: 1.1rem;
      transition: 0.3s;
    }

    .btn:hover {
      transform: scale(1.05);
      background: #103c20;
    }

  </style>

  <!-- Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
</head>

<body>
  <%- include('partials/navbar') %>

  <div class="container">

    <!-- Title -->
    <h1>
      <% if (alreadyDone) { %>
        💡 Quiz Already Completed
      <% } else { %>
        🎉 Quiz Completed!
      <% } %>
    </h1>

    <!-- Dynamic Caption -->
    <p class="caption">
      <% if (sessionXP < 50) { %>
        🌱 Keep trying! Every step helps the planet!
      <% } else if (sessionXP < 200) { %>
        🌿 Great job! You're growing greener every day!
      <% } else { %>
        ✨ Excellent! You’re a sustainability champion!
      <% } %>
    </p>

    <!-- XP Earned for this quiz -->
    <p class="xp-earned">
      XP Earned for this Quiz: <%= sessionXP %> ✨
    </p>

    <!-- Level section -->
    <p><strong>Current Level:</strong> <%= level %></p>

    <!-- XP BAR -->
    <div 
      class="xp-bar-wrapper"
      title="You need <%= 500 - (totalXP % 500) %> XP to reach the next level">
      
      <div 
        class="xp-bar-fill" 
        style="width: <%= progressPercent %>%">
      </div>
    </div>

    <p><strong>Total XP:</strong> <%= totalXP %></p>

    <a href="/categories">
      <button class="btn">Back to Categories</button>
    </a>

  </div>

  <!-- Confetti trigger -->
  <% if (!alreadyDone) { %>
  <script>
    confetti({
      particleCount: 180,
      spread: 80,
      startVelocity: 45,
      origin: { y: 0.2 }
    });
  </script>
  <% } %>

</body>
</html>



