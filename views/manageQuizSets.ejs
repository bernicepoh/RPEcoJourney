<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Quiz Sets</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <style>
        body {
            background: url("/uploads/background.png") no-repeat center center fixed;
            background-size: cover;
            font-family: 'Poppins', sans-serif;
        }

        .set-card {
            padding: 20px;
            border-radius: 12px;
            background: white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            transition: .2s;
            cursor: pointer;
        }

        .set-card:hover {
            transform: translateY(-4px);
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2 class="text-center fw-bold mb-4">Select Set to Manage Questions</h2>

    <div class="text-center mb-3">
        <a href="/addQuiz" class="btn btn-success">+ Add New Quiz</a>

        <div class="row">
            <% if (sets.length > 0) { %>

                <% sets.forEach(set => { %>
                    <div class="col-md-4 mb-4">
                        <a href="/manageQuizQuestions/<%= categoryID %>/<%= set.setNumber %>" style="text-decoration:none; color:inherit;">
                            <div class="set-card text-center">

                                <h4>Set <%= set.setNumber %></h4>
                                <p><%= set.title || "Untitled Quiz" %></p>

                                <p class="text-muted">
                                    <strong><%= set.questionCount %></strong> questions
                                </p>

                            </div>
                        </a>
                    </div>
                <% }) %>

            <% } else { %>
                <p class="text-center">No sets found for this category.</p>
            <% } %>
        </div>

    </div>

</body>
</html>

