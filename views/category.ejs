<!-- category.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>RPEcoJourney | <%= category.categoryName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    /* Page base */
    html, body { 
      margin:0; 
      padding:0; 
    }

    body {
      background-color: #f8fdf7;
      background-image: url('/images/background.png');
      background-repeat: no-repeat;
      background-position: bottom center;
      background-size: 100% auto;
      background-attachment: fixed;
      font-family: 'Georgia', serif;
      color:#123524;
    }

    /* Hero banner */
.hero {
  position: relative;
  width: 100%;
  min-height: 300px;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  background-attachment: scroll;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  overflow: hidden;
}

/* transparent overlay to make text readable */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0.0));
  z-index: 1;
}

/* text container on top */
.cat-card {
  position: relative;
  z-index: 2;
  background: rgba(20, 90, 50, 0.92); /* translucent green box */
  color: #fff;
  border-radius: 28px;
  padding: 24px 28px;
  width: min(980px, 92%);
  text-align: center;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  border: 3px solid #2e7d32;
}


    /* Category Description */
    
    .cat-card h2 {
      margin:0 0 10px 0;
      font-size:1.35rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }
    .cat-card p {
      margin:0;
      line-height:1.7;
      font-size:1.05rem;
    }

    /* Main body */
    main {
      max-width: 1100px;
      width: 90%;
      margin: 26px auto 72px auto;
    }

    /* Spotlight (Category Manager) */
    .spotlight {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 18px;
      background: #155f39;              /* deep green!!!! */
      color: #fff;
      padding: 22px 28px;
      border-radius: 28px;               
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
      max-width: 1100px;               
      margin: 18px auto;                 /* center on page */
    }

    .spotlight__avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.6);
      box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    }

    .spotlight__content {
      display: grid;
      gap: 6px;
    }

    .spotlight__title {
      margin: 0;
      font-style: italic;              
      font-weight: 700;
      letter-spacing: 0.1px;
    }

    .spotlight__card {
      margin: 0;
      line-height: 1.6;
      opacity: 0.95;                     /* uhm slightly softer white */
    }

    /* Content */
    .row {
      display:grid;
      grid-template-columns: 420px 1fr;
      gap: 40px;
      align-items: start;
    }
    .card {
      background:#ffffff;
      border: 1px solid #dbe7d7;
      border-radius: 16px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.06);
      overflow:hidden;
    }
    .card img {
      display:block;
      width:100%;
      height: 320px;
      object-fit: cover;
    }
    .card .pad { padding: 18px 20px; }

    .title {
      color:#1a4d2e;
      font-size: 2rem;
      margin: 0 0 6px 0;
    }
    .meta {
      color:#2d6a4f;
      font-style: italic;
      margin-bottom: 16px;
    }
    .desc {
      font-size:1.05rem;
      line-height:1.8;
    }

    /* Actions */
    .actions {
      display:flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }
    .btn {
      display:inline-block;
      padding: 12px 18px;
      border-radius: 10px;
      text-decoration:none;
      font-weight:600;
      border:1px solid #1a4d2e;
    }
    .btn-primary {
      background:#1a4d2e; color:#fff;
    }
    .btn-ghost {
      background:#ffffff; color:#1a4d2e;
    }

    /* Responsive */
    @media (max-width: 980px) {
      .row { grid-template-columns: 1fr; }
      .card img { height: 240px; }
    }

    footer { 
      text-align:center; 
      padding:25px; 
      font-size:1.05em; 
      color:#555; 
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>
  
  <!-- Category Description -->
  <% const heroBg = category.catImage 
      ? '/images/' + category.catImage 
      : '/images/default-banner.png'; %>

  <section class="hero" style="background-image: url('<%= heroBg %>');">
    <div class="cat-card">
      <h2><%= (category.categoryName || 'Category').toUpperCase() %></h2>
      <p>
        <%= category.categoryDescription 
              ? category.categoryDescription 
              : 'This category highlights initiatives, knowledge, and actions that support RP’s sustainability journey.' %>
      </p>
    </div>
  </section>

  <!-- Manager for each Category -->
    <section class="spotlight" aria-label="Category Lead">
      <img class="spotlight__avatar"
          src="<%= category.managerPhoto ? '/images/' + category.managerPhoto : '/images/default-manager.png' %>"
          alt="<%= category.managerName || 'Category Manager' %>">

      <div class="spotlight__content">
        <h4 class="spotlight__title">
          <%= category.managerName || 'Manager Name Unavailable' %>
        </h4>
        <p class="spotlight__card">
          <%= category.managerDescription || 'Manager details coming soon.' %>
        </p>
      </div>
    </section>

  <!-- <section class="spotlight" aria-label="Category Lead">
    <% const manager = { name: 'Ms Irdina', photo: '/images/manager-irdina.png' }; %>

    <img class="spotlight__avatar"
        src="<%= manager.photo %>"
        alt="<%= manager.name %>">

    <div class="spotlight__content">
      <h4 class="spotlight__title">
        MS Irdina Head Management of Environmental Sustainability
      </h4>
      <p class="spotlight__card">
        Oversees the Environmental category on RPEcoJourney, leading initiatives that promote eco-friendly practices and sustainability awareness within Republic Polytechnic.
      </p>
    </div>
  </section> -->

<!-- Content Part (uhm just rough layout!!!) -->
  <main>
    <% 
      const imgSrc = category.categoryImage 
        ? '/images/' + category.categoryImage 
        : '/images/default.png';
    %>

    <div class="row">
      <!-- Left: image card -->
      <div class="card">
        <img src="<%= imgSrc %>" alt="<%= category.categoryName %>" 
             onerror="this.src='/images/default.png'"/>
      </div>

      <!-- Right: details -->
      <div>
        <h2 class="title"><%= category.categoryName %></h2>
        <% if (category.catDescription) { %>
          <p class="desc"><%= category.catDescription %></p>
        <% } else { %>
          <p class="desc">
            Learn more about <%= category.categoryName %> and how it contributes to RP’s Green Plan.
            Explore projects, tips, and activities you can take part in.
          </p>
        <% } %>
        <div class="person-actions" aria-label="quick actions">
          <button class="icon-btn heart" title="Like" aria-label="Like">❤</button>
          <button class="icon-btn" title="Comment" aria-label="Comment">💬</button>
          <button class="icon-btn" title="Message" aria-label="Message">✉️</button>
        </div>
      </div>
    </div>
  </main>

  <footer>
    &copy; <%= new Date().getFullYear() %> RPEcoJourney. All Rights Reserved.
  </footer>
</body>
</html>
